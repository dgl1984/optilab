#include <windows.h>
#include <commctrl.h>
#include "OptiLabVersion.h"
#include "resource.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION OPTILAB_VERSION_MAJOR,OPTILAB_VERSION_MINOR,OPTILAB_VERSION_PATCH,0
 PRODUCTVERSION OPTILAB_VERSION_MAJOR,OPTILAB_VERSION_MINOR,OPTILAB_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "LanesAudio\0"
            VALUE "FileDescription", "OptiLab Core foobar2000 DSP component\0"
            VALUE "FileVersion", OPTILAB_VERSION_STRING "\0"
            VALUE "InternalName", "foo_optilab_core\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 LanesAudio\0"
            VALUE "OriginalFilename", "foo_optilab_core.dll\0"
            VALUE "ProductName", "OptiLab Core\0"
            VALUE "ProductVersion", OPTILAB_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_OPTILAB_FOOBAR2000_CONFIG DIALOGEX 0, 0, 252, 126
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "OptiLab Core Settings"
FONT 9, "Segoe UI"
BEGIN
    GROUPBOX      "Processing", -1, 7, 7, 238, 81
    LTEXT         "&Mode:", -1, 17, 24, 55, 10
    COMBOBOX      IDC_OPTILAB_MODE, 80, 21, 153, 55, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT         "&Input drive:", -1, 17, 47, 61, 10
    COMBOBOX      IDC_OPTILAB_INPUT_DRIVE, 80, 44, 86, 90, CBS_DROPDOWNLIST | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT         "-12.0 to +18.0 dB", -1, 173, 47, 65, 10
    LTEXT         "&Auto-adapt:", -1, 17, 70, 61, 10
    CONTROL       "", IDC_OPTILAB_AUTO_ADAPT, TRACKBAR_CLASS, TBS_HORZ | TBS_AUTOTICKS | WS_TABSTOP, 80, 64, 116, 22
    LTEXT         "0%", IDC_OPTILAB_AUTO_ADAPT_VALUE, 203, 70, 32, 10
    PUSHBUTTON    "&Restore Defaults", IDC_OPTILAB_RESTORE_DEFAULTS, 7, 101, 78, 18, WS_TABSTOP
    DEFPUSHBUTTON "OK", IDOK, 142, 101, 50, 18, WS_TABSTOP
    PUSHBUTTON    "Cancel", IDCANCEL, 195, 101, 50, 18, WS_TABSTOP
END

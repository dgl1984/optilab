hybrid_shaved_r=hybrid_shaved_l+hybrid_buf_len;
hybrid_required=hybrid_shaved_r+hybrid_buf_len;
hybrid_worklim=hybrid_required+hybrid_buf_len;
hybrid_makeup=hybrid_worklim+hybrid_buf_len;
hybrid_energy_len=floor(srate_safe*0.040+0.5)+64;
hybrid_refe=hybrid_makeup+hybrid_buf_len;
hybrid_deltae=hybrid_refe+hybrid_energy_len;

// @description OptiLab Core
// @version 1.5.0-cp13
// @author LanesAudio
// @about
//   OptiLab Core is a three-control broadcast and mastering processor.
// @changelog
//   v1.5.0
//   - Updated Stream polish calibration and high-frequency control.
//   - Matches the CP13 native coordinator, processing, latency and state behavior.
//   - Aligned mode and Input Drive behavior across supported formats.
//   - Added JUCE 8 VST3 and CLAP builds while preserving the three-control workflow.
// @link
//   Donations: https://paypal.me/dgl1984
//   Contact: info@lanesaudio.com
// @license Apache-2.0 with Commons Clause (https://commonsclause.com/). See LICENSE.
// @provides
//   optilab_core.jsfx
desc:OptiLab Core v1.5.0 CP13 (LanesAudio)

slider1:core_mode=1<0,2,1{Podcast Leveler,Stream polish,Smooth Limiter}>Mode
slider2:input_drive_db=0<-18,18,0.1>Input Drive dB
slider3:auto_adapt_pct=0<0,100,1>Auto-Adapt percent
in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
function se_filter_configure(rate freq highpass) instance(enabled b0 b1 b2 a1 a2 z1 z2) local(k norm)
(
 enabled=freq>0;
 enabled ? (
  k=tan($pi*min(freq,rate*0.45)/rate);norm=1/(1+sqrt(2)*k+k*k);
  b0=highpass ? norm : k*k*norm;b1=(highpass ? -2 : 2)*b0;b2=b0;
  a1=2*(k*k-1)*norm;a2=(1-sqrt(2)*k+k*k)*norm;
 );
);

function se_filter_reset() instance(z1 z2)
(
 z1=z2=0;
);

function se_filter_process(x) instance(enabled b0 b1 b2 a1 a2 z1 z2) local(y)
(
 enabled ? (y=b0*x+z1;z1=b1*x-a1*y+z2;z2=b2*x-a2*y;y;) : x;
);

function se_reset()
(
 se_mid_hp.se_filter_reset();se_side_hp.se_filter_reset();se_mid_lp.se_filter_reset();se_side_lp.se_filter_reset();
 se_legacy_fast=se_legacy_slow=se_fast_energy=se_slow_energy=se_mid_level=se_side_level=se_band_side_level=se_mid_energy=se_side_energy=se_cross_energy=se_added_gain=0;
);

function se_coefficient(seconds)
(
 exp(-1/(srate_safe*seconds*se_time_scale));
);

function clamp(x lo hi)
(
  min(max(x, lo), hi);
);

function se_prepare() local(type_changed)
(
 type_changed=p055!==se_last_type;
 se_legacy=p055===0 || p055===2;
 se_foundation=p055===2 ? 0.70 : p055===1 ? 0 : 0.35;
 se_narrowness=p055===0 || p055===3 ? 0.25 : 0;
 se_transient=p055===2 ? 0.30 : p055===1 ? 1 : 0.40;
 se_time_scale=c14===0 ? 1.5 : c14===2 ? 2/3 : 1;
 se_fast_c=se_coefficient(0.005);se_slow_c=se_coefficient(0.050);
 se_level_attack=se_coefficient(0.008);se_level_release=se_coefficient(0.180);se_coherence_c=se_coefficient(0.040);
 se_gain_attack=se_coefficient(p055===1 ? 0.002 : p055===3 ? 0.020 : 0.035);
 se_gain_release=se_coefficient(p055===0 ? 0.0005 : p055===1 ? 0.080 : 0.350);
 se_legacy_fa=se_coefficient(0.0015);se_legacy_fr=se_coefficient(0.050);se_legacy_sa=se_coefficient(0.030);se_legacy_sr=se_coefficient(0.250);
 se_ratio_limit=clamp(c36*0.01,0.70,1);se_sensitivity=1.5+3*clamp(c19*0.01,0,1);
 se_side_gate_start=p055===1 ? 0.060 : 0.012;se_side_gate_span=p055===1 ? 0.060 : 0.048;
 type_changed || se_last_rate!==srate_safe || se_last_highpass!==c05 || se_last_lowpass!==c27 ? (
  se_mid_hp.se_filter_configure(srate_safe,c05,1);se_side_hp.se_filter_configure(srate_safe,c05,1);
  se_mid_lp.se_filter_configure(srate_safe,c27,0);se_side_lp.se_filter_configure(srate_safe,c27,0);
  se_reset();
 );
 se_last_type=p055;se_last_rate=srate_safe;se_last_highpass=c05;se_last_lowpass=c27;
);

function se_process(mid side maximum_extra) local(band_mid band_side magnitude power ratio transient side_gate level_gate denominator coherence mono_gate headroom cap narrowness character extra normalized_cap target)
(
 band_mid=se_mid_lp.se_filter_process(se_mid_hp.se_filter_process(mid));
 band_side=se_side_lp.se_filter_process(se_side_hp.se_filter_process(side));
 se_legacy ? (
  magnitude=abs(band_mid);
  se_legacy_fast=magnitude+(magnitude>se_legacy_fast ? se_legacy_fa : se_legacy_fr)*(se_legacy_fast-magnitude);
  se_legacy_slow=magnitude+(magnitude>se_legacy_slow ? se_legacy_sa : se_legacy_sr)*(se_legacy_slow-magnitude);
 ) : (
  power=band_mid*band_mid;se_fast_energy=power+se_fast_c*(se_fast_energy-power);se_slow_energy=power+se_slow_c*(se_slow_energy-power);
 );
 se_mid_level=abs(mid)+(abs(mid)>se_mid_level ? se_level_attack : se_level_release)*(se_mid_level-abs(mid));
 se_side_level=abs(side)+(abs(side)>se_side_level ? se_level_attack : se_level_release)*(se_side_level-abs(side));
 se_band_side_level=abs(band_side)+(abs(band_side)>se_band_side_level ? se_level_attack : se_level_release)*(se_band_side_level-abs(band_side));
 !se_legacy ? (
  se_mid_energy=mid*mid+se_coherence_c*(se_mid_energy-mid*mid);
  se_side_energy=side*side+se_coherence_c*(se_side_energy-side*side);
  se_cross_energy=mid*side+se_coherence_c*(se_cross_energy-mid*side);
 );
 maximum_extra<=0 ? (se_added_gain=0;side;) : (
  ratio=se_side_level/max(se_mid_level,0.000000000000000000000000000001);
  transient=se_legacy ? clamp((se_legacy_fast/max(se_legacy_slow,0.000000000000000000000000000001)-1)*se_sensitivity*0.5,0,1)
   : clamp((sqrt(se_fast_energy/max(se_slow_energy,0.000000000000000000000000000001))-1.15)*se_sensitivity,0,1);
  side_gate=clamp((ratio-se_side_gate_start)/se_side_gate_span,0,1);level_gate=clamp((se_mid_level-0.001)/0.009,0,1);
  mono_gate=1;
  !se_legacy ? (
   denominator=sqrt(max(0,se_mid_energy*se_side_energy));coherence=denominator>0.000000000000000000000000000001 ? clamp(abs(se_cross_energy)/denominator,0,1) : 1;
   mono_gate=clamp((1-coherence)/0.05,0,1);
  );
  headroom=max(0,se_ratio_limit*se_mid_level-se_side_level);cap=headroom/max(se_band_side_level,0.000000000000000000000000000001);
  narrowness=clamp((0.45-ratio)/0.35,0,1);character=clamp(se_foundation+se_narrowness*narrowness+se_transient*transient,0,1);
  se_legacy ? (
   extra=clamp(maximum_extra,0,0.5);normalized_cap=clamp(cap/extra,0,1);target=character*side_gate*level_gate*normalized_cap;
   se_added_gain=target+(target>se_added_gain ? se_gain_attack : se_gain_release)*(se_added_gain-target);se_added_gain=min(se_added_gain,normalized_cap);
   side+extra*se_added_gain*band_side;
  ) : (
   target=min(clamp(maximum_extra,0,0.5),cap)*character*side_gate*level_gate*mono_gate;
   se_added_gain=target+(target>se_added_gain ? se_gain_attack : se_gain_release)*(se_added_gain-target);se_added_gain=min(se_added_gain,min(cap,maximum_extra));
   side+se_added_gain*band_side;
  );
 );
);

function cf_reset() local(i)
(
 cf_write=cf_head=cf_count=cf_clock=0;
 i=0;loop(2048,cf_lbuf[i]=cf_rbuf[i]=cf_rlbuf[i]=cf_rrbuf[i]=0;cf_dbuf[i]=cf_gbuf[i]=1;i+=1;);
);

function cf_configure(delay)
(
 delay=clamp(delay,0,2047);
 delay!==cf_delay ? (cf_delay=delay;cf_reset(););
);

function absmax2(a b)
(
  max(abs(a), abs(b));
);

function cf_process(il ir ref_l ref_r drive gain) local(peak back tail read)
(
 peak=absmax2(il,ir);
 cf_delay===0 ? (
  cf_out_l=il;cf_out_r=ir;cf_out_rl=ref_l;cf_out_rr=ref_r;cf_out_drive=drive;cf_out_gain=gain;cf_peak=peak;
 ) : (
  while(
   cf_count>0 && cf_clock-cf_times[cf_head]>cf_delay ? (cf_head=(cf_head+1)%2048;cf_count-=1;1;) : 0;
  );
  while(
   back=(cf_head+cf_count-1)%2048;
   cf_count>0 && cf_peaks[back]<=peak ? (cf_count-=1;1;) : 0;
  );
  tail=(cf_head+cf_count)%2048;cf_peaks[tail]=peak;cf_times[tail]=cf_clock;cf_clock+=1;cf_count+=1;
  read=cf_write-cf_delay;read<0 ? read+=2048;
  cf_out_l=cf_lbuf[read];cf_out_r=cf_rbuf[read];cf_out_rl=cf_rlbuf[read];cf_out_rr=cf_rrbuf[read];cf_out_drive=cf_dbuf[read];cf_out_gain=cf_gbuf[read];
  cf_lbuf[cf_write]=il;cf_rbuf[cf_write]=ir;cf_rlbuf[cf_write]=ref_l;cf_rrbuf[cf_write]=ref_r;cf_dbuf[cf_write]=drive;cf_gbuf[cf_write]=gain;
  cf_write=(cf_write+1)%2048;cf_peak=cf_peaks[cf_head];
 );
);

function db2lin(db)
(
  exp(db * 0.1151292546497022842);
);

function lin2db(x)
(
  log(max(x, 0.0000001)) * 8.685889638065036553;
);

function smoothstep01(x)
(
  x = clamp(x, 0, 1);
  x * x * (3 - 2 * x);
);

function adaptive_bass_boost_curve(x) local(t y)
(
  x = clamp(x, 0, 1);
  x <= 0.25 ? (
    t = x;
    y = -0.4571428571*t*t*t + 0.9142857143*t*t + 1.0000000000*t;
  ) : x <= 0.50 ? (
    t = x - 0.25;
    y = -0.5468624845*t*t*t + 1.0510013351*t*t + 1.3714285714*t + 0.3000000000;
  ) : x <= 0.65 ? (
    t = x - 0.50;
    y = -60.4153393502*t*t*t + 10.4330174081*t*t + 1.7943925234*t + 0.7000000000;
  ) : (
    t = x - 0.65;
    y = -0.9672424138*t*t*t - 0.7011439362*t*t + 0.8462623413*t + 1.0000000000;
  );
  y;
);

function adaptive_bass_cut_curve(x) local(t y)
(
  x = clamp(x, 0, 1);
  x <= 0.25 ? (
    t = x;
    y = -0.4571428571*t*t*t + 0.9142857143*t*t + 1.0000000000*t;
  ) : x <= 0.50 ? (
    t = x - 0.25;
    y = -0.5468624845*t*t*t + 1.0510013351*t*t + 1.3714285714*t + 0.3000000000;
  ) : x <= 0.65 ? (
    t = x - 0.50;
    y = -98.0269989616*t*t*t + 16.0747663551*t*t + 1.7943925234*t + 0.7000000000;
  ) : (
    y = 1;
  );
  clamp(y, 0, 1);
);

function onepole_lp(x a) instance(z)
(
  z += a * (x - z);
  z;
);

function onepole_lp2(x a) instance(z1 z2)
(
  z1 += a * (x - z1);
  z2 += a * (z1 - z2);
  z2;
);

function onepole_hp(x a) instance(z) local(y)
(
  z += a * (x - z);
  y = x - z;
  y;
);

function peak_env(det att rel) instance(e)
(
  det > e ? e = det + att * (e - det) : e = det + rel * (e - det);
  e;
);

function peak_env_set(v) instance(e)
(
  e = v;
  e;
);

function band_limit_gain_pd(det thresh att rel_base rel_slow pd_amt) instance(env gain) local(tg depth rel_now)
(
  gain <= 0 ? gain = 1;

  depth = clamp((env - thresh) / max(thresh * 2.5, 0.000001), 0, 1);
  rel_now = rel_base * (1 - pd_amt * depth) + rel_slow * (pd_amt * depth);
  det > env ? env = det + att * (env - det) : env = det + rel_now * (env - det);

  env = max(env, 0.000001);
  tg = env > thresh ? thresh / env : 1;
  tg = clamp(tg, 0.10, 1);

  depth = clamp((1 - gain) / 0.75, 0, 1);
  rel_now = rel_base * (1 - pd_amt * depth) + rel_slow * (pd_amt * depth);
  tg < gain ? gain = tg + att * (gain - tg) : gain = tg + rel_now * (gain - tg);
  gain;
);

function linked_limiter_gain(det thresh att rel) instance(gain) local(tg)
(
  gain <= 0 ? gain = 1;
  tg = det > thresh ? thresh / max(det, 0.000001) : 1;
  tg = clamp(tg, 0.08, 1);
  tg < gain ? gain = tg + att * (gain - tg) : gain = tg + rel * (gain - tg);
  gain;
);

function band_event_gain_auto(det thresh_db quiet_thresh att rel_min rel_max) instance(env gain) local(inst_db rel_sec rel_now tg)
(
  gain <= 0 ? gain = 1;
  env === 0 && det < quiet_thresh ? (
    gain = 1;
  ) : (
    inst_db = lin2db(max(det, 0.000000000001)) - thresh_db;
    inst_db < 0 ? inst_db = 0;
    env === 0 && inst_db === 0 ? (
      gain = 1;
    ) : (
      inst_db > env ? (
        env = inst_db + att * (env - inst_db);
      ) : (
        rel_sec = min(0.060, max(0.004, env / 300.0));
        rel_now = env < 1.2 ? rel_min : env > 18 ? rel_max : exp(-1 / max(1, srate_safe * rel_sec));
        env = inst_db + rel_now * (env - inst_db);
      );
      env < 0.00001 ? env = 0;
      env > 18.5 ? gain = 0.12 : (
        tg = clamp(db2lin(-env), 0.12, 1);
        gain = tg;
      );
    );
  );
  gain;
);

function lim_softclip_to_lim(x lim soft) local(ax sg knee span y)
(
  soft <= 0 ? (
    ax = abs(x);
    ax > lim ? sign(x) * lim : x;
  ) : (
    ax = abs(x);
    sg = sign(x);
    knee = lim * (1 - 0.70 * soft);
    span = max(0.000000001, lim - knee);
    ax <= knee ? x : (
      y = knee + span * (1 - exp(-(ax - knee) / span));
      sg * y;
    );
  );
);

function lim_band_clip(x lim amount soft) local(c)
(
  c = lim_softclip_to_lim(x, lim, soft);
  x * (1 - amount) + c * amount;
);

function band_limit_gain_pd_soft(det thresh att rel_base rel_slow pd_amt ratio knee min_gain) instance(env gain) local(tg depth rel_now over soft)
(
  gain <= 0 ? gain = 1;

  depth = clamp((env - thresh) / max(thresh * 2.5, 0.000001), 0, 1);
  rel_now = rel_base * (1 - pd_amt * depth) + rel_slow * (pd_amt * depth);
  det > env ? env = det + att * (env - det) : env = det + rel_now * (env - det);

  env = max(env, 0.000001);
  over = env / max(thresh, 0.000001);
  over > 1 ? (
    soft = clamp((over - 1) / max((over - 1) + knee, 0.000001), 0, 1);
    tg = over^((1 / max(ratio, 1.01)) - 1);
    tg = 1 - soft * (1 - tg);
  ) : (
    tg = 1;
  );
  tg = clamp(tg, min_gain, 1);

  depth = clamp((1 - gain) / 0.75, 0, 1);
  rel_now = rel_base * (1 - pd_amt * depth) + rel_slow * (pd_amt * depth);
  tg < gain ? gain = tg + att * (gain - tg) : gain = tg + rel_now * (gain - tg);
  gain;
);

function soft_clip_knee(x th knee_mul) local(ax sgn over knee y)
(
  ax = abs(x);
  ax <= th ? (
    x;
  ) : (
    sgn = x < 0 ? -1 : 1;
    over = ax - th;
    knee = max(0.000001, th * knee_mul);
    y = th + knee * (1 - exp(-over / knee));
    sgn * y;
  );
);

function mb_soft_clip_dc(x th amt knee_mul cancel_amt a) instance(dc_z) local(c dist dist_low y)
(
  c = soft_clip_knee(x, th, knee_mul);
  dist = c - x;

  dc_z += a * (dist - dc_z);
  dist_low = dc_z;
  y = c - dist_low * cancel_amt;
  x * (1 - amt) + y * amt;
);

function bass_clip_active(x th amt knee_mul drive res_mix a) instance(z1 z2) local(xd c dist dist_filt clip_mix residue_mix)
(

  drive = max(drive, 1);
  xd = x * drive;
  c = soft_clip_knee(xd, th, knee_mul) / drive;
  dist = c - x;

  z1 += a * (dist - z1);
  z2 += a * (z1 - z2);
  dist_filt = z2;

  clip_mix = amt * (0.50 + 0.50 * amt);
  residue_mix = amt * res_mix * (0.35 + 0.65 * amt);
  x + dist * clip_mix + dist_filt * residue_mix;
);

function pure_peak_round(x th amt drive_mul) local(d lim y)
(

  amt <= 0 ? (
    x;
  ) : (
    th = max(th, 0.000001);
    d = drive_mul / th;
    lim = $pi * 0.5;
    y = sin(clamp(x * d, -lim, lim)) / d;
    x * (1 - amt) + y * amt;
  );
);

function smooth_drive_rounder(x amt) instance(prev_sat) local(sat apply y)
(

  amt = clamp(amt, 0, 1);
  amt <= 0.0000001 ? (
    x;
  ) : x === 0 ? (prev_sat=0;0;) : (
    sat = sin(clamp(x, -$pi * 0.5, $pi * 0.5));
    apply = clamp(abs(prev_sat + sat) * 0.5 * amt, 0, 1);
    y = x * (1 - apply) + sat * apply;
    prev_sat = sat;
    y;
  );
);

function adaptive_stereo_width_gain(mid_det side_det extra_request) instance(mid_fast mid_slow mid_env side_env gain) local(ratio transient side_gate level_gate narrowness character ratio_cap target_gain)
(
  mid_det > mid_fast ? (
    mid_fast = mid_det + width_mid_fast_attack * (mid_fast - mid_det);
  ) : (
    mid_fast = mid_det + width_mid_fast_release * (mid_fast - mid_det);
  );

  mid_det > mid_slow ? (
    mid_slow = mid_det + width_mid_slow_attack * (mid_slow - mid_det);
  ) : (
    mid_slow = mid_det + width_mid_slow_release * (mid_slow - mid_det);
  );

  mid_det > mid_env ? (
    mid_env = mid_det + width_level_attack * (mid_env - mid_det);
  ) : (
    mid_env = mid_det + width_level_release * (mid_env - mid_det);
  );

  side_det > side_env ? (
    side_env = side_det + width_level_attack * (side_env - side_det);
  ) : (
    side_env = side_det + width_level_release * (side_env - side_det);
  );

  ratio = side_env / max(mid_env, 0.000001);
  transient = clamp((mid_fast / max(mid_slow, 0.000001) - 1) * 1.5, 0, 1);
  side_gate = clamp((ratio - 0.012) * 20.8333333333333, 0, 1);
  level_gate = clamp((mid_env - 0.001) * 111.111111111111, 0, 1);
  narrowness = clamp((0.45 - ratio) * 2.85714285714286, 0, 1);
  character = clamp(0.35 + 0.40 * transient + 0.25 * narrowness, 0, 1);
  ratio_cap = ratio > 0.000001 ? clamp((0.92 / ratio - 1) / max(extra_request, 0.000001), 0, 1) : 1;
  target_gain = side_gate * level_gate * character * ratio_cap;

  target_gain < gain ? (
    gain = target_gain + width_gain_reduce * (gain - target_gain);
  ) : (
    gain = target_gain + width_gain_restore * (gain - target_gain);
  );

  gain = min(gain, ratio_cap);
  gain;
);

function hard_limit(x ceiling)
(
  min(max(x, -ceiling), ceiling);
);

function reset_phase_state() local(i)
(
 i=0;loop(12,cp_xl[i]=cp_yl[i]=cp_xr[i]=cp_yr[i]=0;i+=1;);
);

function cp_reset_hybrid() local(i)
(
  hybrid_write=0; hybrid_clock=0; hybrid_energy_write=0; hybrid_energy_count=0;
  hybrid_ref_sum=0; hybrid_delta_sum=0; hybrid_burden_accept=1; hybrid_gain=1;
  hybrid_limiter_active_count=0; hybrid_limiter_window_tracked=0;
  hybrid_candidate_prev=0; hybrid_event_start_abs=-1;
  hybrid_onset1=-1000000000; hybrid_onset2=-1000000000; hybrid_onset3=-1000000000;
  i=0; loop(hybrid_buf_len,
    hybrid_raw_l[i]=0; hybrid_raw_r[i]=0; hybrid_burden[i]=1; hybrid_eventgate[i]=0;
    hybrid_candidate_l[i]=0; hybrid_candidate_r[i]=0; hybrid_shaved_l[i]=0; hybrid_shaved_r[i]=0;
    hybrid_required[i]=1; hybrid_worklim[i]=ceiling; hybrid_makeup[i]=1; i+=1;
  );
  i=0; loop(hybrid_energy_len,hybrid_refe[i]=0;hybrid_deltae[i]=0;i+=1;);
  i=0; loop(hybrid_buf_len,hybrid_required_active[i]=0;i+=1;);
);

function reset_dynamic_state() local(i)
(
 cp_reset_hybrid();
 cp_comp_fade=0;cp_comp_old=mode_comp_delay_spl;
 se_reset();
  cf_reset();
cf_lp1_l.x1=cf_lp1_l.x2=cf_lp1_l.y1=cf_lp1_l.y2=0;
cf_lp1_r.x1=cf_lp1_r.x2=cf_lp1_r.y1=cf_lp1_r.y2=0;
cf_lp2_l.x1=cf_lp2_l.x2=cf_lp2_l.y1=cf_lp2_l.y2=0;
cf_lp2_r.x1=cf_lp2_r.x2=cf_lp2_r.y1=cf_lp2_r.y2=0;

  agc_lgain = 1;
  agc_hgain = 1;
  agc_lift_state_db = 0;
  final_backoff_db = 0;
  final_foundation_burden = 0;
  final_load_counter = 0;
  startup_activity = 0;
  agc_target = db2lin(c08);
  gate_prog_env = 0;
  gate_state = 0;
  gate_closed_memory = 0;
  gate_reopen_env = 0;
  gate_reopen_pulse = 0;
  agc_attack_assist_state = 0;
  agc_surge_catch_state = 0;
  agc_makeup_guard_state = 0;

  agc_low_env.e = 0;
  agc_high_env.e = 0;
  final_full_env.e = 0;
  final_threshold_drive_s = final_threshold_drive_target > 0 ? final_threshold_drive_target : 1;
  final_threshold_guard_gain = 1;
  preclip.gain = 1;
  final_round_l.prev_sat = 0;
  final_round_r.prev_sat = 0;


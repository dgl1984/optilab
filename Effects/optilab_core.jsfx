  dr_wet6 = smoothstep01((density_round_permission6-0.12)/(0.33-0.12)); dr_wet6 *= dr_wet6 * dr_wet6;
  dr_in_l=p1_l; dr_in_r=p1_r; dr_shape_l=density_round1_l.smooth_drive_rounder(dr_in_l*1.940885878,0.50*density_round_strength)/1.940885878; dr_shape_r=density_round1_r.smooth_drive_rounder(dr_in_r*1.940885878,0.50*density_round_strength)/1.940885878; p1_l=dr_in_l+dr_wet1*(dr_shape_l-dr_in_l); p1_r=dr_in_r+dr_wet1*(dr_shape_r-dr_in_r);
  dr_in_l=p2_l; dr_in_r=p2_r; dr_shape_l=density_round2_l.smooth_drive_rounder(dr_in_l*1.627421316,0.55*density_round_strength)/1.627421316; dr_shape_r=density_round2_r.smooth_drive_rounder(dr_in_r*1.627421316,0.55*density_round_strength)/1.627421316; p2_l=dr_in_l+dr_wet2*(dr_shape_l-dr_in_l); p2_r=dr_in_r+dr_wet2*(dr_shape_r-dr_in_r);
  dr_in_l=p3_l; dr_in_r=p3_r; dr_shape_l=density_round3_l.smooth_drive_rounder(dr_in_l*1.995262315,0.60*density_round_strength)/1.995262315; dr_shape_r=density_round3_r.smooth_drive_rounder(dr_in_r*1.995262315,0.60*density_round_strength)/1.995262315; p3_l=dr_in_l+dr_wet3*(dr_shape_l-dr_in_l); p3_r=dr_in_r+dr_wet3*(dr_shape_r-dr_in_r);
  dr_in_l=p4_l; dr_in_r=p4_r; dr_shape_l=density_round4_l.smooth_drive_rounder(dr_in_l*2.471724145,0.72*density_round_strength)/2.471724145; dr_shape_r=density_round4_r.smooth_drive_rounder(dr_in_r*2.471724145,0.72*density_round_strength)/2.471724145; p4_l=dr_in_l+dr_wet4*(dr_shape_l-dr_in_l); p4_r=dr_in_r+dr_wet4*(dr_shape_r-dr_in_r);
  dr_in_l=p5_l; dr_in_r=p5_r; dr_shape_l=density_round5_l.smooth_drive_rounder(dr_in_l*4.125722371,0.86*density_round_strength)/4.125722371; dr_shape_r=density_round5_r.smooth_drive_rounder(dr_in_r*4.125722371,0.86*density_round_strength)/4.125722371; p5_l=dr_in_l+dr_wet5*(dr_shape_l-dr_in_l); p5_r=dr_in_r+dr_wet5*(dr_shape_r-dr_in_r);
  dr_in_l=p6_l; dr_in_r=p6_r; dr_shape_l=density_round6_l.smooth_drive_rounder(dr_in_l*7.353599955,1.00*density_round_strength)/7.353599955; dr_shape_r=density_round6_r.smooth_drive_rounder(dr_in_r*7.353599955,1.00*density_round_strength)/7.353599955; p6_l=dr_in_l+dr_wet6*(dr_shape_l-dr_in_l); p6_r=dr_in_r+dr_wet6*(dr_shape_r-dr_in_r);
);

sum_l = p1_l + p2_l + p3_l + p4_l + p5_l + p6_l;

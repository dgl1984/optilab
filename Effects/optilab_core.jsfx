  adapt_bass_actuator_body_l.x1 = 0; adapt_bass_actuator_body_l.x2 = 0; adapt_bass_actuator_body_l.y1 = 0; adapt_bass_actuator_body_l.y2 = 0;
  adapt_bass_actuator_body_r.x1 = 0; adapt_bass_actuator_body_r.x2 = 0; adapt_bass_actuator_body_r.y1 = 0; adapt_bass_actuator_body_r.y2 = 0;
  adapt_bass_actuator_coeff_count = 63;
  adapt_bass_actuator_shelf_l.a0 = 1; adapt_bass_actuator_shelf_l.a1 = 0; adapt_bass_actuator_shelf_l.a2 = 0; adapt_bass_actuator_shelf_l.b1 = 0; adapt_bass_actuator_shelf_l.b2 = 0;
  adapt_bass_actuator_shelf_r.a0 = 1; adapt_bass_actuator_shelf_r.a1 = 0; adapt_bass_actuator_shelf_r.a2 = 0; adapt_bass_actuator_shelf_r.b1 = 0; adapt_bass_actuator_shelf_r.b2 = 0;
  adapt_bass_actuator_body_l.a0 = 1; adapt_bass_actuator_body_l.a1 = 0; adapt_bass_actuator_body_l.a2 = 0; adapt_bass_actuator_body_l.b1 = 0; adapt_bass_actuator_body_l.b2 = 0;
  adapt_bass_actuator_body_r.a0 = 1; adapt_bass_actuator_body_r.a1 = 0; adapt_bass_actuator_body_r.a2 = 0; adapt_bass_actuator_body_r.b1 = 0; adapt_bass_actuator_body_r.b2 = 0;
  adaptive_bass_foundation_guard_active_last = adaptive_bass_foundation_guard_active;
);

(fm_preemph_mode != fm_preemph_mode_last || stereo_section_mode != stereo_section_mode_last) ? (
  pre_l.x1 = 0; pre_l.primed = 0;
  pre_r.x1 = 0; pre_r.primed = 0;
  deemph_l.x1 = 0; deemph_l.primed = 0;
  deemph_r.x1 = 0; deemph_r.primed = 0;
);

(stereo_mode != stereo_mode_last || stereo_width_pct != stereo_width_pct_last || stereo_section_mode != stereo_section_mode_last) ? (
  adaptive_width.mid_fast = 0;
  adaptive_width.mid_slow = 0;
  adaptive_width.mid_env = 0;
  adaptive_width.side_env = 0;
  adaptive_width.gain = 0;
  meter_blk_width_added_max = 1;
);

fm_preemph_mode_last = fm_preemph_mode;
stereo_mode_last = stereo_mode;
stereo_width_pct_last = stereo_width_pct;
stereo_section_mode_last = stereo_section_mode;

@block

block_srate_safe = (srate >= 8000 && srate <= 768000) ? srate : 48000;
block_srate_safe != srate_safe ? (
  srate_safe = block_srate_safe;
  update_derived_params();
  reset_dynamic_state();
  reset_meter_state();
);

pdc_target_delay = path_delay + hybrid_total_spl;
pdc_delay != pdc_target_delay ? pdc_delay = pdc_target_delay;
pdc_bot_ch != 0 ? pdc_bot_ch = 0;
pdc_top_ch != 2 ? pdc_top_ch = 2;

@sample
preset_state_reset ? (
  reset_dynamic_state();
  preset_state_reset = 0;
);

meter_cpu_count += 1;
meter_cpu_count >= 64 ? (
  meter_heavy_tick = 1;
  meter_cpu_count = 0;
) : (
  meter_heavy_tick = 0;
);

shape_rec_count += 1;
shape_rec_count >= shape_rec_block_size ? (
  shape_rec_heavy_tick = 1;
  shape_rec_count = 0;
) : (
  shape_rec_heavy_tick = 0;
);

adaptive_cpu_count += 1;
adaptive_cpu_count >= 16 ? (
  adaptive_cpu_tick = 1;
  adaptive_cpu_count = 0;
) : (
  adaptive_cpu_tick = 0;
);

diag_active = 0;
diag_l = 0;
diag_r = 0;

spl0 = abs(spl0) < 1000000000000 ? spl0 : 0;
spl1 = abs(spl1) < 1000000000000 ? spl1 : 0;
input_section_in_l = spl0;
input_section_in_r = spl1;

input_section_mode == 3 ? (
  l = input_section_in_l;
  r = input_section_in_r;
) : (
  l_in = input_section_in_l * input_gain;
  r_in = input_section_in_r * input_gain;

  core_mode == 1 ? (
    hpl = hp30_l.onepole_hp(l_in, hpf30_a);
    hpr = hp30_r.onepole_hp(r_in, hpf30_a);
    l = l_in + (hpl-l_in)*stream_hpf_mix;
    r = r_in + (hpr-r_in)*stream_hpf_mix;
  ) : subsonic_hpf ? (
    l = hp30_l.onepole_hp(l_in, hpf30_a);
    r = hp30_r.onepole_hp(r_in, hpf30_a);
  ) : (
    l = l_in;
    r = r_in;
  );

  phase_stages > 0 ? (
    l_rot = l;
    r_rot = r;
    phase_stages >= 1 ? ( l_rot = ap1_l.allpass1(l_rot, ap1_c); r_rot = ap1_r.allpass1(r_rot, ap1_c); );
    phase_stages >= 2 ? ( l_rot = ap2_l.allpass1(l_rot, ap2_c); r_rot = ap2_r.allpass1(r_rot, ap2_c); );
    phase_stages >= 3 ? ( l_rot = ap3_l.allpass1(l_rot, ap3_c); r_rot = ap3_r.allpass1(r_rot, ap3_c); );
    phase_stages >= 4 ? ( l_rot = ap4_l.allpass1(l_rot, ap4_c); r_rot = ap4_r.allpass1(r_rot, ap4_c); );
    phase_stages >= 5 ? ( l_rot = ap5_l.allpass1(l_rot, ap5_c); r_rot = ap5_r.allpass1(r_rot, ap5_c); );
    phase_stages >= 6 ? ( l_rot = ap6_l.allpass1(l_rot, ap6_c); r_rot = ap6_r.allpass1(r_rot, ap6_c); );
    phase_stages >= 7 ? ( l_rot = ap7_l.allpass1(l_rot, ap7_c); r_rot = ap7_r.allpass1(r_rot, ap7_c); );
    phase_stages >= 8 ? ( l_rot = ap8_l.allpass1(l_rot, ap8_c); r_rot = ap8_r.allpass1(r_rot, ap8_c); );
    phase_stages >= 9 ? ( l_rot = ap9_l.allpass1(l_rot, ap9_c); r_rot = ap9_r.allpass1(r_rot, ap9_c); );
    phase_stages >= 10 ? ( l_rot = ap10_l.allpass1(l_rot, ap10_c); r_rot = ap10_r.allpass1(r_rot, ap10_c); );
    phase_stages >= 11 ? ( l_rot = ap11_l.allpass1(l_rot, ap11_c); r_rot = ap11_r.allpass1(r_rot, ap11_c); );
    phase_stages >= 12 ? ( l_rot = ap12_l.allpass1(l_rot, ap12_c); r_rot = ap12_r.allpass1(r_rot, ap12_c); );
    l = l_rot;
    r = r_rot;
  );
);

input_section_proc_l = l;
input_section_proc_r = r;
input_section_mode == 1 ? (
  diag_l = input_section_proc_l;
  diag_r = input_section_proc_r;
  diag_active = 1;
) : input_section_mode == 2 ? (
  diag_l = input_section_proc_l - input_section_in_l;
  diag_r = input_section_proc_r - input_section_in_r;
  diag_active = 1;
);

agc_section_in_l = l;
agc_section_in_r = r;

agc_l = l * agc_drive;
agc_r = r * agc_drive;

crossover_model == 1 ? (
  low_l = agc_lp_l.onepole_lp2(agc_l, agc_split_a);
  low_r = agc_lp_r.onepole_lp2(agc_r, agc_split_a);
) : (

  low_l = agc_lp_l.onepole_lp(agc_l, agc_split_a);
  low_r = agc_lp_r.onepole_lp(agc_r, agc_split_a);
);
high_l = agc_l - low_l;
high_r = agc_r - low_r;

low_det = absmax2(low_l, low_r);
high_det = absmax2(high_l, high_r);
full_det = absmax2(agc_l, agc_r);

low_env = agc_low_env.peak_env(low_det, agc_env_attack, agc_release);
high_env = agc_high_env.peak_env(high_det, agc_env_attack, agc_release);

gate_prog_env = max(full_det, gate_prog_env * gate_detector_release);
gate_open_now = full_det >= gate_lin ? 1 : 0;
gate_target = gate_prog_env < gate_lin ? 1 : 0;
gate_prev_state = gate_state;
gate_closed_memory = max(gate_closed_memory * gate_reopen_decay, gate_state);
gate_open_now > 0 ? (
  gate_state = gate_state * gate_open_coeff;
) : (
  gate_target > gate_state ? (
    gate_state = gate_target + gate_close_coeff * (gate_state - gate_target);
  ) : (
    gate_state = gate_target + gate_open_coeff * (gate_state - gate_target);
  );
);
gate_state = clamp(gate_state, 0, 1);

gate_effective = gate_state * (1 - gate_open_now);

gate_reopen_pulse = gate_open_now * clamp(max(gate_prev_state, gate_closed_memory) * gate_reopen_pulse_scale, 0, 1);
gate_reopen_env = max(gate_reopen_env * gate_reopen_decay, gate_reopen_pulse);
gate_open_now > 0 ? gate_closed_memory *= gate_reopen_decay;

gate_reopen_env > 0 ? (

  gate_mem_clear_coeff = 1 - gate_reopen_env * (1 - gate_reopen_env_release);
  low_env = agc_low_env.peak_env_set(low_det + gate_mem_clear_coeff * (low_env - low_det));
  high_env = agc_high_env.peak_env_set(high_det + gate_mem_clear_coeff * (high_env - high_det));
);

low_tgain = clamp(agc_target / max(low_env, 0.000001), agc_min_gain, agc_max_gain);
high_tgain = clamp(agc_target / max(high_env, 0.000001), agc_min_gain, agc_max_gain);

low_tgain = low_tgain * (1 - bass_coupling) + high_tgain * bass_coupling;

gate_effective > 0 ? (
  gated_low_tgain = min(low_tgain, agc_lgain);
  gated_high_tgain = min(high_tgain, agc_hgain);
  low_tgain = low_tgain * (1 - gate_effective) + gated_low_tgain * gate_effective;
  high_tgain = high_tgain * (1 - gate_effective) + gated_high_tgain * gate_effective;
);

agc_low_depth = clamp((1 - agc_lgain) * 1.3333333333333333, 0, 1);
agc_high_depth = clamp((1 - agc_hgain) * 1.3333333333333333, 0, 1);

pd_agc = pd_release * 0.15;
agc_low_rel = agc_release * (1 - pd_agc * agc_low_depth) + agc_release_slow * (pd_agc * agc_low_depth);
agc_high_rel = agc_release * (1 - pd_agc * agc_high_depth) + agc_release_slow * (pd_agc * agc_high_depth);

agc_low_rel = agc_low_rel * (1 - gate_effective) + gate_agc_freeze_release * gate_effective;
agc_high_rel = agc_high_rel * (1 - gate_effective) + gate_agc_freeze_release * gate_effective;

gate_reopen_rel_mix = gate_reopen_env * (0.35 + 0.45 * gate_reopen_strength);
agc_gate_reopen_rel_mix = gate_reopen_env * (0.06 + 0.16 * gate_reopen_strength);
agc_low_rel = agc_low_rel * (1 - agc_gate_reopen_rel_mix) + gate_reopen_release * agc_gate_reopen_rel_mix;
agc_high_rel = agc_high_rel * (1 - agc_gate_reopen_rel_mix) + gate_reopen_release * agc_gate_reopen_rel_mix;

low_tgain < agc_lgain ? agc_lgain = low_tgain + agc_gain_attack * (agc_lgain - low_tgain) : agc_lgain = low_tgain + agc_low_rel * (agc_lgain - low_tgain);
high_tgain < agc_hgain ? agc_hgain = high_tgain + agc_gain_attack * (agc_hgain - high_tgain) : agc_hgain = high_tgain + agc_high_rel * (agc_hgain - high_tgain);

gate_agc_drift_amt = (1 - gate_agc_drift_coeff) * gate_effective;
agc_lgain += gate_agc_drift_amt * (gate_agc_drift_target - agc_lgain);
agc_hgain += gate_agc_drift_amt * (gate_agc_drift_target - agc_hgain);

agc_low_raw_l = low_l * inv_agc_drive_safe;
agc_low_raw_r = low_r * inv_agc_drive_safe;
agc_high_raw_l = high_l * inv_agc_drive_safe;
agc_high_raw_r = high_r * inv_agc_drive_safe;

agc_low_proc_gain = agc_drive * agc_lgain;
agc_high_proc_gain = agc_drive * agc_hgain;
agc_low_authority = agc_low_proc_gain < 1 ? agc_down_mix : agc_mix;
agc_high_authority = agc_high_proc_gain < 1 ? agc_down_mix : agc_mix;
agc_low_eff_gain = 1 + (agc_low_proc_gain - 1) * agc_low_authority;
agc_high_eff_gain = 1 + (agc_high_proc_gain - 1) * agc_high_authority;

agc_out_l = agc_low_raw_l * agc_low_eff_gain + agc_high_raw_l * agc_high_eff_gain;
agc_out_r = agc_low_raw_r * agc_low_eff_gain + agc_high_raw_r * agc_high_eff_gain;

l = agc_out_l;
r = agc_out_r;

agc_section_mode == 3 ? (
  l = agc_section_in_l;
  r = agc_section_in_r;
) : (

  post_agc_smooth_drive_amt > 0.0000001 ? (
    l = post_agc_round_l.smooth_drive_rounder(l, post_agc_smooth_drive_amt) * post_agc_smooth_recovery_gain;
    r = post_agc_round_r.smooth_drive_rounder(r, post_agc_smooth_drive_amt) * post_agc_smooth_recovery_gain;
  );
);

agc_section_proc_l = l;
agc_section_proc_r = r;
agc_section_mode == 1 ? (
  diag_l = agc_section_proc_l;
  diag_r = agc_section_proc_r;
  diag_active = 1;
) : agc_section_mode == 2 ? (
  diag_l = agc_section_proc_l - agc_section_in_l;
  diag_r = agc_section_proc_r - agc_section_in_r;
  diag_active = 1;
);

mastering_lookahead_samps > 0 ? (
  master_side_det = absmax2(l, r);
  master_raw_det = absmax2(input_section_in_l, input_section_in_r);
  master_amp_det = master_side_det;

  master_startup_active = max(master_side_det, master_raw_det) > master_startup_active_thresh;
  master_startup_armed > 0 ? (
    master_startup_active ? (
      master_startup_age < master_startup_prime_window ? (
        i = 0;
        loop(master_buf_len,
          master_buf_l[i] = l;
          master_buf_r[i] = r;
          i += 1;
        );
        master_wrpos = 0;
        master_raw_env.peak_env_set(max(master_raw_det, 0.000001));
        master_amp_env.peak_env_set(max(master_amp_det, 0.000001));
        master_catch_env.peak_env_set(max(master_side_det, 0.000001));
        master_catch_gain = 1;
      );
      master_startup_armed = 0;
    ) : (
      master_startup_age += 1;
      master_startup_age >= master_startup_prime_window ? master_startup_armed = 0;
    );
  );

  master_raw_level = master_raw_env.peak_env(master_raw_det, master_env_attack, master_env_release);
  master_amp_level = master_amp_env.peak_env(master_amp_det, master_env_attack, master_env_release);
  master_net_makeup_db = lin2db(master_amp_level / max(master_raw_level, 0.000001));
  master_allow = clamp((master_net_makeup_db - 3.0) * 0.11111111111111111, 0, 1);

  master_catch_thresh = const_db2lin_minus6_2;
  master_catch_det = master_catch_env.peak_env(master_side_det, master_catch_attack, master_catch_release);
  master_target_gain = master_catch_det > master_catch_thresh ? master_catch_thresh / max(master_catch_det, 0.000001) : 1;
  master_target_gain = clamp(master_target_gain, const_db2lin_minus3_6, 1);
  master_target_gain = 1 - master_allow * (1 - master_target_gain);
  master_target_gain < master_catch_gain ? (
    master_catch_gain = master_target_gain + master_catch_attack * (master_catch_gain - master_target_gain);
  ) : (
    master_catch_gain = master_target_gain + master_catch_release * (master_catch_gain - master_target_gain);
  );

  mrdpos = master_wrpos - mastering_lookahead_samps;
  mrdpos < 0 ? mrdpos += master_buf_len;
  md_l = master_buf_l[mrdpos];
  md_r = master_buf_r[mrdpos];
  master_buf_l[master_wrpos] = l;
  master_buf_r[master_wrpos] = r;
  master_wrpos += 1;
  master_wrpos >= master_buf_len ? master_wrpos = 0;

  l = md_l * master_catch_gain;
  r = md_r * master_catch_gain;
) : (
  master_catch_gain = 1;
  master_startup_armed = 1;
  master_startup_age = 0;
);

bass_section_in_l = l;
bass_section_in_r = r;
bass_pre_eq_l = l;
bass_pre_eq_r = r;
bass_boosted_l = bass_peak_l.biquad_run(l);
bass_boosted_r = bass_peak_r.biquad_run(r);

legacy_bass_l = bass_boosted_l;
legacy_bass_r = bass_boosted_r;
stream_foundation_mix < 0.9999999 && adaptive_bass_coupling > 0 ? (
  legacy_ab_low_l = legacy_adapt_bass_lp_l.onepole_lp2(bass_boosted_l, legacy_adapt_bass_split_a);
  legacy_ab_low_r = legacy_adapt_bass_lp_r.onepole_lp2(bass_boosted_r, legacy_adapt_bass_split_a);
  legacy_ab_high_l = bass_boosted_l - legacy_ab_low_l;
  legacy_ab_high_r = bass_boosted_r - legacy_ab_low_r;
  legacy_ab_bass_det = absmax2(legacy_ab_low_l, legacy_ab_low_r);
  legacy_ab_prog_det = max(absmax2(bass_boosted_l, bass_boosted_r), absmax2(legacy_ab_high_l, legacy_ab_high_r)*1.20);
  legacy_ab_bass_level = legacy_adapt_bass_env.peak_env(legacy_ab_bass_det, legacy_adapt_bass_det_attack, legacy_adapt_bass_det_release);
  legacy_ab_prog_level = legacy_adapt_prog_env.peak_env(legacy_ab_prog_det, legacy_adapt_bass_det_attack, legacy_adapt_bass_det_release);
  legacy_ab_ratio = legacy_ab_bass_level/max(legacy_ab_prog_level,0.000001);
  legacy_ab_thin = clamp((legacy_adapt_bass_target_low-legacy_ab_ratio)/max(legacy_adapt_bass_target_low-0.105,0.000001),0,1);
  legacy_ab_heavy = clamp((legacy_ab_ratio-legacy_adapt_bass_target_high)/max(0.82-legacy_adapt_bass_target_high,0.000001),0,1);
  legacy_ab_gain_target_db = legacy_adapt_bass_max_boost_db*legacy_ab_thin-legacy_adapt_bass_max_cut_db*legacy_ab_heavy;
  legacy_ab_gain_target = db2lin(legacy_ab_gain_target_db);
  legacy_adapt_bass_gain <= 0 ? legacy_adapt_bass_gain = 1;
  legacy_ab_gain_target < legacy_adapt_bass_gain ? (
    legacy_adapt_bass_gain = legacy_ab_gain_target + legacy_adapt_bass_gain_down*(legacy_adapt_bass_gain-legacy_ab_gain_target);
  ) : (
    legacy_adapt_bass_gain = legacy_ab_gain_target + legacy_adapt_bass_gain_up*(legacy_adapt_bass_gain-legacy_ab_gain_target);
  );
  legacy_bass_l = legacy_ab_high_l + legacy_ab_low_l*legacy_adapt_bass_gain;
  legacy_bass_r = legacy_ab_high_r + legacy_ab_low_r*legacy_adapt_bass_gain;
);

foundation_bass_l = bass_boosted_l;
foundation_bass_r = bass_boosted_r;
adaptive_bass_foundation_guard_active ? (
  abm_lp70_l = adapt_bass_model_70_l.biquad_run(bass_pre_eq_l);
  abm_lp70_r = adapt_bass_model_70_r.biquad_run(bass_pre_eq_r);
  abm_lp250_l = adapt_bass_model_250_l.biquad_run(bass_pre_eq_l);
  abm_lp250_r = adapt_bass_model_250_r.biquad_run(bass_pre_eq_r);
  abm_lp420_l = adapt_bass_model_420_l.biquad_run(bass_pre_eq_l);
  abm_lp420_r = adapt_bass_model_420_r.biquad_run(bass_pre_eq_r);
  abm_lp3700_l = adapt_bass_model_3700_l.biquad_run(bass_pre_eq_l);
  abm_lp3700_r = adapt_bass_model_3700_r.biquad_run(bass_pre_eq_r);

  abm_deep_l = abm_lp70_l;
  abm_deep_r = abm_lp70_r;
  abm_useful_l = abm_lp250_l - abm_lp70_l;
  abm_useful_r = abm_lp250_r - abm_lp70_r;
  abm_mid_l = abm_lp3700_l - abm_lp420_l;
  abm_mid_r = abm_lp3700_r - abm_lp420_r;

  abm_deep_power = (abm_deep_l * abm_deep_l + abm_deep_r * abm_deep_r) * 0.5;
  abm_useful_power = (abm_useful_l * abm_useful_l + abm_useful_r * abm_useful_r) * 0.5;
  abm_mid_power = (abm_mid_l * abm_mid_l + abm_mid_r * abm_mid_r) * 0.5;
  abm_program_det = max(absmax2(bass_pre_eq_l, bass_pre_eq_r),
                        max(absmax2(abm_deep_l, abm_deep_r),
                            max(absmax2(abm_useful_l, abm_useful_r), absmax2(abm_mid_l, abm_mid_r))));

  abm_program_det >= 0.00003 ? adapt_bass_model_age_samples += 1;
  adapt_bass_model_primed <= 0 && abm_program_det > 0.00001 ? (
    adapt_bass_model_deep_env.e = abm_deep_power;
    adapt_bass_model_useful_env.e = abm_useful_power;
    adapt_bass_model_mid_env.e = abm_mid_power;
    adapt_bass_model_slow_deep_env.e = abm_deep_power;
    adapt_bass_model_slow_useful_env.e = abm_useful_power;
    adapt_bass_model_slow_mid_env.e = abm_mid_power;
    adapt_bass_model_primed = 1;
  );

  abm_fast_deep_energy = adapt_bass_model_deep_env.peak_env(abm_deep_power, adapt_bass_model_det_attack, adapt_bass_model_det_release);
  abm_fast_useful_energy = adapt_bass_model_useful_env.peak_env(abm_useful_power, adapt_bass_model_det_attack, adapt_bass_model_det_release);
  abm_fast_mid_energy = adapt_bass_model_mid_env.peak_env(abm_mid_power, adapt_bass_model_det_attack, adapt_bass_model_det_release);
  abm_slow_deep_energy = adapt_bass_model_slow_deep_env.peak_env(abm_deep_power, adapt_bass_model_slow_attack, adapt_bass_model_slow_release);
  abm_slow_useful_energy = adapt_bass_model_slow_useful_env.peak_env(abm_useful_power, adapt_bass_model_slow_attack, adapt_bass_model_slow_release);
  abm_slow_mid_energy = adapt_bass_model_slow_mid_env.peak_env(abm_mid_power, adapt_bass_model_slow_attack, adapt_bass_model_slow_release);

  adaptive_cpu_tick ? (
    abm_valid_program = abm_fast_mid_energy > 0.000000000001 && abm_program_det >= 0.00003;
    abm_valid_program ? (
      abm_fast_deep_ratio_db = lin2db(sqrt(max(abm_fast_deep_energy, 0.000000000001) / max(abm_fast_mid_energy, 0.000000000001)));
      abm_fast_useful_ratio_db = lin2db(sqrt(max(abm_fast_useful_energy, 0.000000000001) / max(abm_fast_mid_energy, 0.000000000001)));
      abm_slow_deep_ratio_db = lin2db(sqrt(max(abm_slow_deep_energy, 0.000000000001) / max(abm_slow_mid_energy, 0.000000000001)));
      abm_slow_useful_ratio_db = lin2db(sqrt(max(abm_slow_useful_energy, 0.000000000001) / max(abm_slow_mid_energy, 0.000000000001)));

      abm_fast_deep_boost_1 = smoothstep01((-6.2 - abm_fast_deep_ratio_db) / 2.8);
      abm_fast_deep_boost_2 = smoothstep01((-9.0 - abm_fast_deep_ratio_db) / 7.0);
      abm_fast_deep_boost_3 = smoothstep01((-16.0 - abm_fast_deep_ratio_db) / 8.0);
      abm_fast_deep_boost_db = (4.0 * abm_fast_deep_boost_1 + 3.0 * abm_fast_deep_boost_2 + 0.7 * abm_fast_deep_boost_3) * adapt_bass_boost_scale;
      abm_slow_deep_boost_1 = smoothstep01((-6.2 - abm_slow_deep_ratio_db) / 2.8);
      abm_slow_deep_boost_2 = smoothstep01((-9.0 - abm_slow_deep_ratio_db) / 7.0);
      abm_slow_deep_boost_3 = smoothstep01((-16.0 - abm_slow_deep_ratio_db) / 8.0);
      abm_slow_deep_boost_db = (4.0 * abm_slow_deep_boost_1 + 3.0 * abm_slow_deep_boost_2 + 0.7 * abm_slow_deep_boost_3) * adapt_bass_boost_scale;

      abm_fast_deep_support = smoothstep01((-5.8 - abm_fast_deep_ratio_db) / 2.5);
      abm_fast_useful_boost_1 = smoothstep01((-0.35 - abm_fast_useful_ratio_db) / 1.65);
      abm_fast_useful_boost_2 = smoothstep01((-2.0 - abm_fast_useful_ratio_db) / 4.0);
      abm_fast_useful_boost_3 = smoothstep01((-6.0 - abm_fast_useful_ratio_db) / 4.5);
      abm_fast_useful_boost_db = (3.5 * abm_fast_useful_boost_1 + 2.7 * abm_fast_useful_boost_2 + 1.5 * abm_fast_useful_boost_3) * abm_fast_deep_support * adapt_bass_boost_scale;
      abm_slow_deep_support = smoothstep01((-5.8 - abm_slow_deep_ratio_db) / 2.5);
      abm_slow_useful_boost_1 = smoothstep01((-0.35 - abm_slow_useful_ratio_db) / 1.65);
      abm_slow_useful_boost_2 = smoothstep01((-2.0 - abm_slow_useful_ratio_db) / 4.0);
      abm_slow_useful_boost_3 = smoothstep01((-6.0 - abm_slow_useful_ratio_db) / 4.5);
      abm_slow_useful_boost_db = (3.5 * abm_slow_useful_boost_1 + 2.7 * abm_slow_useful_boost_2 + 1.5 * abm_slow_useful_boost_3) * abm_slow_deep_support * adapt_bass_boost_scale;

      abm_slow_deep_cut_1 = smoothstep01((abm_slow_deep_ratio_db + 0.3) / 1.0);
      abm_slow_deep_cut_2 = smoothstep01((abm_slow_deep_ratio_db - 0.7) / 2.3);
      abm_slow_deep_cut_db = (4.5 * abm_slow_deep_cut_1 + 0.5 * abm_slow_deep_cut_2) * adapt_bass_cut_authority;
      abm_slow_lean_pos = smoothstep01((-0.5 - abm_slow_deep_ratio_db) / 2.0);
      abm_slow_useful_cut_start_db = 1.5 + 2.0 * abm_slow_lean_pos;
      abm_slow_useful_abs_cut = smoothstep01((abm_slow_useful_ratio_db - abm_slow_useful_cut_start_db) / 1.5);
      abm_slow_useful_shape_cut = smoothstep01((abm_slow_useful_ratio_db - abm_slow_deep_ratio_db - 0.6) / 1.5);
      abm_slow_useful_cut_db = 4.5 * abm_slow_useful_abs_cut * (0.20 + 0.80 * abm_slow_useful_shape_cut) * adapt_bass_cut_authority;
      abm_slow_broad_support = smoothstep01((abm_slow_deep_ratio_db + 3.0) / 2.5);
      abm_slow_deep_cut_db = max(abm_slow_deep_cut_db, 0.90 * abm_slow_useful_cut_db * abm_slow_broad_support);

      abm_cut_ready = adapt_bass_model_age_samples >= adapt_bass_model_cut_holdoff_samples;
      abm_fast_deep_cut_db = abm_cut_ready ? 5.0 * smoothstep01((abm_fast_deep_ratio_db - 0.5) / 2.2) * adapt_bass_cut_authority : 0;
      abm_fast_useful_cut_db = abm_cut_ready ? 4.5 * smoothstep01((abm_fast_useful_ratio_db - 3.2) / 1.6)
                                            * smoothstep01((abm_fast_deep_ratio_db - 0.0) / 1.4)
                                            * adapt_bass_cut_authority : 0;
      abm_fast_deep_cut_db = max(abm_fast_deep_cut_db, 0.90 * abm_fast_useful_cut_db);
    ) : (
      abm_fast_deep_boost_db = 0;
      abm_fast_useful_boost_db = 0;
      abm_slow_deep_boost_db = 0;
      abm_slow_useful_boost_db = 0;
      abm_slow_deep_cut_db = 0;
      abm_slow_useful_cut_db = 0;
      abm_fast_deep_cut_db = 0;
      abm_fast_useful_cut_db = 0;
    );

    abm_fast_deep_boost_db > adapt_bass_model_fast_deep_boost_evidence_db ?
      adapt_bass_model_fast_deep_boost_evidence_db = abm_fast_deep_boost_db + adapt_bass_model_fast_boost_attack_tick * (adapt_bass_model_fast_deep_boost_evidence_db - abm_fast_deep_boost_db) :
      adapt_bass_model_fast_deep_boost_evidence_db = abm_fast_deep_boost_db + adapt_bass_model_fast_boost_release_tick * (adapt_bass_model_fast_deep_boost_evidence_db - abm_fast_deep_boost_db);
    abm_fast_useful_boost_db > adapt_bass_model_fast_useful_boost_evidence_db ?
      adapt_bass_model_fast_useful_boost_evidence_db = abm_fast_useful_boost_db + adapt_bass_model_fast_boost_attack_tick * (adapt_bass_model_fast_useful_boost_evidence_db - abm_fast_useful_boost_db) :
      adapt_bass_model_fast_useful_boost_evidence_db = abm_fast_useful_boost_db + adapt_bass_model_fast_boost_release_tick * (adapt_bass_model_fast_useful_boost_evidence_db - abm_fast_useful_boost_db);
    abm_fast_deep_cut_db > adapt_bass_model_fast_deep_cut_evidence_db ?
      adapt_bass_model_fast_deep_cut_evidence_db = abm_fast_deep_cut_db + adapt_bass_model_fast_cut_attack_tick * (adapt_bass_model_fast_deep_cut_evidence_db - abm_fast_deep_cut_db) :
      adapt_bass_model_fast_deep_cut_evidence_db = abm_fast_deep_cut_db + adapt_bass_model_fast_cut_release_tick * (adapt_bass_model_fast_deep_cut_evidence_db - abm_fast_deep_cut_db);
    abm_fast_useful_cut_db > adapt_bass_model_fast_useful_cut_evidence_db ?
      adapt_bass_model_fast_useful_cut_evidence_db = abm_fast_useful_cut_db + adapt_bass_model_fast_cut_attack_tick * (adapt_bass_model_fast_useful_cut_evidence_db - abm_fast_useful_cut_db) :
      adapt_bass_model_fast_useful_cut_evidence_db = abm_fast_useful_cut_db + adapt_bass_model_fast_cut_release_tick * (adapt_bass_model_fast_useful_cut_evidence_db - abm_fast_useful_cut_db);

    abm_deep_boost_target_db = max(abm_slow_deep_boost_db, 0.70 * adapt_bass_model_fast_deep_boost_evidence_db);
    abm_useful_boost_target_db = max(abm_slow_useful_boost_db, 0.70 * adapt_bass_model_fast_useful_boost_evidence_db);
    abm_deep_cut_target_db = max(abm_slow_deep_cut_db, 0.95 * adapt_bass_model_fast_deep_cut_evidence_db);
    abm_useful_cut_target_db = max(abm_slow_useful_cut_db, 0.95 * adapt_bass_model_fast_useful_cut_evidence_db);
    abm_global_cut_target_db = max(abm_deep_cut_target_db, abm_useful_cut_target_db);

    abm_deep_boost_target_db > adapt_bass_model_deep_boost_state_db ? (
      adapt_bass_model_deep_boost_state_db = abm_deep_boost_target_db + adapt_bass_model_boost_attack_tick * (adapt_bass_model_deep_boost_state_db - abm_deep_boost_target_db);
    ) : (
      abm_boost_coeff = abm_global_cut_target_db > 0.60 ? adapt_bass_model_boost_suppress_tick : adapt_bass_model_boost_release_tick;
      adapt_bass_model_deep_boost_state_db = abm_deep_boost_target_db + abm_boost_coeff * (adapt_bass_model_deep_boost_state_db - abm_deep_boost_target_db);
    );
    abm_useful_boost_target_db > adapt_bass_model_useful_boost_state_db ? (
      adapt_bass_model_useful_boost_state_db = abm_useful_boost_target_db + adapt_bass_model_boost_attack_tick * (adapt_bass_model_useful_boost_state_db - abm_useful_boost_target_db);
    ) : (
      abm_boost_coeff = abm_global_cut_target_db > 0.60 ? adapt_bass_model_boost_suppress_tick : adapt_bass_model_boost_release_tick;
      adapt_bass_model_useful_boost_state_db = abm_useful_boost_target_db + abm_boost_coeff * (adapt_bass_model_useful_boost_state_db - abm_useful_boost_target_db);
    );

    abm_deep_cut_target_db > adapt_bass_model_deep_cut_state_db ? (
      adapt_bass_model_deep_cut_state_db = abm_deep_cut_target_db + adapt_bass_model_cut_attack_tick * (adapt_bass_model_deep_cut_state_db - abm_deep_cut_target_db);
    ) : (
      abm_cut_coeff = abm_deep_boost_target_db > 2.0 ? adapt_bass_model_cut_suppress_tick : adapt_bass_model_cut_release_tick;
      adapt_bass_model_deep_cut_state_db = abm_deep_cut_target_db + abm_cut_coeff * (adapt_bass_model_deep_cut_state_db - abm_deep_cut_target_db);
    );
    abm_useful_cut_target_db > adapt_bass_model_useful_cut_state_db ? (
      adapt_bass_model_useful_cut_state_db = abm_useful_cut_target_db + adapt_bass_model_cut_attack_tick * (adapt_bass_model_useful_cut_state_db - abm_useful_cut_target_db);
    ) : (
      abm_cut_coeff = abm_useful_boost_target_db > 2.0 ? adapt_bass_model_cut_suppress_tick : adapt_bass_model_cut_release_tick;
      adapt_bass_model_useful_cut_state_db = abm_useful_cut_target_db + abm_cut_coeff * (adapt_bass_model_useful_cut_state_db - abm_useful_cut_target_db);
    );

    adapt_bass_model_deep_raw_db = adapt_bass_model_deep_boost_state_db - adapt_bass_model_deep_cut_state_db;
    adapt_bass_model_useful_raw_db = adapt_bass_model_useful_boost_state_db - adapt_bass_model_useful_cut_state_db;

    adapt_bass_model_deep_raw_db * adapt_bass_model_useful_raw_db >= 0 ? (
      abs(adapt_bass_model_deep_raw_db) >= abs(adapt_bass_model_useful_raw_db) ? (
        abm_deep_target_db = adapt_bass_model_deep_raw_db + (adapt_bass_model_useful_raw_db - adapt_bass_model_deep_raw_db) * (0.08 * adapt_bass_lab_link);
        abm_useful_target_db = adapt_bass_model_useful_raw_db + (adapt_bass_model_deep_raw_db - adapt_bass_model_useful_raw_db) * (0.70 * adapt_bass_lab_link);
      ) : (
        abm_useful_target_db = adapt_bass_model_useful_raw_db + (adapt_bass_model_deep_raw_db - adapt_bass_model_useful_raw_db) * (0.08 * adapt_bass_lab_link);
        abm_deep_target_db = adapt_bass_model_deep_raw_db + (adapt_bass_model_useful_raw_db - adapt_bass_model_deep_raw_db) * (0.70 * adapt_bass_lab_link);
      );
    ) : (
      abm_shared_db = (adapt_bass_model_deep_raw_db + adapt_bass_model_useful_raw_db) * 0.5;
      abm_deep_target_db = adapt_bass_model_deep_raw_db + (abm_shared_db - adapt_bass_model_deep_raw_db) * (0.10 * adapt_bass_lab_link);
      abm_useful_target_db = adapt_bass_model_useful_raw_db + (abm_shared_db - adapt_bass_model_useful_raw_db) * (0.10 * adapt_bass_lab_link);
    );

    abm_withdraw_pos = smoothstep01(clamp(abm_global_cut_target_db / 3.5, 0, 1));
    abm_voice_target = 1 - clamp(adapt_bass_withdraw_authority * abm_withdraw_pos, 0, 1);
    adapt_bass_model_deep_target_cached = db2lin(abm_deep_target_db);
    adapt_bass_model_useful_target_cached = db2lin(abm_useful_target_db);
    adapt_bass_model_deep_target_db_cached = abm_deep_target_db;
    adapt_bass_model_useful_target_db_cached = abm_useful_target_db;
    adapt_bass_model_voice_target_cached = abm_voice_target;
  );

  adapt_bass_model_deep_gain = adapt_bass_model_deep_target_cached;
  adapt_bass_model_useful_gain = adapt_bass_model_useful_target_cached;

  adapt_bass_model_voice_target_cached < adapt_bass_model_voice_gain ? (
    adapt_bass_model_voice_gain = adapt_bass_model_voice_target_cached
                                + adapt_bass_model_voice_withdraw * (adapt_bass_model_voice_gain - adapt_bass_model_voice_target_cached);
  ) : (
    adapt_bass_model_voice_gain = adapt_bass_model_voice_target_cached
                                + adapt_bass_model_voice_return * (adapt_bass_model_voice_gain - adapt_bass_model_voice_target_cached);
  );

  abm_voiced_l = bass_pre_eq_l + (bass_boosted_l - bass_pre_eq_l) * adapt_bass_model_voice_gain;
  abm_voiced_r = bass_pre_eq_r + (bass_boosted_r - bass_pre_eq_r) * adapt_bass_model_voice_gain;

  adapt_bass_actuator_coeff_count += 1;
  adapt_bass_actuator_coeff_count >= 64 ? (
    adapt_bass_actuator_coeff_count = 0;
    abm_actuator_body_source_db = adapt_bass_model_useful_target_db_cached;
    abm_actuator_body_source_db >= 0 ? (
      abm_actuator_body_db = min(3.0, abm_actuator_body_source_db * 0.50);
      abm_actuator_body_freq = 90;
      abm_actuator_body_q = 1.10;
    ) : (
      abm_actuator_body_db = -min(4.5, max(0, -abm_actuator_body_source_db - 1.5) * 1.50);
      abm_actuator_body_freq = 125;
      abm_actuator_body_q = 0.85;
    );

    adapt_bass_actuator_shelf_l.biquad_low_shelf_set(70, 1.0, adapt_bass_model_deep_target_db_cached);
    adapt_bass_actuator_shelf_r.a0 = adapt_bass_actuator_shelf_l.a0;
    adapt_bass_actuator_shelf_r.a1 = adapt_bass_actuator_shelf_l.a1;
    adapt_bass_actuator_shelf_r.a2 = adapt_bass_actuator_shelf_l.a2;
    adapt_bass_actuator_shelf_r.b1 = adapt_bass_actuator_shelf_l.b1;
    adapt_bass_actuator_shelf_r.b2 = adapt_bass_actuator_shelf_l.b2;

    adapt_bass_actuator_body_l.biquad_peak_set(abm_actuator_body_freq, abm_actuator_body_q, abm_actuator_body_db);
    adapt_bass_actuator_body_r.a0 = adapt_bass_actuator_body_l.a0;
    adapt_bass_actuator_body_r.a1 = adapt_bass_actuator_body_l.a1;
    adapt_bass_actuator_body_r.a2 = adapt_bass_actuator_body_l.a2;
    adapt_bass_actuator_body_r.b1 = adapt_bass_actuator_body_l.b1;
    adapt_bass_actuator_body_r.b2 = adapt_bass_actuator_body_l.b2;
  );

  abm_foundation_l = adapt_bass_actuator_shelf_l.biquad_run(abm_voiced_l);
  abm_foundation_r = adapt_bass_actuator_shelf_r.biquad_run(abm_voiced_r);
  foundation_bass_l = adapt_bass_actuator_body_l.biquad_run(abm_foundation_l);
  foundation_bass_r = adapt_bass_actuator_body_r.biquad_run(abm_foundation_r);

 ) : (

  foundation_bass_l = bass_boosted_l;
  foundation_bass_r = bass_boosted_r;

);

l = legacy_bass_l + (foundation_bass_l-legacy_bass_l)*stream_foundation_mix;
r = legacy_bass_r + (foundation_bass_r-legacy_bass_r)*stream_foundation_mix;

bass_clip > 0 ? (
  bc_low_l = bassclip_split_l.onepole_lp2(l, bass_clip_split_a);
  bc_low_r = bassclip_split_r.onepole_lp2(r, bass_clip_split_a);
  bc_high_l = l - bc_low_l;
  bc_high_r = r - bc_low_r;

  bc_drive_l = bassclip_hpf_l.onepole_hp(bc_low_l, bass_clip_subhp_a);
  bc_drive_r = bassclip_hpf_r.onepole_hp(bc_low_r, bass_clip_subhp_a);
  bc_sub_l = bc_low_l - bc_drive_l;
  bc_sub_r = bc_low_r - bc_drive_r;

  bc_clip_l = bassclip_pre_l.bass_clip_active(bc_drive_l, bass_clip_pre_th, bass_clip_pre_amt, 0.42, bass_clip_pre_drive, 0.22, bass_clip_pre_res_a);
  bc_clip_r = bassclip_pre_r.bass_clip_active(bc_drive_r, bass_clip_pre_th, bass_clip_pre_amt, 0.42, bass_clip_pre_drive, 0.22, bass_clip_pre_res_a);

  l = bc_high_l + bc_sub_l + bc_clip_l * bass_clip_makeup;
  r = bc_high_r + bc_sub_r + bc_clip_r * bass_clip_makeup;
);

bass_section_proc_l = l;
bass_section_proc_r = r;
bass_section_mode == 1 ? (
  diag_l = bass_section_proc_l;
  diag_r = bass_section_proc_r;
  diag_active = 1;
) : bass_section_mode == 2 ? (
  diag_l = bass_section_proc_l - bass_section_in_l;
  diag_r = bass_section_proc_r - bass_section_in_r;
  diag_active = 1;
) : bass_section_mode == 3 ? (
  l = bass_section_in_l;
  r = bass_section_in_r;
);

xt2_section_in_l = l;
xt2_section_in_r = r;

l *= density_audio_gain;
r *= density_audio_gain;

crossover_model == 3 ? (

  lp1_l = lr4b1b_l.biquad_run(lr4b1a_l.biquad_run(l));
  lp2_l = lr4b2b_l.biquad_run(lr4b2a_l.biquad_run(l));
  lp3_l = lr4b3b_l.biquad_run(lr4b3a_l.biquad_run(l));
  lp4_l = lr4b4b_l.biquad_run(lr4b4a_l.biquad_run(l));
  lp5_l = lr4b5b_l.biquad_run(lr4b5a_l.biquad_run(l));
  b1_l = lp1_l;
  b2_l = lp2_l - lp1_l;
  b3_l = lp3_l - lp2_l;
  b4_l = lp4_l - lp3_l;
  b5_l = lp5_l - lp4_l;
  b6_l = l - lp5_l;

  lp1_r = lr4b1b_r.biquad_run(lr4b1a_r.biquad_run(r));
  lp2_r = lr4b2b_r.biquad_run(lr4b2a_r.biquad_run(r));
  lp3_r = lr4b3b_r.biquad_run(lr4b3a_r.biquad_run(r));
  lp4_r = lr4b4b_r.biquad_run(lr4b4a_r.biquad_run(r));
  lp5_r = lr4b5b_r.biquad_run(lr4b5a_r.biquad_run(r));
  b1_r = lp1_r;
  b2_r = lp2_r - lp1_r;
  b3_r = lp3_r - lp2_r;
  b4_r = lp4_r - lp3_r;
  b5_r = lp5_r - lp4_r;
  b6_r = r - lp5_r;
) : crossover_model == 2 ? (
  lp1_l = xb1_l.onepole_lp2(l, x1_a);
  lp2_l = xb2_l.onepole_lp2(l, x2_a);
  lp3_l = xb3_l.onepole_lp2(l, x3_a);
  lp4_l = xb4_l.onepole_lp2(l, x4_a);
  lp5_l = xb5_l.onepole_lp2(l, x5_a);
  b1_l = lp1_l;
  b2_l = lp2_l - lp1_l;
  b3_l = lp3_l - lp2_l;
  b4_l = lp4_l - lp3_l;
  b5_l = lp5_l - lp4_l;
  b6_l = l - lp5_l;

  lp1_r = xb1_r.onepole_lp2(r, x1_a);
  lp2_r = xb2_r.onepole_lp2(r, x2_a);
  lp3_r = xb3_r.onepole_lp2(r, x3_a);
  lp4_r = xb4_r.onepole_lp2(r, x4_a);
  lp5_r = xb5_r.onepole_lp2(r, x5_a);
  b1_r = lp1_r;
  b2_r = lp2_r - lp1_r;
  b3_r = lp3_r - lp2_r;
  b4_r = lp4_r - lp3_r;
  b5_r = lp5_r - lp4_r;
  b6_r = r - lp5_r;
) : crossover_model == 1 ? (

  b1_l = xb1_l.onepole_lp2(l, x1_a);
  rem_l = l - b1_l;
  b2_l = xb2_l.onepole_lp2(rem_l, x2_a);
  rem_l -= b2_l;
  b3_l = xb3_l.onepole_lp2(rem_l, x3_a);
  rem_l -= b3_l;
  b4_l = xb4_l.onepole_lp2(rem_l, x4_a);
  rem_l -= b4_l;
  b5_l = xb5_l.onepole_lp2(rem_l, x5_a);
  b6_l = rem_l - b5_l;

  b1_r = xb1_r.onepole_lp2(r, x1_a);
  rem_r = r - b1_r;
  b2_r = xb2_r.onepole_lp2(rem_r, x2_a);
  rem_r -= b2_r;
  b3_r = xb3_r.onepole_lp2(rem_r, x3_a);
  rem_r -= b3_r;
  b4_r = xb4_r.onepole_lp2(rem_r, x4_a);
  rem_r -= b4_r;
  b5_r = xb5_r.onepole_lp2(rem_r, x5_a);
  b6_r = rem_r - b5_r;
) : (
  b1_l = xb1_l.onepole_lp(l, x1_a);
  rem_l = l - b1_l;
  b2_l = xb2_l.onepole_lp(rem_l, x2_a);
  rem_l -= b2_l;
  b3_l = xb3_l.onepole_lp(rem_l, x3_a);
  rem_l -= b3_l;
  b4_l = xb4_l.onepole_lp(rem_l, x4_a);
  rem_l -= b4_l;
  b5_l = xb5_l.onepole_lp(rem_l, x5_a);
  b6_l = rem_l - b5_l;

  b1_r = xb1_r.onepole_lp(r, x1_a);
  rem_r = r - b1_r;
  b2_r = xb2_r.onepole_lp(rem_r, x2_a);
  rem_r -= b2_r;
  b3_r = xb3_r.onepole_lp(rem_r, x3_a);
  rem_r -= b3_r;
  b4_r = xb4_r.onepole_lp(rem_r, x4_a);
  rem_r -= b4_r;
  b5_r = xb5_r.onepole_lp(rem_r, x5_a);
  b6_r = rem_r - b5_r;
);

adaptive_top_coupling > 0 ? (
  at_b4_det = absmax2(b4_l, b4_r);
  at_b5_det = absmax2(b5_l, b5_r);
  at_b6_det = absmax2(b6_l, b6_r);

  at_air_l = adapt_top_air_hp_l.onepole_hp(l, adapt_top_air_hp_a);
  at_air_r = adapt_top_air_hp_r.onepole_hp(r, adapt_top_air_hp_a);
  at_air_det = absmax2(at_air_l, at_air_r);

  at_edge_det = at_b4_det * 0.30 + at_b5_det * 0.85 + at_b6_det * 0.18;
  at_prog_det = max(absmax2(l, r), max(at_edge_det, at_air_det) * 1.08);

  at_edge_env = adapt_top_edge_env.peak_env(at_edge_det, adapt_top_det_attack, adapt_top_det_release);
  at_edge_prog_env = adapt_top_edge_prog_env.peak_env(at_prog_det, adapt_top_det_attack, adapt_top_det_release);
  at_edge_ratio = at_edge_env / max(at_edge_prog_env, 0.000001);

  at_air_env = adapt_top_air_env.peak_env(at_air_det, adapt_top_det_attack, adapt_top_det_release);
  at_air_prog_env = adapt_top_air_prog_env.peak_env(at_prog_det, adapt_top_det_attack, adapt_top_det_release);
  at_air_ratio = at_air_env / max(at_air_prog_env, 0.000001);

  at_edge_dull = clamp((adapt_top_edge_target_low - at_edge_ratio) * at_edge_dull_inv_denom, 0, 1);
  at_edge_bright = clamp((at_edge_ratio - adapt_top_edge_target_high) * at_edge_bright_inv_denom, 0, 1);
  at_presence_gain_target_db = adapt_top_presence_max_boost_db * at_edge_dull - adapt_top_presence_max_cut_db * at_edge_bright;

  at_air_dull = clamp((adapt_top_air_target_low - at_air_ratio) * at_air_dull_inv_denom, 0, 1);
  at_air_bright = clamp((at_air_ratio - adapt_top_air_target_high) * at_air_bright_inv_denom, 0, 1);
  at_air_gain_target_db = adapt_top_air_max_boost_db * at_air_dull - adapt_top_air_max_cut_db * at_air_bright;

  at_edge_guard = clamp((at_edge_ratio - 0.46) * 2.9411764705882353, 0, 1);
  at_air_positive_db = max(at_air_gain_target_db, 0);
  at_air_gain_target_db -= at_air_positive_db * (0.55 * at_edge_guard);

  at_presence_gain_target = db2lin(at_presence_gain_target_db);
  at_air_gain_target = db2lin(at_air_gain_target_db);

  adapt_top_presence_gain <= 0 ? adapt_top_presence_gain = 1;
  at_presence_gain_target < adapt_top_presence_gain ? (
    adapt_top_presence_gain = at_presence_gain_target + adapt_top_gain_down * (adapt_top_presence_gain - at_presence_gain_target);
  ) : (
    adapt_top_presence_gain = at_presence_gain_target + adapt_top_gain_up * (adapt_top_presence_gain - at_presence_gain_target);
  );

  adapt_top_air_gain <= 0 ? adapt_top_air_gain = 1;
  at_air_gain_target < adapt_top_air_gain ? (
    adapt_top_air_gain = at_air_gain_target + adapt_top_gain_down * (adapt_top_air_gain - at_air_gain_target);
  ) : (
    adapt_top_air_gain = at_air_gain_target + adapt_top_gain_up * (adapt_top_air_gain - at_air_gain_target);
  );

  top_presence_adapt_gain = adapt_top_presence_gain;
  top_air_adapt_gain = adapt_top_air_gain;
) : (
  adapt_top_presence_gain = 1;
  adapt_top_air_gain = 1;
  top_presence_adapt_gain = 1;
  top_air_adapt_gain = 1;
);

b4_l *= presence_gain * top_presence_adapt_gain; b4_r *= presence_gain * top_presence_adapt_gain;
b5_l *= presence_gain * top_presence_adapt_gain; b5_r *= presence_gain * top_presence_adapt_gain;
b6_l *= brilliance_gain * top_air_adapt_gain; b6_r *= brilliance_gain * top_air_adapt_gain;

mb_src1_l = b1_l; mb_src1_r = b1_r;
mb_src2_l = b2_l; mb_src2_r = b2_r;
mb_src3_l = b3_l; mb_src3_r = b3_r;
mb_src4_l = b4_l; mb_src4_r = b4_r;
mb_src5_l = b5_l; mb_src5_r = b5_r;
mb_src6_l = b6_l; mb_src6_r = b6_r;

shape_recovery_amt = mb_shape;
sc_pre_b1 = absmax2(mb_src1_l, mb_src1_r) + 0.0000001;
sc_pre_b2 = absmax2(mb_src2_l, mb_src2_r) + 0.0000001;
sc_pre_b3 = absmax2(mb_src3_l, mb_src3_r) + 0.0000001;
sc_recovery_permission = shape_recovery_amt;

b1_det = absmax2(mb_src1_l, mb_src1_r) * density_detector_gain * b1_det_db2lin;
b2_det = absmax2(mb_src2_l, mb_src2_r) * density_detector_gain * b2_det_db2lin;

gate_xt2_strength = gate_effective * 0.78;
low_band_release_gated = low_band_release * (1 - gate_xt2_strength) + gate_xt2_freeze_release * gate_xt2_strength;
low_band_release_slow_gated = low_band_release_slow * (1 - gate_xt2_strength) + gate_xt2_freeze_release * gate_xt2_strength;
band_release_gated = band_release * (1 - gate_xt2_strength) + gate_xt2_freeze_release * gate_xt2_strength;
band_release_slow_gated = band_release_slow * (1 - gate_xt2_strength) + gate_xt2_freeze_release * gate_xt2_strength;
low_band_release_gated = low_band_release_gated * (1 - gate_reopen_rel_mix) + gate_reopen_release * gate_reopen_rel_mix;
low_band_release_slow_gated = low_band_release_slow_gated * (1 - gate_reopen_rel_mix) + gate_reopen_release * gate_reopen_rel_mix;
band_release_gated = band_release_gated * (1 - gate_reopen_rel_mix) + gate_reopen_release * gate_reopen_rel_mix;
band_release_slow_gated = band_release_slow_gated * (1 - gate_reopen_rel_mix) + gate_reopen_release * gate_reopen_rel_mix;

comp_g1_raw = lim1.band_limit_gain_pd(b1_det, b1_thresh, band_attack, low_band_release_gated, low_band_release_slow_gated, pd_release);
comp_g2_raw = lim2.band_limit_gain_pd(b2_det, b2_thresh, band_attack, low_band_release_gated, low_band_release_slow_gated, pd_release);

b3_det = absmax2(mb_src3_l, mb_src3_r) * density_detector_gain;
b4_det = absmax2(mb_src4_l, mb_src4_r) * density_detector_gain;
b5_det = absmax2(mb_src5_l, mb_src5_r) * density_detector_gain;
b6_det = absmax2(mb_src6_l, mb_src6_r) * density_detector_gain;
comp_g3_raw = lim3.band_limit_gain_pd_soft(b3_det, b3_thresh, upper_mid_band_attack, band_release_gated, band_release_slow_gated, pd_release, 4.2, 0.30, 0.14);
comp_g4_raw = lim4.band_limit_gain_pd_soft(b4_det, b4_thresh, upper_band_attack, band_release_gated, band_release_slow_gated, pd_release, 3.1, 0.42, 0.16);
comp_g5_raw = lim5.band_limit_gain_pd_soft(b5_det, b5_thresh, upper_band_attack, band_release_gated, band_release_slow_gated, pd_release, 2.6, 0.55, 0.18);
comp_g6_raw = lim6.band_limit_gain_pd_soft(b6_det, b6_thresh, upper_band_attack, band_release_gated, band_release_slow_gated, pd_release, 2.4, 0.65, 0.20);

comp_g1 = 1 - xt2_mix * (1 - comp_g1_raw);
comp_g2 = 1 - xt2_mix * (1 - comp_g2_raw);
comp_g3 = 1 - xt2_mix * (1 - comp_g3_raw);
comp_g4 = 1 - xt2_mix * (1 - comp_g4_raw);
comp_g5 = 1 - xt2_mix * (1 - comp_g5_raw);
comp_g6 = 1 - xt2_mix * (1 - comp_g6_raw);

comp_low_shared_gain = sqrt(max(comp_g1 * comp_g2, 0.000001));
comp_g1 = comp_g1 * (1 - low_coherence) + comp_low_shared_gain * low_coherence;
comp_g2 = comp_g2 * (1 - low_coherence) + comp_low_shared_gain * low_coherence;
comp_g6 = comp_g5;

comp_b1_l = mb_src1_l; comp_b1_r = mb_src1_r;
comp_b2_l = mb_src2_l; comp_b2_r = mb_src2_r;
comp_b3_l = mb_src3_l; comp_b3_r = mb_src3_r;
comp_b4_l = mb_src4_l; comp_b4_r = mb_src4_r;
comp_b5_l = mb_src5_l; comp_b5_r = mb_src5_r;
comp_b6_l = mb_src6_l; comp_b6_r = mb_src6_r;

mb_clip_mix_work = clamp(mb_clip_mix, 0, 1);
mb_clip_mix_work > 0 ? (
  meter_mb_pre3 = absmax2(comp_b3_l, comp_b3_r);
  meter_mb_pre4 = absmax2(comp_b4_l, comp_b4_r);
  meter_mb_pre5 = absmax2(comp_b5_l, comp_b5_r);
  meter_mb_pre6 = absmax2(comp_b6_l, comp_b6_r);

  dc3_amt = dc_cancel * 0.35;
  dc4_amt = dc_cancel * 0.55;
  dc5_amt = dc_cancel * 0.78;
  dc6_amt = dc_cancel * 0.92;

  comp_b3_l = mb_clip3_l.mb_soft_clip_dc(comp_b3_l, mb_work_ref * 0.56, mb_clip_mix_work * 0.55, 0.42, dc3_amt, dist_cancel_a);
  comp_b3_r = mb_clip3_r.mb_soft_clip_dc(comp_b3_r, mb_work_ref * 0.56, mb_clip_mix_work * 0.55, 0.42, dc3_amt, dist_cancel_a);
  comp_b4_l = mb_clip4_l.mb_soft_clip_dc(comp_b4_l, mb_work_ref * 0.48, mb_clip_mix_work * 0.75, 0.36, dc4_amt, dist_cancel_a);
  comp_b4_r = mb_clip4_r.mb_soft_clip_dc(comp_b4_r, mb_work_ref * 0.48, mb_clip_mix_work * 0.75, 0.36, dc4_amt, dist_cancel_a);
  comp_b5_l = mb_clip5_l.mb_soft_clip_dc(comp_b5_l, mb_work_ref * 0.40, mb_clip_mix_work, 0.30, dc5_amt, dist_cancel_a);
  comp_b5_r = mb_clip5_r.mb_soft_clip_dc(comp_b5_r, mb_work_ref * 0.40, mb_clip_mix_work, 0.30, dc5_amt, dist_cancel_a);
  comp_b6_l = mb_clip6_l.mb_soft_clip_dc(comp_b6_l, mb_work_ref * 0.32, mb_clip_mix_work, 0.24, dc6_amt, dist_cancel_a);
  comp_b6_r = mb_clip6_r.mb_soft_clip_dc(comp_b6_r, mb_work_ref * 0.32, mb_clip_mix_work, 0.24, dc6_amt, dist_cancel_a);

  meter_mb_post3 = absmax2(comp_b3_l, comp_b3_r);
  meter_mb_post4 = absmax2(comp_b4_l, comp_b4_r);
  meter_mb_post5 = absmax2(comp_b5_l, comp_b5_r);
  meter_mb_post6 = absmax2(comp_b6_l, comp_b6_r);

  meter_blk_mb_pre3 = max(meter_blk_mb_pre3, meter_mb_pre3);
  meter_blk_mb_pre4 = max(meter_blk_mb_pre4, meter_mb_pre4);
  meter_blk_mb_pre5 = max(meter_blk_mb_pre5, meter_mb_pre5);
  meter_blk_mb_pre6 = max(meter_blk_mb_pre6, meter_mb_pre6);
  meter_blk_mb_post3 = max(meter_blk_mb_post3, meter_mb_post3);
  meter_blk_mb_post4 = max(meter_blk_mb_post4, meter_mb_post4);
  meter_blk_mb_post5 = max(meter_blk_mb_post5, meter_mb_post5);
  meter_blk_mb_post6 = max(meter_blk_mb_post6, meter_mb_post6);

  meter_heavy_tick ? (
    meter_mb_now_db = max(max(max(0, meter_to_db(meter_blk_mb_pre3) - meter_to_db(meter_blk_mb_post3)),
                              max(0, meter_to_db(meter_blk_mb_pre4) - meter_to_db(meter_blk_mb_post4))),
                          max(max(0, meter_to_db(meter_blk_mb_pre5) - meter_to_db(meter_blk_mb_post5)),
                              max(0, meter_to_db(meter_blk_mb_pre6) - meter_to_db(meter_blk_mb_post6))));
    meter_mb_clip_max_db = max(meter_mb_clip_max_db, meter_mb_now_db);
    meter_note_activity(1, meter_mb_now_db * mb_comp_keep);
    meter_blk_mb_pre3 = meter_blk_mb_pre4 = meter_blk_mb_pre5 = meter_blk_mb_pre6 = 0;
    meter_blk_mb_post3 = meter_blk_mb_post4 = meter_blk_mb_post5 = meter_blk_mb_post6 = 0;
  );
);

comp_p1_l = comp_b1_l * comp_g1; comp_p1_r = comp_b1_r * comp_g1;
comp_p2_l = comp_b2_l * comp_g2; comp_p2_r = comp_b2_r * comp_g2;
comp_p3_l = comp_b3_l * comp_g3; comp_p3_r = comp_b3_r * comp_g3;
comp_p4_l = comp_b4_l * comp_g4; comp_p4_r = comp_b4_r * comp_g4;
comp_p5_l = comp_b5_l * comp_g5; comp_p5_r = comp_b5_r * comp_g5;
comp_p6_l = comp_b6_l * comp_g6; comp_p6_r = comp_b6_r * comp_g6;

producer_density_active ? (
comp_post_b1 = absmax2(comp_p1_l, comp_p1_r) + 0.0000001;
comp_post_b2 = absmax2(comp_p2_l, comp_p2_r) + 0.0000001;
comp_post_b3 = absmax2(comp_p3_l, comp_p3_r) + 0.0000001;

shape_rec_comp_ratio1_blk = max(shape_rec_comp_ratio1_blk, sc_pre_b1 / comp_post_b1);
shape_rec_comp_ratio2_blk = max(shape_rec_comp_ratio2_blk, sc_pre_b2 / comp_post_b2);
shape_rec_comp_ratio3_blk = max(shape_rec_comp_ratio3_blk, sc_pre_b3 / comp_post_b3);

shape_rec_heavy_tick ? (
  comp_loss1_db = max(0, lin2db(shape_rec_comp_ratio1_blk) - 0.18);
  comp_loss2_db = max(0, lin2db(shape_rec_comp_ratio2_blk) - 0.18);
  comp_loss3_db = max(0, lin2db(shape_rec_comp_ratio3_blk) - 0.25);

  comp_rec1_target_db = min(comp_loss1_db * 0.55, 2.30) * sc_recovery_permission;
  comp_rec2_target_db = min(comp_loss2_db * 0.62, 2.45) * sc_recovery_permission;
  comp_rec3_target_db = min(comp_loss3_db * 0.18, 0.65) * sc_recovery_permission;

  comp_rec1_target_db < shape_comp_rec1_db ?
    shape_comp_rec1_db += shape_rec_release_blk * (comp_rec1_target_db - shape_comp_rec1_db) :
    shape_comp_rec1_db += shape_rec_attack_blk * (comp_rec1_target_db - shape_comp_rec1_db);
  comp_rec2_target_db < shape_comp_rec2_db ?
    shape_comp_rec2_db += shape_rec_release_blk * (comp_rec2_target_db - shape_comp_rec2_db) :
    shape_comp_rec2_db += shape_rec_attack_blk * (comp_rec2_target_db - shape_comp_rec2_db);
  comp_rec3_target_db < shape_comp_rec3_db ?
    shape_comp_rec3_db += shape_rec_release_blk * (comp_rec3_target_db - shape_comp_rec3_db) :
    shape_comp_rec3_db += shape_rec_attack_blk * (comp_rec3_target_db - shape_comp_rec3_db);

  comp_rec1_gain = db2lin(shape_comp_rec1_db);
  comp_rec2_gain = db2lin(shape_comp_rec2_db);
  comp_rec3_gain = db2lin(shape_comp_rec3_db);

  shape_rec_comp_ratio1_blk = shape_rec_comp_ratio2_blk = shape_rec_comp_ratio3_blk = 1;
);

comp_p1_l *= comp_rec1_gain; comp_p1_r *= comp_rec1_gain;
comp_p2_l *= comp_rec2_gain; comp_p2_r *= comp_rec2_gain;
comp_p3_l *= comp_rec3_gain; comp_p3_r *= comp_rec3_gain;

lim_b1_det = absmax2(mb_src1_l, mb_src1_r);
lim_b2_det = absmax2(mb_src2_l, mb_src2_r);
lim_b3_det = absmax2(mb_src3_l, mb_src3_r);
lim_b4_det = absmax2(mb_src4_l, mb_src4_r);
lim_b5_det = absmax2(mb_src5_l, mb_src5_r);
lim_b6_det = absmax2(mb_src6_l, mb_src6_r);

lim_quiet1 = lim_work1*(1-0.000000000001);
lim_quiet2 = lim_work2*(1-0.000000000001);
lim_quiet3 = lim_work3*(1-0.000000000001);
lim_quiet4 = lim_work4*(1-0.000000000001);
lim_quiet5 = lim_work5*(1-0.000000000001);
lim_quiet6 = lim_work6*(1-0.000000000001);

lim_g1_raw = mb_ev1.band_event_gain_auto(lim_b1_det, lim_work1_db, lim_quiet1, mb_event_attack, mb_event_release_fast, mb_event_release_slow);
lim_g2_raw = mb_ev2.band_event_gain_auto(lim_b2_det, lim_work2_db, lim_quiet2, mb_event_attack, mb_event_release_fast, mb_event_release_slow);
lim_g3_raw = mb_ev3.band_event_gain_auto(lim_b3_det, lim_work3_db, lim_quiet3, mb_event_attack, mb_event_release_fast, mb_event_release_slow);
lim_g4_raw = mb_ev4.band_event_gain_auto(lim_b4_det, lim_work4_db, lim_quiet4, mb_event_attack, mb_event_release_fast, mb_event_release_slow);
lim_g5_raw = mb_ev5.band_event_gain_auto(lim_b5_det, lim_work5_db, lim_quiet5, mb_event_attack, mb_event_release_fast, mb_event_release_slow);
lim_g6_raw = mb_ev6.band_event_gain_auto(lim_b6_det, lim_work6_db, lim_quiet6, mb_event_attack, mb_event_release_fast, mb_event_release_slow);

lim_g1 = lim_g1_raw;
lim_g2 = lim_g2_raw;
lim_g3 = lim_g3_raw;
lim_g4 = lim_g4_raw;
lim_g5 = lim_g5_raw;
lim_g6 = lim_g6_raw;

lim_p1_l = mb_src1_l * lim_g1; lim_p1_r = mb_src1_r * lim_g1;
lim_p2_l = mb_src2_l * lim_g2; lim_p2_r = mb_src2_r * lim_g2;
lim_p3_l = mb_src3_l * lim_g3; lim_p3_r = mb_src3_r * lim_g3;
lim_p4_l = mb_src4_l * lim_g4; lim_p4_r = mb_src4_r * lim_g4;
lim_p5_l = mb_src5_l * lim_g5; lim_p5_r = mb_src5_r * lim_g5;
lim_p6_l = mb_src6_l * lim_g6; lim_p6_r = mb_src6_r * lim_g6;

lim_p4_l *= mb_presence_post; lim_p4_r *= mb_presence_post;
lim_p5_l *= mb_presence_post; lim_p5_r *= mb_presence_post;
lim_p6_l *= mb_brilliance_post; lim_p6_r *= mb_brilliance_post;

lim_soft_amt = 0.35;
lim_soft_shape = 0.75;
lim_p1_l = lim_band_clip(lim_p1_l, lim_work1, lim_soft_amt, lim_soft_shape);
lim_p1_r = lim_band_clip(lim_p1_r, lim_work1, lim_soft_amt, lim_soft_shape);
lim_p2_l = lim_band_clip(lim_p2_l, lim_work2, lim_soft_amt, lim_soft_shape);
lim_p2_r = lim_band_clip(lim_p2_r, lim_work2, lim_soft_amt, lim_soft_shape);
lim_p3_l = lim_band_clip(lim_p3_l, lim_work3, lim_soft_amt, lim_soft_shape);
lim_p3_r = lim_band_clip(lim_p3_r, lim_work3, lim_soft_amt, lim_soft_shape);
lim_p4_l = lim_band_clip(lim_p4_l, lim_work4, lim_soft_amt, lim_soft_shape);
lim_p4_r = lim_band_clip(lim_p4_r, lim_work4, lim_soft_amt, lim_soft_shape);
lim_p5_l = lim_band_clip(lim_p5_l, lim_work5, lim_soft_amt, lim_soft_shape);
lim_p5_r = lim_band_clip(lim_p5_r, lim_work5, lim_soft_amt, lim_soft_shape);
lim_p6_l = lim_band_clip(lim_p6_l, lim_work6, lim_soft_amt, lim_soft_shape);
lim_p6_r = lim_band_clip(lim_p6_r, lim_work6, lim_soft_amt, lim_soft_shape);

lim_post_b1 = absmax2(lim_p1_l, lim_p1_r) + 0.0000001;
lim_post_b2 = absmax2(lim_p2_l, lim_p2_r) + 0.0000001;
lim_post_b3 = absmax2(lim_p3_l, lim_p3_r) + 0.0000001;

shape_rec_lim_ratio1_blk = max(shape_rec_lim_ratio1_blk, sc_pre_b1 / lim_post_b1);
shape_rec_lim_ratio2_blk = max(shape_rec_lim_ratio2_blk, sc_pre_b2 / lim_post_b2);
shape_rec_lim_ratio3_blk = max(shape_rec_lim_ratio3_blk, sc_pre_b3 / lim_post_b3);

shape_rec_heavy_tick ? (
  lim_loss1_db = max(0, lin2db(shape_rec_lim_ratio1_blk) - 0.18);
  lim_loss2_db = max(0, lin2db(shape_rec_lim_ratio2_blk) - 0.18);
  lim_loss3_db = max(0, lin2db(shape_rec_lim_ratio3_blk) - 0.25);

  lim_rec1_target_db = min(lim_loss1_db * 0.62, 2.60) * sc_recovery_permission;
  lim_rec2_target_db = min(lim_loss2_db * 0.70, 2.75) * sc_recovery_permission;
  lim_rec3_target_db = min(lim_loss3_db * 0.20, 0.75) * sc_recovery_permission;

  lim_rec1_target_db < shape_lim_rec1_db ?
    shape_lim_rec1_db += shape_rec_release_blk * (lim_rec1_target_db - shape_lim_rec1_db) :
    shape_lim_rec1_db += shape_rec_attack_blk * (lim_rec1_target_db - shape_lim_rec1_db);
  lim_rec2_target_db < shape_lim_rec2_db ?
    shape_lim_rec2_db += shape_rec_release_blk * (lim_rec2_target_db - shape_lim_rec2_db) :
    shape_lim_rec2_db += shape_rec_attack_blk * (lim_rec2_target_db - shape_lim_rec2_db);
  lim_rec3_target_db < shape_lim_rec3_db ?
    shape_lim_rec3_db += shape_rec_release_blk * (lim_rec3_target_db - shape_lim_rec3_db) :
    shape_lim_rec3_db += shape_rec_attack_blk * (lim_rec3_target_db - shape_lim_rec3_db);

  lim_rec1_gain = db2lin(shape_lim_rec1_db);
  lim_rec2_gain = db2lin(shape_lim_rec2_db);
  lim_rec3_gain = db2lin(shape_lim_rec3_db);

  shape_rec_lim_ratio1_blk = shape_rec_lim_ratio2_blk = shape_rec_lim_ratio3_blk = 1;
);

lim_p1_l *= lim_rec1_gain; lim_p1_r *= lim_rec1_gain;
lim_p2_l *= lim_rec2_gain; lim_p2_r *= lim_rec2_gain;
lim_p3_l *= lim_rec3_gain; lim_p3_r *= lim_rec3_gain;

comp_p1_l *= mb_comp_fork_cal_gain; comp_p1_r *= mb_comp_fork_cal_gain;
comp_p2_l *= mb_comp_fork_cal_gain; comp_p2_r *= mb_comp_fork_cal_gain;
comp_p3_l *= mb_comp_fork_cal_gain; comp_p3_r *= mb_comp_fork_cal_gain;
comp_p4_l *= mb_comp_fork_cal_gain; comp_p4_r *= mb_comp_fork_cal_gain;
comp_p5_l *= mb_comp_fork_cal_gain; comp_p5_r *= mb_comp_fork_cal_gain;
comp_p6_l *= mb_comp_fork_cal_gain; comp_p6_r *= mb_comp_fork_cal_gain;
lim_p1_l *= mb_limiter_fork_cal_gain; lim_p1_r *= mb_limiter_fork_cal_gain;
lim_p2_l *= mb_limiter_fork_cal_gain; lim_p2_r *= mb_limiter_fork_cal_gain;
lim_p3_l *= mb_limiter_fork_cal_gain; lim_p3_r *= mb_limiter_fork_cal_gain;
lim_p4_l *= mb_limiter_fork_cal_gain; lim_p4_r *= mb_limiter_fork_cal_gain;
lim_p5_l *= mb_limiter_fork_cal_gain; lim_p5_r *= mb_limiter_fork_cal_gain;
lim_p6_l *= mb_limiter_fork_cal_gain; lim_p6_r *= mb_limiter_fork_cal_gain;

p1_l = comp_p1_l * mb_comp_keep + lim_p1_l * mb_comp_limiter; p1_r = comp_p1_r * mb_comp_keep + lim_p1_r * mb_comp_limiter;
p2_l = comp_p2_l * mb_comp_keep + lim_p2_l * mb_comp_limiter; p2_r = comp_p2_r * mb_comp_keep + lim_p2_r * mb_comp_limiter;
p3_l = comp_p3_l * mb_comp_keep + lim_p3_l * mb_comp_limiter; p3_r = comp_p3_r * mb_comp_keep + lim_p3_r * mb_comp_limiter;
p4_l = comp_p4_l * mb_comp_keep + lim_p4_l * mb_comp_limiter; p4_r = comp_p4_r * mb_comp_keep + lim_p4_r * mb_comp_limiter;
p5_l = comp_p5_l * mb_comp_keep + lim_p5_l * mb_comp_limiter; p5_r = comp_p5_r * mb_comp_keep + lim_p5_r * mb_comp_limiter;
p6_l = comp_p6_l * mb_comp_keep + lim_p6_l * mb_comp_limiter; p6_r = comp_p6_r * mb_comp_keep + lim_p6_r * mb_comp_limiter;

shape_servo_active ? (
  shape_power_accum1 += (p1_l*p1_l + p1_r*p1_r) * 0.5;
  shape_power_accum2 += (p2_l*p2_l + p2_r*p2_r) * 0.5;
  shape_power_accum3 += (p3_l*p3_l + p3_r*p3_r) * 0.5;
  shape_power_accum4 += (p4_l*p4_l + p4_r*p4_r) * 0.5;
  shape_power_accum5 += (p5_l*p5_l + p5_r*p5_r) * 0.5;
  shape_power_accum6 += (p6_l*p6_l + p6_r*p6_r) * 0.5;
  shape_block_counter += 1;

  shape_block_counter >= 32 ? (
    shape_block_counter = 0;

    shape_lvl1 += shape_servo_lvl_a_blk * ((shape_power_accum1 * 0.03125) - shape_lvl1);
    shape_lvl2 += shape_servo_lvl_a_blk * ((shape_power_accum2 * 0.03125) - shape_lvl2);
    shape_lvl3 += shape_servo_lvl_a_blk * ((shape_power_accum3 * 0.03125) - shape_lvl3);
    shape_lvl4 += shape_servo_lvl_a_blk * ((shape_power_accum4 * 0.03125) - shape_lvl4);
    shape_lvl5 += shape_servo_lvl_a_blk * ((shape_power_accum5 * 0.03125) - shape_lvl5);
    shape_lvl6 += shape_servo_lvl_a_blk * ((shape_power_accum6 * 0.03125) - shape_lvl6);

    shape_power_accum1 = shape_power_accum2 = shape_power_accum3 = 0;
    shape_power_accum4 = shape_power_accum5 = shape_power_accum6 = 0;

    shape_ref_lvl = sqrt(max((shape_lvl3 + shape_lvl4) * 0.5, 0.000000000001));
    shape_l1_lvl = sqrt(max(shape_lvl1, 0.000000000001));
    shape_l2_lvl = sqrt(max(shape_lvl2, 0.000000000001));
    shape_l3_lvl = sqrt(max(shape_lvl3, 0.000000000001));
    shape_l4_lvl = sqrt(max(shape_lvl4, 0.000000000001));
    shape_l5_lvl = sqrt(max(shape_lvl5, 0.000000000001));
    shape_l6_lvl = sqrt(max(shape_lvl6, 0.000000000001));

    shape_ratio1_db = lin2db(shape_l1_lvl / shape_ref_lvl);
    shape_ratio2_db = lin2db(shape_l2_lvl / shape_ref_lvl);
    shape_ratio3_db = lin2db(shape_l3_lvl / shape_ref_lvl);
    shape_ratio4_db = lin2db(shape_l4_lvl / shape_ref_lvl);
    shape_ratio5_db = lin2db(shape_l5_lvl / shape_ref_lvl);
    shape_ratio6_db = lin2db(shape_l6_lvl / shape_ref_lvl);

    shape_presence_bias_db = clamp(presence_db, -6, 6);
    shape_brilliance_bias_db = clamp(brilliance_db, -6, 6);
    shape_tgt1_db = -1.8;
    shape_tgt2_db = -0.7;
    shape_tgt3_db = -0.3;
    shape_tgt4_db = 0.0;
    shape_tgt5_db = -2.2 + shape_presence_bias_db * 0.24;
    shape_tgt6_db = -4.6 + shape_brilliance_bias_db * 0.26;

    shape_servo1_tgt_db = (clamp((shape_tgt1_db - shape_ratio1_db) * 0.34, -1.75, 2.40) + 2.5) * mb_shape;
    shape_servo2_tgt_db = (clamp((shape_tgt2_db - shape_ratio2_db) * 0.36, -1.65, 2.55) + 0.9) * mb_shape;
    shape_servo3_tgt_db = clamp((shape_tgt3_db - shape_ratio3_db) * 0.16, -0.60, 0.55) * mb_shape;
    shape_servo4_tgt_db = clamp((shape_tgt4_db - shape_ratio4_db) * 0.10, -0.40, 0.40) * mb_shape;
    shape_servo5_tgt_db = clamp((shape_tgt5_db - shape_ratio5_db) * 0.18, -1.10, 1.15) * shape_hi_amt;
    shape_servo6_tgt_db = clamp((shape_tgt6_db - shape_ratio6_db) * 0.18, -1.35, 1.35) * shape_hi_amt;

    shape_servo1_db += shape_servo_gain_a_blk * (shape_servo1_tgt_db - shape_servo1_db);
    shape_servo2_db += shape_servo_gain_a_blk * (shape_servo2_tgt_db - shape_servo2_db);
    shape_servo3_db += shape_servo_gain_a_blk * (shape_servo3_tgt_db - shape_servo3_db);
    shape_servo4_db += shape_servo_gain_a_blk * (shape_servo4_tgt_db - shape_servo4_db);
    shape_servo5_db += shape_servo_gain_a_blk * (shape_servo5_tgt_db - shape_servo5_db);
    shape_servo6_db += shape_servo_gain_a_blk * (shape_servo6_tgt_db - shape_servo6_db);

    shape_servo_gain1 = db2lin(shape_servo1_db);
    shape_servo_gain2 = db2lin(shape_servo2_db);
    shape_servo_gain3 = db2lin(shape_servo3_db);
    shape_servo_gain4 = db2lin(shape_servo4_db);
    shape_servo_gain5 = db2lin(shape_servo5_db);
    shape_servo_gain6 = db2lin(shape_servo6_db);
  );

  p1_l *= shape_servo_gain1; p1_r *= shape_servo_gain1;
  p2_l *= shape_servo_gain2; p2_r *= shape_servo_gain2;
  p3_l *= shape_servo_gain3; p3_r *= shape_servo_gain3;
  p4_l *= shape_servo_gain4; p4_r *= shape_servo_gain4;
  p5_l *= shape_servo_gain5; p5_r *= shape_servo_gain5;
  p6_l *= shape_servo_gain6; p6_r *= shape_servo_gain6;
);

p4_l *= presence_edge_recovery_gain; p4_r *= presence_edge_recovery_gain;
p5_l *= presence_body_recovery_gain; p5_r *= presence_body_recovery_gain;
p6_l *= brilliance_recovery_gain; p6_r *= brilliance_recovery_gain;
) : (
p1_l = comp_p1_l; p1_r = comp_p1_r;
p2_l = comp_p2_l; p2_r = comp_p2_r;
p3_l = comp_p3_l; p3_r = comp_p3_r;
p4_l = comp_p4_l; p4_r = comp_p4_r;
p5_l = comp_p5_l; p5_r = comp_p5_r;
p6_l = comp_p6_l; p6_r = comp_p6_r;
);

density_protection_drive_gain != 1 ? (
  p1_l *= density_protection_drive_gain; p1_r *= density_protection_drive_gain;
  p2_l *= density_protection_drive_gain; p2_r *= density_protection_drive_gain;
  p3_l *= density_protection_drive_gain; p3_r *= density_protection_drive_gain;
  p4_l *= density_protection_drive_gain; p4_r *= density_protection_drive_gain;
  p5_l *= density_protection_drive_gain; p5_r *= density_protection_drive_gain;
  p6_l *= density_protection_drive_gain; p6_r *= density_protection_drive_gain;
);

blend_g1 = comp_g1 * mb_comp_keep + lim_g1 * mb_comp_limiter;
blend_g2 = comp_g2 * mb_comp_keep + lim_g2 * mb_comp_limiter;
blend_g3 = comp_g3 * mb_comp_keep + lim_g3 * mb_comp_limiter;
blend_g4 = comp_g4 * mb_comp_keep + lim_g4 * mb_comp_limiter;
blend_g5 = comp_g5 * mb_comp_keep + lim_g5 * mb_comp_limiter;
blend_g6 = comp_g6 * mb_comp_keep + lim_g6 * mb_comp_limiter;
meter_blk_gr_min1 = min(meter_blk_gr_min1, max(blend_g1, 0.000001));
meter_blk_gr_min2 = min(meter_blk_gr_min2, max(blend_g2, 0.000001));
meter_blk_gr_min3 = min(meter_blk_gr_min3, max(blend_g3, 0.000001));
meter_blk_gr_min4 = min(meter_blk_gr_min4, max(blend_g4, 0.000001));
meter_blk_gr_min5 = min(meter_blk_gr_min5, max(blend_g5, 0.000001));
meter_blk_gr_min6 = min(meter_blk_gr_min6, max(blend_g6, 0.000001));
meter_heavy_tick ? (
  meter_gain_reduction1_now = max(0, -lin2db(meter_blk_gr_min1));
  meter_gain_reduction2_now = max(0, -lin2db(meter_blk_gr_min2));
  meter_gain_reduction3_now = max(0, -lin2db(meter_blk_gr_min3));
  meter_gain_reduction4_now = max(0, -lin2db(meter_blk_gr_min4));
  meter_gain_reduction5_now = max(0, -lin2db(meter_blk_gr_min5));
  meter_gain_reduction6_now = max(0, -lin2db(meter_blk_gr_min6));
  meter_gain_reduction1_max = max(meter_gain_reduction1_max, meter_gain_reduction1_now);
  meter_gain_reduction2_max = max(meter_gain_reduction2_max, meter_gain_reduction2_now);
  meter_gain_reduction3_max = max(meter_gain_reduction3_max, meter_gain_reduction3_now);
  meter_gain_reduction4_max = max(meter_gain_reduction4_max, meter_gain_reduction4_now);
  meter_gain_reduction5_max = max(meter_gain_reduction5_max, meter_gain_reduction5_now);
  meter_gain_reduction6_max = max(meter_gain_reduction6_max, meter_gain_reduction6_now);
  meter_blk_gr_min1 = meter_blk_gr_min2 = meter_blk_gr_min3 = 1;
  meter_blk_gr_min4 = meter_blk_gr_min5 = meter_blk_gr_min6 = 1;
);

effective_snubber_lookahead > 0 ? (
  srdpos = snub_wrpos - effective_snubber_lookahead;
  srdpos < 0 ? srdpos += snub_buf_len;

  dp1_l = snub_p1_l[srdpos]; dp1_r = snub_p1_r[srdpos];
  dp2_l = snub_p2_l[srdpos]; dp2_r = snub_p2_r[srdpos];
  dp3_l = snub_p3_l[srdpos]; dp3_r = snub_p3_r[srdpos];
  dp4_l = snub_p4_l[srdpos]; dp4_r = snub_p4_r[srdpos];
  dp5_l = snub_p5_l[srdpos]; dp5_r = snub_p5_r[srdpos];
  dp6_l = snub_p6_l[srdpos]; dp6_r = snub_p6_r[srdpos];

  snub_p1_l[snub_wrpos] = p1_l; snub_p1_r[snub_wrpos] = p1_r;
  snub_p2_l[snub_wrpos] = p2_l; snub_p2_r[snub_wrpos] = p2_r;
  snub_p3_l[snub_wrpos] = p3_l; snub_p3_r[snub_wrpos] = p3_r;
  snub_p4_l[snub_wrpos] = p4_l; snub_p4_r[snub_wrpos] = p4_r;
  snub_p5_l[snub_wrpos] = p5_l; snub_p5_r[snub_wrpos] = p5_r;
  snub_p6_l[snub_wrpos] = p6_l; snub_p6_r[snub_wrpos] = p6_r;

  snub_wrpos += 1;
  snub_wrpos >= snub_buf_len ? snub_wrpos = 0;
) : (
  dp1_l = p1_l; dp1_r = p1_r;
  dp2_l = p2_l; dp2_r = p2_r;
  dp3_l = p3_l; dp3_r = p3_r;
  dp4_l = p4_l; dp4_r = p4_r;
  dp5_l = p5_l; dp5_r = p5_r;
  dp6_l = p6_l; dp6_r = p6_r;
);

upper_snubber > 0 ? (
  us_amt = upper_snubber;

  us_lvl4 = absmax2(p4_l, p4_r);
  us_lvl5 = absmax2(p5_l, p5_r);
  us_lvl6 = absmax2(p6_l, p6_r);

  us_fast4 = ub_fast4.onepole_lp(us_lvl4, upper_snub_fast_a);
  us_fast5 = ub_fast5.onepole_lp(us_lvl5, upper_snub_fast_a);
  us_fast6 = ub_fast6.onepole_lp(us_lvl6, upper_snub_fast_a);
  us_slow4 = ub_slow4.onepole_lp(us_lvl4, upper_snub_slow_a);
  us_slow5 = ub_slow5.onepole_lp(us_lvl5, upper_snub_slow_a);
  us_slow6 = ub_slow6.onepole_lp(us_lvl6, upper_snub_slow_a);

  us_onset4 = clamp((us_fast4 - us_slow4 * 1.22) / max(us_slow4 * 0.80 + 0.000001, 0.000001), 0, 1);
  us_onset5 = clamp((us_fast5 - us_slow5 * 1.18) / max(us_slow5 * 0.72 + 0.000001, 0.000001), 0, 1);
  us_onset6 = clamp((us_fast6 - us_slow6 * 1.15) / max(us_slow6 * 0.66 + 0.000001, 0.000001), 0, 1);

  us_spike4 = clamp((us_lvl4 - us_slow4 * 1.20) / max(us_slow4 * 1.20 + 0.000001, 0.000001), 0, 1);
  us_spike5 = clamp((us_lvl5 - us_slow5 * 1.16) / max(us_slow5 * 1.05 + 0.000001, 0.000001), 0, 1);
  us_spike6 = clamp((us_lvl6 - us_slow6 * 1.12) / max(us_slow6 * 0.95 + 0.000001, 0.000001), 0, 1);

  us_d4 = max(abs(p4_l - us_prev4_l), abs(p4_r - us_prev4_r));
  us_d5 = max(abs(p5_l - us_prev5_l), abs(p5_r - us_prev5_r));
  us_d6 = max(abs(p6_l - us_prev6_l), abs(p6_r - us_prev6_r));

  us_c4 = max(abs(p4_l - 2*us_prev4_l + us_prev24_l), abs(p4_r - 2*us_prev4_r + us_prev24_r));
  us_c5 = max(abs(p5_l - 2*us_prev5_l + us_prev25_l), abs(p5_r - 2*us_prev5_r + us_prev25_r));
  us_c6 = max(abs(p6_l - 2*us_prev6_l + us_prev26_l), abs(p6_r - 2*us_prev6_r + us_prev26_r));

  us_prev24_l = us_prev4_l; us_prev24_r = us_prev4_r;
  us_prev25_l = us_prev5_l; us_prev25_r = us_prev5_r;
  us_prev26_l = us_prev6_l; us_prev26_r = us_prev6_r;
  us_prev4_l = p4_l; us_prev4_r = p4_r;
  us_prev5_l = p5_l; us_prev5_r = p5_r;
  us_prev6_l = p6_l; us_prev6_r = p6_r;

  us_dslow4 = ub_dslow4.onepole_lp(us_d4, upper_snub_delta_a);
  us_dslow5 = ub_dslow5.onepole_lp(us_d5, upper_snub_delta_a);
  us_dslow6 = ub_dslow6.onepole_lp(us_d6, upper_snub_delta_a);
  us_cslow4 = ub_cslow4.onepole_lp(us_c4, upper_snub_curve_a);
  us_cslow5 = ub_cslow5.onepole_lp(us_c5, upper_snub_curve_a);
  us_cslow6 = ub_cslow6.onepole_lp(us_c6, upper_snub_curve_a);

  us_dgate4 = clamp((us_d4 - us_dslow4 * 1.75) / max(us_dslow4 * 2.60 + 0.000001, 0.000001), 0, 1);
  us_dgate5 = clamp((us_d5 - us_dslow5 * 1.70) / max(us_dslow5 * 2.35 + 0.000001, 0.000001), 0, 1);
  us_dgate6 = clamp((us_d6 - us_dslow6 * 1.65) / max(us_dslow6 * 2.20 + 0.000001, 0.000001), 0, 1);
  us_cgate4 = clamp((us_c4 - us_cslow4 * 1.85) / max(us_cslow4 * 2.75 + 0.000001, 0.000001), 0, 1);
  us_cgate5 = clamp((us_c5 - us_cslow5 * 1.78) / max(us_cslow5 * 2.45 + 0.000001, 0.000001), 0, 1);
  us_cgate6 = clamp((us_c6 - us_cslow6 * 1.72) / max(us_cslow6 * 2.30 + 0.000001, 0.000001), 0, 1);

  us_shape4 = max(us_dgate4, us_cgate4);
  us_shape5 = max(us_dgate5, us_cgate5);
  us_shape6 = max(us_dgate6, us_cgate6);

  us_ngate4 = clamp(us_onset4 * us_shape4 * (0.25 + 0.75 * us_spike4), 0, 1);
  us_ngate5 = clamp(us_onset5 * us_shape5 * (0.22 + 0.78 * us_spike5), 0, 1);

  us_ngate6 = clamp(us_onset6 * us_shape6 * (0.18 + 0.82 * us_spike6) * (0.20 + 0.80 * max(us_onset5, us_ngate5)), 0, 1);

  us_ngate4 = ub_gate4.peak_env(us_ngate4, upper_snub_gain_attack, upper_snub_gain_release);
  us_ngate5 = ub_gate5.peak_env(us_ngate5, upper_snub_gain_attack, upper_snub_gain_release);
  us_ngate6 = ub_gate6.peak_env(us_ngate6, upper_snub_gain_attack, upper_snub_gain_release);

  us_floor4 = ceiling * 0.105;
  us_floor5 = ceiling * 0.080;
  us_floor6 = ceiling * 0.060;

  us_cap4 = ceiling * (0.46 - 0.07 * us_amt);
  us_cap5 = ceiling * (0.36 - 0.075 * us_amt);
  us_cap6 = ceiling * (0.30 - 0.060 * us_amt);

  us_th4 = max(us_floor4, min(us_cap4, us_slow4 * (1.36 - 0.22 * us_amt)));
  us_th5 = max(us_floor5, min(us_cap5, us_slow5 * (1.26 - 0.24 * us_amt)));
  us_th6 = max(us_floor6, min(us_cap6, us_slow6 * (1.18 - 0.18 * us_amt)));

  us_mix4 = us_amt * us_ngate4 * 0.62;
  us_mix5 = us_amt * us_ngate5 * 0.92;
  us_mix6 = us_amt * us_ngate6 * 0.62;

  us_pre4 = absmax2(dp4_l, dp4_r);
  us_pre5 = absmax2(dp5_l, dp5_r);
  us_pre6 = absmax2(dp6_l, dp6_r);

  dp4_l = pure_peak_round(dp4_l, us_th4, us_mix4, 0.42 + 0.10 * us_amt);
  dp4_r = pure_peak_round(dp4_r, us_th4, us_mix4, 0.42 + 0.10 * us_amt);
  dp5_l = pure_peak_round(dp5_l, us_th5, us_mix5, 0.48 + 0.14 * us_amt);
  dp5_r = pure_peak_round(dp5_r, us_th5, us_mix5, 0.48 + 0.14 * us_amt);

  us_lim6 = ub_lim6.linked_limiter_gain(us_lvl6, us_th6, upper_snub_gain_attack, upper_snub_gain_release);
  us_tgain6 = 1 - us_mix6 * (1 - us_lim6);
  dp6_l *= us_tgain6;
  dp6_r *= us_tgain6;

  us_post4 = absmax2(dp4_l, dp4_r);
  us_post5 = absmax2(dp5_l, dp5_r);
  us_post6 = absmax2(dp6_l, dp6_r);
  meter_blk_us_pre4 = max(meter_blk_us_pre4, us_pre4);

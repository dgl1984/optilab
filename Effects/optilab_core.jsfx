preset_state_reset ? (
  reset_dynamic_state();
  preset_state_reset = 0;
);

meter_cpu_count += 1;
meter_cpu_count >= 64 ? (
  meter_heavy_tick = 1;
  meter_cpu_count = 0;
) : (
  meter_heavy_tick = 0;
);

shape_rec_count += 1;
shape_rec_count >= shape_rec_block_size ? (
  shape_rec_heavy_tick = 1;
  shape_rec_count = 0;
) : (
  shape_rec_heavy_tick = 0;
);

adaptive_cpu_count += 1;
adaptive_cpu_count >= 16 ? (
  adaptive_cpu_tick = 1;
  adaptive_cpu_count = 0;
) : (
  adaptive_cpu_tick = 0;
);

diag_active = 0;
diag_l = 0;
diag_r = 0;

spl0 = abs(spl0) < 1000000000000 ? spl0 : 0;
spl1 = abs(spl1) < 1000000000000 ? spl1 : 0;
input_section_in_l = spl0;
input_section_in_r = spl1;

input_section_mode === 3 ? (
  l = input_section_in_l;
  r = input_section_in_r;
) : (
  l_in = input_section_in_l * input_gain;
  r_in = input_section_in_r * input_gain;

  l=l_in;r=r_in;
  p006 ? (
    l=hp30_l.onepole_hp(l,hpf30_a);r=hp30_r.onepole_hp(r,hpf30_a);
    cp_i=0;loop(c29,
      cp_x=l;cp_extra_l[cp_i]+=hpf30_a*(cp_x-cp_extra_l[cp_i]);l=cp_x-cp_extra_l[cp_i];
      cp_x=r;cp_extra_r[cp_i]+=hpf30_a*(cp_x-cp_extra_r[cp_i]);r=cp_x-cp_extra_r[cp_i];
      cp_i+=1;
    );
  );
  cp_i=0;loop(core_phase_stages,
    cp_x=l;l=-cp_coeff[cp_i]*l+cp_xl[cp_i]+cp_coeff[cp_i]*cp_yl[cp_i];cp_xl[cp_i]=cp_x;cp_yl[cp_i]=l;
    cp_x=r;r=-cp_coeff[cp_i]*r+cp_xr[cp_i]+cp_coeff[cp_i]*cp_yr[cp_i];cp_xr[cp_i]=cp_x;cp_yr[cp_i]=r;
    cp_i+=1;
  );
);

input_section_proc_l = l;
input_section_proc_r = r;
input_section_mode === 1 ? (
  diag_l = input_section_proc_l;
  diag_r = input_section_proc_r;
  diag_active = 1;
) : input_section_mode === 2 ? (
  diag_l = input_section_proc_l - input_section_in_l;
  diag_r = input_section_proc_r - input_section_in_r;
  diag_active = 1;
);

agc_section_in_l = l;
agc_section_in_r = r;

startup_activity = max(absmax2(l, r), startup_activity * startup_activity_release);
agc_l = l * agc_drive;
agc_r = r * agc_drive;

c26 === 1 ? (
  low_l = agc_lp_l.onepole_lp2(agc_l, agc_split_a);
  low_r = agc_lp_r.onepole_lp2(agc_r, agc_split_a);
) : (

  low_l = agc_lp_l.onepole_lp(agc_l, agc_split_a);
  low_r = agc_lp_r.onepole_lp(agc_r, agc_split_a);
);
high_l = agc_l - low_l;
high_r = agc_r - low_r;

low_det = absmax2(low_l, low_r);
high_det = absmax2(high_l, high_r);
full_det = absmax2(agc_l, agc_r);

low_env = agc_low_env.peak_env(low_det, agc_env_attack, agc_release);
high_env = agc_high_env.peak_env(high_det, agc_env_attack, agc_release);

gate_prog_env = max(full_det, gate_prog_env * gate_detector_release);
gate_open_now = full_det >= gate_lin ? 1 : 0;
gate_target = gate_prog_env < gate_lin ? 1 : 0;
gate_prev_state = gate_state;
gate_closed_memory = max(gate_closed_memory * gate_reopen_decay, gate_state);
gate_open_now > 0 ? (
  gate_state = gate_state * gate_open_coeff;
) : (
  gate_target > gate_state ? (
    gate_state = gate_target + gate_close_coeff * (gate_state - gate_target);
  ) : (
    gate_state = gate_target + gate_open_coeff * (gate_state - gate_target);
  );
);
gate_state = clamp(gate_state, 0, 1);

gate_effective = gate_state * (1 - gate_open_now);

gate_reopen_pulse = gate_open_now * clamp(max(gate_prev_state, gate_closed_memory) * gate_reopen_pulse_scale, 0, 1);
gate_reopen_env = max(gate_reopen_env * gate_reopen_decay, gate_reopen_pulse);
gate_open_now > 0 ? gate_closed_memory *= gate_reopen_decay;

gate_reopen_env > 0 ? (

  gate_mem_clear_coeff = 1 - gate_reopen_env * (1 - gate_reopen_env_release);
  low_env = agc_low_env.peak_env_set(low_det + gate_mem_clear_coeff * (low_env - low_det));
  high_env = agc_high_env.peak_env_set(high_det + gate_mem_clear_coeff * (high_env - high_det));
);

low_tgain = clamp(agc_target / max(low_env, 0.000001), agc_min_gain, agc_max_gain);
high_tgain = clamp(agc_target / max(high_env, 0.000001), agc_min_gain, agc_max_gain);

low_tgain = low_tgain * (1 - bass_coupling) + high_tgain * bass_coupling;

gate_effective > 0 ? (
  gated_low_tgain = min(low_tgain, agc_lgain);
  gated_high_tgain = min(high_tgain, agc_hgain);
  low_tgain = low_tgain * (1 - gate_effective) + gated_low_tgain * gate_effective;
  high_tgain = high_tgain * (1 - gate_effective) + gated_high_tgain * gate_effective;
);

agc_low_depth = clamp((1 - agc_lgain) * 1.3333333333333333, 0, 1);
agc_high_depth = clamp((1 - agc_hgain) * 1.3333333333333333, 0, 1);

pd_agc = pd_release * 0.15;
agc_low_rel = agc_release * (1 - pd_agc * agc_low_depth) + agc_release_slow * (pd_agc * agc_low_depth);
agc_high_rel = agc_release * (1 - pd_agc * agc_high_depth) + agc_release_slow * (pd_agc * agc_high_depth);

agc_low_rel = agc_low_rel * (1 - gate_effective) + gate_agc_freeze_release * gate_effective;
agc_high_rel = agc_high_rel * (1 - gate_effective) + gate_agc_freeze_release * gate_effective;

gate_reopen_rel_mix = gate_reopen_env * (0.35 + 0.45 * gate_reopen_strength);
agc_gate_reopen_rel_mix = gate_reopen_env * (0.06 + 0.16 * gate_reopen_strength);
agc_low_rel = agc_low_rel * (1 - agc_gate_reopen_rel_mix) + gate_reopen_release * agc_gate_reopen_rel_mix;
agc_high_rel = agc_high_rel * (1 - agc_gate_reopen_rel_mix) + gate_reopen_release * agc_gate_reopen_rel_mix;

low_tgain < agc_lgain ? agc_lgain = low_tgain + agc_gain_attack * (agc_lgain - low_tgain) : agc_lgain = low_tgain + agc_low_rel * (agc_lgain - low_tgain);
high_tgain < agc_hgain ? agc_hgain = high_tgain + agc_gain_attack * (agc_hgain - high_tgain) : agc_hgain = high_tgain + agc_high_rel * (agc_hgain - high_tgain);

gate_agc_drift_amt = (1 - gate_agc_drift_coeff) * gate_effective;
agc_lgain += gate_agc_drift_amt * (gate_agc_drift_target - agc_lgain);
agc_hgain += gate_agc_drift_amt * (gate_agc_drift_target - agc_hgain);

agc_low_raw_l = low_l * inv_agc_drive_safe;
agc_low_raw_r = low_r * inv_agc_drive_safe;
agc_high_raw_l = high_l * inv_agc_drive_safe;
agc_high_raw_r = high_r * inv_agc_drive_safe;

agc_low_proc_gain = agc_drive * agc_lgain;
agc_high_proc_gain = agc_drive * agc_hgain;
agc_low_authority = agc_low_proc_gain < 1 ? agc_down_mix : agc_mix;
agc_high_authority = agc_high_proc_gain < 1 ? agc_down_mix : agc_mix;
agc_low_eff_gain = 1 + (agc_low_proc_gain - 1) * agc_low_authority;
agc_high_eff_gain = 1 + (agc_high_proc_gain - 1) * agc_high_authority;

agc_out_l = agc_low_raw_l * agc_low_eff_gain + agc_high_raw_l * agc_high_eff_gain;
agc_out_r = agc_low_raw_r * agc_low_eff_gain + agc_high_raw_r * agc_high_eff_gain;

l = agc_out_l;
r = agc_out_r;

agc_section_mode === 3 ? (
  l = agc_section_in_l;
  r = agc_section_in_r;
) : (

  post_agc_smooth_drive_amt > 0.0000001 ? (
    l = post_agc_round_l.smooth_drive_rounder(l, post_agc_smooth_drive_amt) * post_agc_smooth_recovery_gain;
    r = post_agc_round_r.smooth_drive_rounder(r, post_agc_smooth_drive_amt) * post_agc_smooth_recovery_gain;
  );
);

agc_section_proc_l = l;
agc_section_proc_r = r;
agc_section_mode === 1 ? (
  diag_l = agc_section_proc_l;
  diag_r = agc_section_proc_r;
  diag_active = 1;
) : agc_section_mode === 2 ? (
  diag_l = agc_section_proc_l - agc_section_in_l;
  diag_r = agc_section_proc_r - agc_section_in_r;
  diag_active = 1;
);

mastering_lookahead_samps > 0 ? (
  master_side_det = absmax2(l, r);
  master_raw_det = absmax2(input_section_in_l, input_section_in_r);
  master_amp_det = master_side_det;

  master_startup_active = max(master_side_det, master_raw_det) > master_startup_active_thresh;
  master_startup_armed > 0 ? (
    master_startup_active ? (
      master_startup_age < master_startup_prime_window ? (
        i = 0;
        loop(master_buf_len,
          master_buf_l[i] = l;
          master_buf_r[i] = r;
          i += 1;
        );
        master_wrpos = 0;
        master_raw_env.peak_env_set(max(master_raw_det, 0.000001));
        master_amp_env.peak_env_set(max(master_amp_det, 0.000001));
        master_catch_env.peak_env_set(max(master_side_det, 0.000001));
        master_catch_gain = 1;
      );
      master_startup_armed = 0;
    ) : (
      master_startup_age += 1;
      master_startup_age >= master_startup_prime_window ? master_startup_armed = 0;
    );
  );

  master_raw_level = master_raw_env.peak_env(master_raw_det, master_env_attack, master_env_release);
  master_amp_level = master_amp_env.peak_env(master_amp_det, master_env_attack, master_env_release);
  master_net_makeup_db = lin2db(master_amp_level / max(master_raw_level, 0.000001));
  master_allow = clamp((master_net_makeup_db - 3.0) * 0.11111111111111111, 0, 1);

  master_catch_thresh = const_db2lin_minus6_2;
  master_catch_det = master_catch_env.peak_env(master_side_det, master_catch_attack, master_catch_release);
  master_target_gain = master_catch_det > master_catch_thresh ? master_catch_thresh / max(master_catch_det, 0.000001) : 1;
  master_target_gain = clamp(master_target_gain, const_db2lin_minus3_6, 1);
  master_target_gain = 1 - master_allow * (1 - master_target_gain);
  master_target_gain < master_catch_gain ? (
    master_catch_gain = master_target_gain + master_catch_attack * (master_catch_gain - master_target_gain);
  ) : (
    master_catch_gain = master_target_gain + master_catch_release * (master_catch_gain - master_target_gain);
  );

  mrdpos = master_wrpos - mastering_lookahead_samps;
  mrdpos < 0 ? mrdpos += master_buf_len;
  md_l = master_buf_l[mrdpos];
  md_r = master_buf_r[mrdpos];
  master_buf_l[master_wrpos] = l;
  master_buf_r[master_wrpos] = r;
  master_wrpos += 1;
  master_wrpos >= master_buf_len ? master_wrpos = 0;

  l = md_l * master_catch_gain;
  r = md_r * master_catch_gain;
) : (
  master_catch_gain = 1;
  master_startup_armed = 1;
  master_startup_age = 0;
);

bass_section_in_l = l;
bass_section_in_r = r;
bass_pre_eq_l = l;
bass_pre_eq_r = r;
bass_boosted_l = bass_peak_l.biquad_run(l);
bass_boosted_r = bass_peak_r.biquad_run(r);

legacy_bass_l = bass_boosted_l;
legacy_bass_r = bass_boosted_r;
stream_foundation_mix < 0.9999999 && adaptive_bass_coupling > 0 ? (
  legacy_ab_low_l = legacy_adapt_bass_lp_l.onepole_lp2(bass_boosted_l, legacy_adapt_bass_split_a);
  legacy_ab_low_r = legacy_adapt_bass_lp_r.onepole_lp2(bass_boosted_r, legacy_adapt_bass_split_a);
  legacy_ab_high_l = bass_boosted_l - legacy_ab_low_l;
  legacy_ab_high_r = bass_boosted_r - legacy_ab_low_r;
  legacy_ab_bass_det = absmax2(legacy_ab_low_l, legacy_ab_low_r);
  legacy_ab_prog_det = max(absmax2(bass_boosted_l, bass_boosted_r), absmax2(legacy_ab_high_l, legacy_ab_high_r)*1.20);
  legacy_ab_bass_level = legacy_adapt_bass_env.peak_env(legacy_ab_bass_det, legacy_adapt_bass_det_attack, legacy_adapt_bass_det_release);
  legacy_ab_prog_level = legacy_adapt_prog_env.peak_env(legacy_ab_prog_det, legacy_adapt_bass_det_attack, legacy_adapt_bass_det_release);
  legacy_ab_ratio = legacy_ab_bass_level/max(legacy_ab_prog_level,0.000001);
  legacy_ab_thin = clamp((legacy_adapt_bass_target_low-legacy_ab_ratio)/max(legacy_adapt_bass_target_low-0.105,0.000001),0,1);
  legacy_ab_heavy = clamp((legacy_ab_ratio-legacy_adapt_bass_target_high)/max(0.82-legacy_adapt_bass_target_high,0.000001),0,1);
  legacy_ab_gain_target_db = legacy_adapt_bass_max_boost_db*legacy_ab_thin-legacy_adapt_bass_max_cut_db*legacy_ab_heavy;
  legacy_ab_gain_target = db2lin(legacy_ab_gain_target_db);
  legacy_adapt_bass_gain <= 0 ? legacy_adapt_bass_gain = 1;
  legacy_ab_gain_target < legacy_adapt_bass_gain ? (
    legacy_adapt_bass_gain = legacy_ab_gain_target + legacy_adapt_bass_gain_down*(legacy_adapt_bass_gain-legacy_ab_gain_target);
  ) : (
    legacy_adapt_bass_gain = legacy_ab_gain_target + legacy_adapt_bass_gain_up*(legacy_adapt_bass_gain-legacy_ab_gain_target);
  );
  legacy_bass_l = legacy_ab_high_l + legacy_ab_low_l*legacy_adapt_bass_gain;
  legacy_bass_r = legacy_ab_high_r + legacy_ab_low_r*legacy_adapt_bass_gain;
);

foundation_bass_l = bass_boosted_l;
foundation_bass_r = bass_boosted_r;
adaptive_bass_foundation_guard_active ? (
  abm_lp70_l = adapt_bass_model_70_l.biquad_run(bass_pre_eq_l);
  abm_lp70_r = adapt_bass_model_70_r.biquad_run(bass_pre_eq_r);
  abm_lp250_l = adapt_bass_model_250_l.biquad_run(bass_pre_eq_l);
  abm_lp250_r = adapt_bass_model_250_r.biquad_run(bass_pre_eq_r);
  abm_lp420_l = adapt_bass_model_420_l.biquad_run(bass_pre_eq_l);
  abm_lp420_r = adapt_bass_model_420_r.biquad_run(bass_pre_eq_r);
  abm_lp3700_l = adapt_bass_model_3700_l.biquad_run(bass_pre_eq_l);
  abm_lp3700_r = adapt_bass_model_3700_r.biquad_run(bass_pre_eq_r);

  abm_deep_l = abm_lp70_l;
  abm_deep_r = abm_lp70_r;
  abm_useful_l = abm_lp250_l - abm_lp70_l;
  abm_useful_r = abm_lp250_r - abm_lp70_r;
  abm_mid_l = abm_lp3700_l - abm_lp420_l;
  abm_mid_r = abm_lp3700_r - abm_lp420_r;

  abm_deep_power = (abm_deep_l * abm_deep_l + abm_deep_r * abm_deep_r) * 0.5;
  abm_useful_power = (abm_useful_l * abm_useful_l + abm_useful_r * abm_useful_r) * 0.5;
  abm_mid_power = (abm_mid_l * abm_mid_l + abm_mid_r * abm_mid_r) * 0.5;
  abm_program_det = max(absmax2(bass_pre_eq_l, bass_pre_eq_r),
                        max(absmax2(abm_deep_l, abm_deep_r),
                            max(absmax2(abm_useful_l, abm_useful_r), absmax2(abm_mid_l, abm_mid_r))));

  abm_program_det >= 0.00003 ? adapt_bass_model_age_samples += 1;
  adapt_bass_model_primed <= 0 && abm_program_det > 0.00001 ? (
    adapt_bass_model_deep_env.e = abm_deep_power;
    adapt_bass_model_useful_env.e = abm_useful_power;
    adapt_bass_model_mid_env.e = abm_mid_power;
    adapt_bass_model_slow_deep_env.e = abm_deep_power;
    adapt_bass_model_slow_useful_env.e = abm_useful_power;
    adapt_bass_model_slow_mid_env.e = abm_mid_power;
    adapt_bass_model_primed = 1;
  );

  abm_fast_deep_energy = adapt_bass_model_deep_env.peak_env(abm_deep_power, adapt_bass_model_det_attack, adapt_bass_model_det_release);
  abm_fast_useful_energy = adapt_bass_model_useful_env.peak_env(abm_useful_power, adapt_bass_model_det_attack, adapt_bass_model_det_release);
  abm_fast_mid_energy = adapt_bass_model_mid_env.peak_env(abm_mid_power, adapt_bass_model_det_attack, adapt_bass_model_det_release);
  abm_slow_deep_energy = adapt_bass_model_slow_deep_env.peak_env(abm_deep_power, adapt_bass_model_slow_attack, adapt_bass_model_slow_release);
  abm_slow_useful_energy = adapt_bass_model_slow_useful_env.peak_env(abm_useful_power, adapt_bass_model_slow_attack, adapt_bass_model_slow_release);
  abm_slow_mid_energy = adapt_bass_model_slow_mid_env.peak_env(abm_mid_power, adapt_bass_model_slow_attack, adapt_bass_model_slow_release);

  adaptive_cpu_tick ? (

    adapt_bass_feedback_rumble_count > 0 ? (
      abm_rumble_sub_energy = adapt_bass_feedback_rumble_sub_accum / adapt_bass_feedback_rumble_count;
      abm_rumble_total_energy = adapt_bass_feedback_rumble_total_accum / adapt_bass_feedback_rumble_count;

      adapt_bass_feedback_rumble_sub_env = abm_rumble_sub_energy
                                         + adapt_bass_feedback_rumble_energy_tick
                                         * (adapt_bass_feedback_rumble_sub_env - abm_rumble_sub_energy);
      adapt_bass_feedback_rumble_total_env = abm_rumble_total_energy
                                           + adapt_bass_feedback_rumble_energy_tick
                                           * (adapt_bass_feedback_rumble_total_env - abm_rumble_total_energy);
      adapt_bass_feedback_rumble_ratio_db = lin2db(sqrt(max(adapt_bass_feedback_rumble_sub_env, 0.000000000001)
                                                     / max(adapt_bass_feedback_rumble_total_env, 0.000000000001)));
    );
    adapt_bass_feedback_rumble_sub_accum = 0;
    adapt_bass_feedback_rumble_total_accum = 0;
    adapt_bass_feedback_rumble_count = 0;

    abm_rumble_target = smoothstep01((adapt_bass_feedback_rumble_ratio_db + 5.0) / 2.0);
    abm_rumble_coeff = abm_rumble_target > adapt_bass_feedback_rumble_state
                     ? adapt_bass_feedback_rumble_attack_tick
                     : adapt_bass_feedback_rumble_release_tick;
    adapt_bass_feedback_rumble_state = abm_rumble_target
                                     + abm_rumble_coeff
                                     * (adapt_bass_feedback_rumble_state - abm_rumble_target);
    abm_feedback_rumble_room = 1 - adapt_bass_feedback_rumble_state;

    c06 && adapt_bass_feedback_count > 0 ? (
      abm_feedback_b1_energy = adapt_bass_feedback_b1_accum / adapt_bass_feedback_count;
      abm_feedback_b2_energy = adapt_bass_feedback_b2_accum / adapt_bass_feedback_count;
      adapt_bass_feedback_ratio_db = lin2db(sqrt(max(abm_feedback_b1_energy, 0.000000000001)
                                                 / max(abm_feedback_b2_energy, 0.000000000001)));
    );
    adapt_bass_feedback_b1_accum = 0;
    adapt_bass_feedback_b2_accum = 0;
    adapt_bass_feedback_count = 0;

    abm_valid_program = abm_fast_mid_energy > 0.000000000001 && abm_program_det >= 0.00003;
    abm_valid_program ? (
      abm_fast_deep_ratio_db = lin2db(sqrt(max(abm_fast_deep_energy, 0.000000000001) / max(abm_fast_mid_energy, 0.000000000001)));
      abm_fast_useful_ratio_db = lin2db(sqrt(max(abm_fast_useful_energy, 0.000000000001) / max(abm_fast_mid_energy, 0.000000000001)));
      abm_slow_deep_ratio_db = lin2db(sqrt(max(abm_slow_deep_energy, 0.000000000001) / max(abm_slow_mid_energy, 0.000000000001)));
      abm_slow_useful_ratio_db = lin2db(sqrt(max(abm_slow_useful_energy, 0.000000000001) / max(abm_slow_mid_energy, 0.000000000001)));

      abm_fast_deep_boost_1 = smoothstep01((-6.2 - abm_fast_deep_ratio_db) / 2.8);
      abm_fast_deep_boost_2 = smoothstep01((-9.0 - abm_fast_deep_ratio_db) / 7.0);
      abm_fast_deep_boost_3 = smoothstep01((-16.0 - abm_fast_deep_ratio_db) / 8.0);
      abm_fast_deep_boost_db = (4.0 * abm_fast_deep_boost_1 + 3.0 * abm_fast_deep_boost_2 + 0.7 * abm_fast_deep_boost_3) * adapt_bass_boost_scale;
      abm_slow_deep_boost_1 = smoothstep01((-6.2 - abm_slow_deep_ratio_db) / 2.8);
      abm_slow_deep_boost_2 = smoothstep01((-9.0 - abm_slow_deep_ratio_db) / 7.0);
      abm_slow_deep_boost_3 = smoothstep01((-16.0 - abm_slow_deep_ratio_db) / 8.0);
      abm_slow_deep_boost_db = (4.0 * abm_slow_deep_boost_1 + 3.0 * abm_slow_deep_boost_2 + 0.7 * abm_slow_deep_boost_3) * adapt_bass_boost_scale;

      abm_fast_deep_support = smoothstep01((-5.8 - abm_fast_deep_ratio_db) / 2.5);

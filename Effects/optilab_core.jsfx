  adapt_bass_model_useful_env.e = 0;
  adapt_bass_model_mid_env.e = 0;
  adapt_bass_model_slow_deep_env.e = 0;
  adapt_bass_model_slow_useful_env.e = 0;
  adapt_bass_model_slow_mid_env.e = 0;
  adapt_bass_model_fast_deep_boost_evidence_db = 0;
  adapt_bass_model_fast_useful_boost_evidence_db = 0;
  adapt_bass_model_fast_deep_cut_evidence_db = 0;
  adapt_bass_model_fast_useful_cut_evidence_db = 0;
  adapt_bass_model_deep_boost_state_db = 0;
  adapt_bass_model_useful_boost_state_db = 0;
  adapt_bass_model_deep_cut_state_db = 0;
  adapt_bass_model_useful_cut_state_db = 0;
  adapt_bass_model_70_l.x1 = 0; adapt_bass_model_70_l.x2 = 0; adapt_bass_model_70_l.y1 = 0; adapt_bass_model_70_l.y2 = 0;
  adapt_bass_model_70_r.x1 = 0; adapt_bass_model_70_r.x2 = 0; adapt_bass_model_70_r.y1 = 0; adapt_bass_model_70_r.y2 = 0;
  adapt_bass_model_250_l.x1 = 0; adapt_bass_model_250_l.x2 = 0; adapt_bass_model_250_l.y1 = 0; adapt_bass_model_250_l.y2 = 0;
  adapt_bass_model_250_r.x1 = 0; adapt_bass_model_250_r.x2 = 0; adapt_bass_model_250_r.y1 = 0; adapt_bass_model_250_r.y2 = 0;
  adapt_bass_model_420_l.x1 = 0; adapt_bass_model_420_l.x2 = 0; adapt_bass_model_420_l.y1 = 0; adapt_bass_model_420_l.y2 = 0;
  adapt_bass_model_420_r.x1 = 0; adapt_bass_model_420_r.x2 = 0; adapt_bass_model_420_r.y1 = 0; adapt_bass_model_420_r.y2 = 0;
  adapt_bass_model_3700_l.x1 = 0; adapt_bass_model_3700_l.x2 = 0; adapt_bass_model_3700_l.y1 = 0; adapt_bass_model_3700_l.y2 = 0;
  adapt_bass_model_3700_r.x1 = 0; adapt_bass_model_3700_r.x2 = 0; adapt_bass_model_3700_r.y1 = 0; adapt_bass_model_3700_r.y2 = 0;
  adapt_bass_actuator_shelf_l.x1 = 0; adapt_bass_actuator_shelf_l.x2 = 0; adapt_bass_actuator_shelf_l.y1 = 0; adapt_bass_actuator_shelf_l.y2 = 0;
  adapt_bass_actuator_shelf_r.x1 = 0; adapt_bass_actuator_shelf_r.x2 = 0; adapt_bass_actuator_shelf_r.y1 = 0; adapt_bass_actuator_shelf_r.y2 = 0;
  adapt_bass_actuator_body_l.x1 = 0; adapt_bass_actuator_body_l.x2 = 0; adapt_bass_actuator_body_l.y1 = 0; adapt_bass_actuator_body_l.y2 = 0;
  adapt_bass_actuator_body_r.x1 = 0; adapt_bass_actuator_body_r.x2 = 0; adapt_bass_actuator_body_r.y1 = 0; adapt_bass_actuator_body_r.y2 = 0;
  adapt_bass_actuator_shelf_l.a0 = 1; adapt_bass_actuator_shelf_l.a1 = 0; adapt_bass_actuator_shelf_l.a2 = 0; adapt_bass_actuator_shelf_l.b1 = 0; adapt_bass_actuator_shelf_l.b2 = 0;
  adapt_bass_actuator_shelf_r.a0 = 1; adapt_bass_actuator_shelf_r.a1 = 0; adapt_bass_actuator_shelf_r.a2 = 0; adapt_bass_actuator_shelf_r.b1 = 0; adapt_bass_actuator_shelf_r.b2 = 0;
  adapt_bass_actuator_body_l.a0 = 1; adapt_bass_actuator_body_l.a1 = 0; adapt_bass_actuator_body_l.a2 = 0; adapt_bass_actuator_body_l.b1 = 0; adapt_bass_actuator_body_l.b2 = 0;
  adapt_bass_actuator_body_r.a0 = 1; adapt_bass_actuator_body_r.a1 = 0; adapt_bass_actuator_body_r.a2 = 0; adapt_bass_actuator_body_r.b1 = 0; adapt_bass_actuator_body_r.b2 = 0;
  adapt_bass_actuator_coeff_count = 63;
  adapt_bass_model_deep_gain = 1;
  adapt_bass_model_useful_gain = 1;
  adapt_bass_model_deep_target_cached = 1;
  adapt_bass_model_useful_target_cached = 1;
  adapt_bass_model_deep_target_db_cached = 0;
  adapt_bass_model_useful_target_db_cached = 0;
  adapt_bass_model_voice_gain = 1;
  adapt_bass_model_voice_target_cached = 1;
  adapt_bass_model_deep_ratio_db = 0;
  adapt_bass_model_useful_ratio_db = 0;
  adapt_bass_model_deep_raw_db = 0;
  adapt_bass_model_useful_raw_db = 0;
  bass_peak_l.x1 = 0; bass_peak_l.x2 = 0; bass_peak_l.y1 = 0; bass_peak_l.y2 = 0;
  bass_peak_r.x1 = 0; bass_peak_r.x2 = 0; bass_peak_r.y1 = 0; bass_peak_r.y2 = 0;

  bassclip_pre_l.z1 = 0; bassclip_pre_l.z2 = 0; bassclip_pre_r.z1 = 0; bassclip_pre_r.z2 = 0;
  bassclip_split_l.z1 = 0; bassclip_split_l.z2 = 0; bassclip_split_r.z1 = 0; bassclip_split_r.z2 = 0;
  bassclip_hpf_l.z = 0; bassclip_hpf_r.z = 0;
  bassclip1_l.z1 = 0; bassclip1_l.z2 = 0; bassclip1_r.z1 = 0; bassclip1_r.z2 = 0;
  bassclip2_l.z1 = 0; bassclip2_l.z2 = 0; bassclip2_r.z1 = 0; bassclip2_r.z2 = 0;

  ub_gate4.e = 0; ub_gate5.e = 0; ub_gate6.e = 0;
  ub_lim6.gain = 1;
  us_prev4_l = 0; us_prev4_r = 0; us_prev24_l = 0; us_prev24_r = 0;
  us_prev5_l = 0; us_prev5_r = 0; us_prev25_l = 0; us_prev25_r = 0;
  us_prev6_l = 0; us_prev6_r = 0; us_prev26_l = 0; us_prev26_r = 0;

  fcs_wrpos = 0;
  snub_wrpos = 0;
  diag_xt2_wrpos = 0;
  diag_final_wrpos = 0;
  master_wrpos = 0;
  master_startup_armed = 1;
  master_startup_age = 0;
  master_catch_gain = 1;
  master_raw_env.e = 0;
  master_amp_env.e = 0;
  master_catch_env.e = 0;

  i = 0;
  loop(fcs_buf_len,
    fcs_buf_l[i] = 0; fcs_buf_r[i] = 0; fcs_buf_ol[i] = 0; fcs_buf_or[i] = 0;
    i += 1;
  );
  i = 0;
  loop(snub_buf_len,
    snub_p1_l[i] = 0; snub_p1_r[i] = 0; snub_p2_l[i] = 0; snub_p2_r[i] = 0;
    snub_p3_l[i] = 0; snub_p3_r[i] = 0; snub_p4_l[i] = 0; snub_p4_r[i] = 0;
    snub_p5_l[i] = 0; snub_p5_r[i] = 0; snub_p6_l[i] = 0; snub_p6_r[i] = 0;
    i += 1;
  );
  i = 0;
  loop(diag_xt2_buf_len,
    diag_xt2_l[i] = 0; diag_xt2_r[i] = 0;
    i += 1;
  );
  i = 0;
  loop(diag_final_buf_len,
    diag_final_l[i] = 0; diag_final_r[i] = 0;
    i += 1;
  );
  i = 0;
  loop(master_buf_len,
    master_buf_l[i] = 0; master_buf_r[i] = 0;
    i += 1;
  );
);

function biquad_lp_set(freq q) instance(a0 a1 a2 b1 b2) local(w0 cw sw alpha norm)
(
  freq = clamp(freq, 20, srate_safe * 0.45);
  w0 = 2*$pi*freq/srate_safe;
  cw = cos(w0);
  sw = sin(w0);
  alpha = sw/(2*q);
  norm = 1/(1 + alpha);
  a0 = ((1 - cw) * 0.5) * norm;
  a1 = (1 - cw) * norm;
  a2 = a0;
  b1 = (-2 * cw) * norm;
  b2 = (1 - alpha) * norm;
);

function biquad_peak_set(freq q gain_db) instance(a0 a1 a2 b1 b2) local(A w0 cw sw alpha b0 bb1 bb2 aa0 aa1 aa2 norm)
(
  freq = clamp(freq, 20, srate_safe * 0.45);
  A = 10^(gain_db/40);
  w0 = 2*$pi*freq/srate_safe;
  cw = cos(w0);
  sw = sin(w0);
  alpha = sw/(2*q);
  b0 = 1 + alpha*A;
  bb1 = -2*cw;
  bb2 = 1 - alpha*A;
  aa0 = 1 + alpha/A;
  aa1 = -2*cw;
  aa2 = 1 - alpha/A;
  norm = 1/aa0;
  a0 = b0*norm;
  a1 = bb1*norm;
  a2 = bb2*norm;
  b1 = aa1*norm;
  b2 = aa2*norm;
);

function biquad_low_shelf_set(freq slope gain_db) instance(a0 a1 a2 b1 b2) local(A w0 cw sw alpha sqrtA b0 bb1 bb2 aa0 aa1 aa2 norm)
(
  freq = clamp(freq, 20, srate_safe * 0.45);
  slope = clamp(slope, 0.20, 2.00);
  A = 10^(gain_db/40);
  w0 = 2*$pi*freq/srate_safe;
  cw = cos(w0);
  sw = sin(w0);
  alpha = (sw * 0.5) * sqrt((A + 1/A) * (1/slope - 1) + 2);
  sqrtA = sqrt(A);
  b0 = A * ((A + 1) - (A - 1)*cw + 2*sqrtA*alpha);
  bb1 = 2*A * ((A - 1) - (A + 1)*cw);
  bb2 = A * ((A + 1) - (A - 1)*cw - 2*sqrtA*alpha);
  aa0 = (A + 1) + (A - 1)*cw + 2*sqrtA*alpha;
  aa1 = -2 * ((A - 1) + (A + 1)*cw);
  aa2 = (A + 1) + (A - 1)*cw - 2*sqrtA*alpha;
  norm = 1/aa0;
  a0 = b0*norm;
  a1 = bb1*norm;
  a2 = bb2*norm;
  b1 = aa1*norm;
  b2 = aa2*norm;
);

function biquad_run(x) instance(a0 a1 a2 b1 b2 x1 x2 y1 y2) local(y)
(
  y = a0*x + a1*x1 + a2*x2 - b1*y1 - b2*y2;
  x2 = x1;
  x1 = x;
  y2 = y1;
  y1 = y;
  y;
);

function fm_emph(x k) instance(x1 primed) local(y)
(
  primed <= 0 ? (
    x1 = x;
    primed = 1;
    y = x;
  ) : (
    y = x + k * (x - x1);
    x1 = x;
  );
  y;
);

function fm_deemph(y k) instance(x1 primed) local(x)
(
  primed <= 0 ? (
    x1 = y;
    primed = 1;
    x = y;
  ) : (
    x = (y + k * x1) / max(1 + k, 0.000000001);
    x1 = x;
  );
  x;
);

function meter_to_db(x)
(
  x > 0.000001 ? lin2db(x) : -120;
);

function meter_over_db(x ref)
(
  x > ref ? lin2db(x / max(ref, 0.000001)) : 0;
);

function meter_note_activity(stage activity_db)
(
  activity_db > meter_last_activity_db ? (
    meter_last_activity_db = activity_db;
    meter_last_stage_internal = stage;
    meter_stage_name = stage;
  );
);

function reset_meter_state()
(
  meter_out_peak_l = 0;
  meter_out_peak_r = 0;
  meter_out_mid_peak = 0;
  meter_out_side_peak = 0;
  meter_final_in_mid_peak = 0;
  meter_final_in_side_peak = 0;
  meter_mb_clip_max_db = 0;
  meter_preclip_max_db = 0;
  meter_final_clip_max_db = 0;
  meter_width_added_max_db = 0;
  meter_over_ceiling_max_db = 0;
  meter_gain_reduction1_max = 0;
  meter_gain_reduction2_max = 0;
  meter_gain_reduction3_max = 0;
  meter_gain_reduction4_max = 0;
  meter_gain_reduction5_max = 0;
  meter_gain_reduction6_max = 0;
  meter_band1_gain_reduction_value = 0;
  meter_band2_gain_reduction_value = 0;
  meter_band3_gain_reduction_value = 0;
  meter_band4_gain_reduction_value = 0;
  meter_band5_gain_reduction_value = 0;
  meter_band6_gain_reduction_value = 0;
  meter_last_activity_db = 0;
  meter_last_stage_internal = 0;
  meter_stage_name = 0;
  meter_selected_value = -120;
  meter_refresh_count = 0;

  meter_cpu_count = 0;
  meter_heavy_tick = 1;
  meter_blk_mb_pre3 = meter_blk_mb_pre4 = meter_blk_mb_pre5 = meter_blk_mb_pre6 = 0;
  meter_blk_mb_post3 = meter_blk_mb_post4 = meter_blk_mb_post5 = meter_blk_mb_post6 = 0;
  meter_blk_gr_min1 = meter_blk_gr_min2 = meter_blk_gr_min3 = 1;
  meter_blk_gr_min4 = meter_blk_gr_min5 = meter_blk_gr_min6 = 1;
  meter_blk_us_pre4 = meter_blk_us_pre5 = meter_blk_us_pre6 = 0;
  meter_blk_us_post4 = meter_blk_us_post5 = meter_blk_us_post6 = 0;
  meter_blk_recomb_pre = meter_blk_recomb_post = 0;
  meter_blk_guard_min = 1;
  meter_blk_width_added_max = 1;
  meter_blk_preclip_min = 1;
  meter_blk_finalclip_pre = meter_blk_finalclip_post = 0;
  meter_blk_overshoot_peak = 0;
  meter_blk_safety_peak = 0;
  meter_blk_safety_pre = meter_blk_safety_post = 0;
);

function refresh_meter_readout() local(old_selected_value old_stage_name)
(
  old_selected_value = meter_selected_value;
  old_stage_name = meter_stage_name;

  meter_view = floor(clamp(meter_view, 0, 16) + 0.5);
  meter_stage_name = meter_last_stage_internal;
  meter_selected_value = meter_view == 0 ? meter_to_db(meter_out_peak_l) :
                         meter_view == 1 ? meter_to_db(meter_out_peak_r) :
                         meter_view == 2 ? meter_to_db(meter_out_mid_peak) :
                         meter_view == 3 ? meter_to_db(meter_out_side_peak) :
                         meter_view == 4 ? meter_to_db(meter_final_in_mid_peak) :
                         meter_view == 5 ? meter_to_db(meter_final_in_side_peak) :
                         meter_view == 6 ? meter_mb_clip_max_db :
                         meter_view == 7 ? meter_preclip_max_db :
                         meter_view == 8 ? meter_final_clip_max_db :
                         meter_view == 9 ? meter_over_ceiling_max_db :
                         meter_view == 10 ? meter_gain_reduction1_max :
                         meter_view == 11 ? meter_gain_reduction2_max :
                         meter_view == 12 ? meter_gain_reduction3_max :
                         meter_view == 13 ? meter_gain_reduction4_max :
                         meter_view == 14 ? meter_gain_reduction5_max :
                         meter_view == 15 ? meter_gain_reduction6_max :
                                              meter_width_added_max_db;

);

function update_derived_params() local(dpos dneg)
(
  shape_rec_block_size = 16;
  shape_rec_attack = 1 - exp(-1/(srate_safe * 0.320));
  shape_rec_release = 1 - exp(-1/(srate_safe * 0.070));
  shape_rec_attack_blk = 1 - pow(1 - shape_rec_attack, shape_rec_block_size);
  shape_rec_release_blk = 1 - pow(1 - shape_rec_release, shape_rec_block_size);
  shape_servo_lvl_a = 1 - exp(-1/(srate_safe * 2.400));
  shape_servo_gain_a = 1 - exp(-1/(srate_safe * 0.900));

  crossover_model = floor(clamp(crossover_model, 0, 3) + 0.5);
  processor_mode = floor(clamp(processor_mode, 0, 1) + 0.5);
  subsonic_hpf = floor(clamp(subsonic_hpf, 0, 1) + 0.5);
  top_filter_mode = floor(clamp(top_filter_mode, 0, 3) + 0.5);
  xt2_amount_pct = clamp(xt2_amount_pct, 0, 100);
  mb_limiter_depth_pct = clamp(mb_limiter_depth_pct, 0, 100);
  mb_limiter_depth_user = mb_limiter_depth_pct * 0.01;
  mb_shape_pct = clamp(mb_shape_pct, 0, 100);
  mb_comp_limiter_pct = clamp(mb_comp_limiter_pct, 0, 100);
  upper_snubber = upper_snubber_pct * 0.01;
  overshoot_amt = overshoot_pct * 0.01;

  snubber_lookahead_ms > 1.50 ? snubber_lookahead_ms = min(snubber_lookahead_ms, 64) * 1000 / 44100;
  lookahead_ms > 1.50 ? lookahead_ms = min(lookahead_ms, 64) * 1000 / 44100;
  snubber_lookahead_ms = clamp(snubber_lookahead_ms, 0, 1.50);
  lookahead_ms = clamp(lookahead_ms, 0, 1.50);

  ceiling = db2lin(clip_ceiling_db);
  clip_ref = ceiling * 0.985;
  mb_ref = ceiling * 0.985;

  effective_snubber_lookahead = (xt2_section_mode != 3 && upper_snubber > 0 && snubber_lookahead_ms > 0) ? min(snub_buf_len - 1, floor(srate_safe * snubber_lookahead_ms * 0.001 + 0.5)) : 0;
  effective_final_lookahead = (final_section_mode != 3 && overshoot_amt > 0 && lookahead_ms > 0) ? min(fcs_buf_len - 1, floor(srate_safe * lookahead_ms * 0.001 + 0.5)) : 0;
  mastering_lookahead_samps = processor_mode == 1 ? min(master_buf_len - 1, floor(srate_safe * 0.010 + 0.5)) : 0;
  master_startup_prime_window = floor(srate_safe * 0.350 + 0.5);
  master_startup_active_thresh = db2lin(-70);

  diag_stage = -1;
  input_section_mode == 1 || input_section_mode == 2 ? diag_stage = 0;
  agc_section_mode == 1 || agc_section_mode == 2 ? diag_stage = 1;
  bass_section_mode == 1 || bass_section_mode == 2 ? diag_stage = 2;
  xt2_section_mode == 1 || xt2_section_mode == 2 ? diag_stage = 3;
  stereo_section_mode == 1 || stereo_section_mode == 2 ? diag_stage = 4;
  final_section_mode == 1 || final_section_mode == 2 ? diag_stage = 5;

  diag_stage >= 0 ? (
    path_delay = 0;
    diag_stage >= 2 ? path_delay += mastering_lookahead_samps;
    diag_stage >= 3 ? path_delay += effective_snubber_lookahead;
    diag_stage >= 5 ? path_delay += effective_final_lookahead;
  ) : (
    path_delay = mastering_lookahead_samps + effective_snubber_lookahead;
    final_section_mode != 3 ? path_delay += effective_final_lookahead;
  );
  pdc_delay = path_delay + hybrid_total_spl;
  pdc_bot_ch = 0;
  pdc_top_ch = 2;

  phase_legacy_val = phase_rotate_pct;
  phase_legacy_val > 6 ? (
    phase_rotate_pct = 6;
    phase_legacy_val < 85 ? phase_rotate_pct = 5;
    phase_legacy_val < 70 ? phase_rotate_pct = 4;
    phase_legacy_val < 58 ? phase_rotate_pct = 3;
    phase_legacy_val < 42 ? phase_rotate_pct = 2;
    phase_legacy_val < 20 ? phase_rotate_pct = 1;
  );
  phase_mode = floor(clamp(phase_rotate_pct, 0, 6) + 0.5);
  phase_rotate_pct = phase_mode;
  phase_mode != phase_mode_last ? (
    reset_phase_state();
    phase_mode_last = phase_mode;
  );
  phase_stages = 0;
  phase_mode == 1 ? phase_stages = 2;
  phase_mode == 2 ? phase_stages = 4;
  phase_mode == 3 ? phase_stages = 6;
  phase_mode == 4 ? phase_stages = 8;
  phase_mode == 5 ? phase_stages = 10;
  phase_mode == 6 ? phase_stages = 12;

  phase_f1 = 55;
  phase_f2 = 85;
  phase_f3 = 130;
  phase_f4 = 200;
  phase_f5 = 310;
  phase_f6 = 480;
  phase_f7 = 740;
  phase_f8 = 1150;
  phase_f9 = 1800;
  phase_f10 = 2800;
  phase_f11 = 4300;
  phase_f12 = 6500;

  input_gain = db2lin(input_trim_db);
  agc_drive = db2lin(agc_drive_db);
  density_pos_db = max(density_db, 0);
  density_neg_db = min(density_db, 0);
  density_audio_gain = db2lin(density_neg_db + density_pos_db * 0.35);
  density_detector_gain = db2lin(density_pos_db * 0.65);
  density_clip_drive = db2lin(density_pos_db * 0.55);
  presence_gain = db2lin(presence_db);
  brilliance_gain = db2lin(brilliance_db);
  clip_drive_mb = db2lin(clip_drive_db * 0.60);

  density_protection_drive_gain = db2lin(max(clip_drive_db, 0) * 0.75);
  mb_work_ref = mb_ref / max(clip_drive_mb * density_clip_drive, 0.25);
  final_threshold_db = clamp(final_threshold_db, -24, 6);
  final_threshold_makeup_pct = clamp(final_threshold_makeup_pct, 0, 100);
  final_threshold_drive_target = db2lin(-final_threshold_db);
  final_threshold_makeup = final_threshold_makeup_pct * 0.01;
  output_gain = db2lin(output_trim_db);
  smooth_drive_rounder_amt = clamp(smooth_drive_rounder_pct, 0, 100) * 0.01;
  post_agc_smooth_drive_amt = clamp(post_agc_smooth_drive_pct, 0, 25) * 0.01;
  post_xt2_smooth_drive_amt = clamp(post_xt2_smooth_drive_pct, 0, 50) * 0.01;
  post_agc_smooth_recovery_gain = db2lin(2.0 * clamp(post_agc_smooth_drive_pct, 0, 25) / 25.0);
  post_xt2_smooth_recovery_gain = db2lin(2.0 * clamp(post_xt2_smooth_drive_pct, 0, 50) / 50.0);
  density_output_gain = db2lin(clamp(density_output_db, -12, 12));

  mb_clip_mix = mb_clip_pct * 0.01;
  dc_cancel = dc_cancel_pct * 0.01;
  recomb_control = recomb_control_pct * 0.01;

  agc_mix = agc_amount_pct * 0.01;
  agc_down_mix = agc_mix <= 0.50 ? agc_mix : 0.50 + (agc_mix - 0.50) * 0.40;
  pd_release = pd_release_pct * 0.01;
  gate_reopen_strength = gate_reopen_strength_pct * 0.01;
  gate_reopen_speed_sec = max(gate_reopen_speed_ms * 0.001, 0.005);
  gate_lin = db2lin(gate_threshold_db);
  agc_target = db2lin(-17);
  agc_max_gain = db2lin(agc_max_gain_db);
  agc_min_gain = db2lin(-14);

  xt2_mix = xt2_amount_pct * 0.01;
  adaptive_top_coupling = (xt2_section_mode != 3) ? adaptive_top_coupling_pct * 0.01 : 0;
  bass_section_active = bass_section_mode != 3;
  bass_coupling = bass_section_active ? bass_coupling_pct * 0.01 : 0;
  bass_eq_work_db = bass_section_active ? bass_eq_db : 0;
  bass_sc_relief = bass_section_active ? bass_sc_relief_pct * 0.01 : 0;
  low_coherence = bass_section_active ? low_coherence_pct * 0.01 : 0;
  low_release_stab = bass_section_active ? low_release_stab_pct * 0.01 : 0;
  transition_fill = bass_section_active ? transition_fill_pct * 0.01 : 0;
  low_bass_floor = bass_section_active ? low_bass_floor_pct * 0.01 : 0;
  adaptive_bass_coupling = bass_section_active ? adaptive_bass_coupling_pct * 0.01 : 0;
  bass_clip = bass_section_active ? bass_clip_pct * 0.01 : 0;
  bass_clip_density = bass_section_active ? bass_clip_density_pct * 0.01 : 0;

  prelimit_mix = pre_limiter_pct * 0.01;
  clip_restraint = clip_restraint_pct * 0.01;

  clipper_style_work = floor(clamp(clipper_style, 0, 7) + 0.5);
  clipper_ms_mode = clipper_style_work >= 4;
  clipper_style_base = clipper_ms_mode ? clipper_style_work - 4 : clipper_style_work;

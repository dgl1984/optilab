// @description OptiLab Core
// @version 1.3.0
// @author LanesAudio
// @about
//   OptiLab Core is a three-control broadcast and mastering processor.
//   v1.3.0 keeps the established Podcast Leveler behavior while expanding Stream polish Auto-Adapt.
// @changelog
//   v1.3.0
//   - Stream polish Auto-Adapt now builds more progressively from open polish into firmer broadcast-style control.
//   - At higher settings, Auto-Adapt adds more width, bass control, density, Shape, and peak protection while preserving useful low-end weight.
//   - Smooth Limiter has improved peak control while keeping the same simple three-control workflow.
// @link
//   Donations: https://paypal.me/dgl1984
//   Contact: info@lanesaudio.com
// @license Apache-2.0 with Commons Clause (https://commonsclause.com/). See LICENSE.
// @provides
//   optilab_core.jsfx
desc:OptiLab Core v1.3.0 (LanesAudio)

slider1:core_mode=0<0,2,1{Podcast Leveler,Stream polish,Smooth Limiter}>Mode
slider2:input_drive_db=3.5<-12,18,0.1>Input Drive dB
slider3:auto_adapt_pct=0<0,100,1>Auto-Adapt percent
in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
srate_safe = (srate >= 8000 && srate <= 768000) ? srate : 48000;
ext_tail_size = -2;

agc_lgain = 1;
agc_hgain = 1;
final_threshold_drive_s = 1;
final_threshold_guard_gain = 1;

gui_tab = 0;
gui_active_slider = -1;
gui_drag_start_y = 0;
gui_drag_start_x = 0;
gui_drag_start_val = 0;
gui_last_mouse_cap = 0;
gui_menu_active = 0;
gui_peak_in_l_sample = 0;
gui_peak_in_r_sample = 0;
gui_peak_in_l = 0;
gui_peak_in_r = 0;
gui_peak_hold_in = 20000;
20000[] = -60;
gui_theme_bg = 0x101316;
gui_theme_panel = 0x181D22;
gui_theme_accent = 0x14B8D4;
gui_theme_text = 0xE5EDF4;

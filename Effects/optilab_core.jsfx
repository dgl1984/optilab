    hybrid_candidate_l[i]=0; hybrid_candidate_r[i]=0; hybrid_shaved_l[i]=0; hybrid_shaved_r[i]=0;
    hybrid_required[i]=1; hybrid_worklim[i]=ceiling; hybrid_makeup[i]=1; i+=1;
  );
  i=0; loop(hybrid_energy_len,hybrid_refe[i]=0;hybrid_deltae[i]=0;i+=1;);
  i=0; loop(hybrid_buf_len,hybrid_required_active[i]=0;i+=1;);
);

function coh_biquad_set_lp(p freq q) local(w0 cw sw alpha norm)
(
  freq = clamp(freq, 20, srate_safe * 0.45);
  w0 = 2*$pi*freq/srate_safe; cw = cos(w0); sw = sin(w0); alpha = sw/(2*q); norm = 1/(1+alpha);
  p[0] = ((1-cw)*0.5)*norm; p[1] = (1-cw)*norm; p[2] = p[0]; p[3] = (-2*cw)*norm; p[4] = (1-alpha)*norm;
);

function coh_biquad_set_hp(p freq q) local(w0 cw sw alpha norm)
(
  freq = clamp(freq, 20, srate_safe * 0.45);
  w0 = 2*$pi*freq/srate_safe; cw = cos(w0); sw = sin(w0); alpha = sw/(2*q); norm = 1/(1+alpha);
  p[0] = ((1+cw)*0.5)*norm; p[1] = -(1+cw)*norm; p[2] = p[0]; p[3] = (-2*cw)*norm; p[4] = (1-alpha)*norm;
);

function coh_biquad_set_ap(p freq q) local(w0 cw sw alpha norm)
(
  freq = clamp(freq, 20, srate_safe * 0.45);
  w0 = 2*$pi*freq/srate_safe; cw = cos(w0); sw = sin(w0); alpha = sw/(2*q); norm = 1/(1+alpha);
  p[0] = (1-alpha)*norm; p[1] = (-2*cw)*norm; p[2] = 1; p[3] = p[1]; p[4] = p[0];
);

function coh_biquad_run(p x) local(y)
(
  y = p[0]*x + p[1]*p[5] + p[2]*p[6] - p[3]*p[7] - p[4]*p[8];
  p[6] = p[5]; p[5] = x; p[8] = p[7]; p[7] = y;
  y;
);

function coh_lr4_config(base) local(stage band sb freq q p)
(
  q = 0.70710678118654752440;
  stage = 0;
  loop(5,
    freq = min(coh_lr_freqs[stage]*c10*0.01,srate_safe*0.45);
    sb = base + (4*stage + stage*(stage-1)*0.5)*9;
    p = sb; coh_biquad_set_lp(p,freq,q); p += 9; coh_biquad_set_lp(p,freq,q);
    p = sb+18; coh_biquad_set_hp(p,freq,q); p += 9; coh_biquad_set_hp(p,freq,q);
    band = 0;
    loop(stage,
      p = sb + (4+band)*9; coh_biquad_set_ap(p,freq,q);
      band += 1;
    );
    stage += 1;
  );
);

function coh_lr8_config(base) local(stage band section sb freq ql qh q p)
(
  ql = 0.54119610014619698440; qh = 1.3065629648763765279;
  stage = 0;
  loop(5,
    freq = min(coh_lr_freqs[stage]*c10*0.01,srate_safe*0.45);
    sb = base + (8*stage + stage*(stage-1))*9;
    section = 0;
    loop(4,
      q = (section===0 || section===2) ? ql : qh;
      p = sb + section*9; coh_biquad_set_lp(p,freq,q);
      p = sb + (4+section)*9; coh_biquad_set_hp(p,freq,q);
      section += 1;
    );
    band = 0;
    loop(stage,
      p = sb + (8+band*2)*9; coh_biquad_set_ap(p,freq,ql); p += 9; coh_biquad_set_ap(p,freq,qh);
      band += 1;
    );
    stage += 1;
  );
);

function coh_lr4_split(x base outp) local(stage band sb lo hi p)
(
  hi = x; stage = 0;
  loop(5,
    sb = base + (4*stage + stage*(stage-1)*0.5)*9;
    band = 0;
    loop(stage,
      p = sb + (4+band)*9; outp[band] = coh_biquad_run(p,outp[band]);
      band += 1;
    );
    lo = hi;
    p = sb; lo = coh_biquad_run(p,lo); p += 9; lo = coh_biquad_run(p,lo);
    p = sb+18; hi = coh_biquad_run(p,hi); p += 9; hi = coh_biquad_run(p,hi);
    outp[stage] = lo;
    stage += 1;
  );
  outp[5] = hi;
);

function coh_lr8_split(x base outp) local(stage band section sb lo hi p)
(
  hi = x; stage = 0;
  loop(5,
    sb = base + (8*stage + stage*(stage-1))*9;
    band = 0;
    loop(stage,
      p = sb + (8+band*2)*9; outp[band] = coh_biquad_run(p,outp[band]); p += 9; outp[band] = coh_biquad_run(p,outp[band]);
      band += 1;
    );
    lo = hi; section = 0;
    loop(4, p = sb + section*9; lo = coh_biquad_run(p,lo); section += 1; );
    section = 0;
    loop(4, p = sb + (4+section)*9; hi = coh_biquad_run(p,hi); section += 1; );
    outp[stage] = lo;
    stage += 1;
  );
  outp[5] = hi;
);

function biquad_lp_set(freq q) instance(a0 a1 a2 b1 b2) local(w0 cw sw alpha norm)
(
  freq = clamp(freq, 20, srate_safe * 0.45);
  w0 = 2*$pi*freq/srate_safe;
  cw = cos(w0);
  sw = sin(w0);
  alpha = sw/(2*q);
  norm = 1/(1 + alpha);
  a0 = ((1 - cw) * 0.5) * norm;
  a1 = (1 - cw) * norm;
  a2 = a0;
  b1 = (-2 * cw) * norm;
  b2 = (1 - alpha) * norm;
);

function biquad_peak_set(freq q gain_db) instance(a0 a1 a2 b1 b2) local(A w0 cw sw alpha b0 bb1 bb2 aa0 aa1 aa2 norm)
(
  freq = clamp(freq, 20, srate_safe * 0.45);
  A = 10^(gain_db/40);
  w0 = 2*$pi*freq/srate_safe;
  cw = cos(w0);
  sw = sin(w0);
  alpha = sw/(2*q);
  b0 = 1 + alpha*A;
  bb1 = -2*cw;
  bb2 = 1 - alpha*A;
  aa0 = 1 + alpha/A;

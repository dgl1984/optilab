dist_l = clip_l - clip_in_l;
dist_r = clip_r - clip_in_r;
dist_low_l = dist_lpf_l.onepole_lp(dist_l, dist_cancel_a);
dist_low_r = dist_lpf_r.onepole_lp(dist_r, dist_cancel_a);

l = clip_l - dist_low_l * dc_cancel * 0.45;
r = clip_r - dist_low_r * dc_cancel * 0.45;

p080===1 ? (l=cf_lp1_l.biquad_run(l);r=cf_lp1_r.biquad_run(r);)
 : p080>=2 ? (l=cf_lp2_l.biquad_run(cf_lp1_l.biquad_run(l));r=cf_lp2_r.biquad_run(cf_lp1_r.biquad_run(r)););
l *= output_gain;
r *= output_gain;

fcs_thresh = fcs_thresh_setting;
meter_final_safety_pre = absmax2(l, r);
ov_l = l - hard_limit(l, fcs_thresh);
ov_r = r - hard_limit(r, fcs_thresh);
ov_l = fcs_res_l.onepole_lp(ov_l, fcs_residue_a);
ov_r = fcs_res_r.onepole_lp(ov_r, fcs_residue_a);
meter_blk_overshoot_peak = max(meter_blk_overshoot_peak, absmax2(l, r));
meter_heavy_tick ? (
  meter_overshoot_now_db = meter_over_db(meter_blk_overshoot_peak, fcs_thresh);
  meter_over_ceiling_max_db = max(meter_over_ceiling_max_db, meter_overshoot_now_db);
  meter_blk_overshoot_peak = 0;
);

l-=ov_l*overshoot_amt;
r-=ov_r*overshoot_amt;

meter_blk_safety_peak = max(meter_blk_safety_peak, absmax2(l, r));
meter_heavy_tick ? (
  meter_safety_now_db = meter_over_db(meter_blk_safety_peak, ceiling);
  meter_over_ceiling_max_db = max(meter_over_ceiling_max_db, meter_safety_now_db);
  meter_blk_safety_peak = 0;
);
legacy_final_l=hard_limit(l,ceiling);
legacy_final_r=hard_limit(r,ceiling);
hybrid_total_spl > 0 ? (
hybrid_drive=max(cf_out_drive,1);
hybrid_limit=ceiling/hybrid_drive;
hybrid_make=hybrid_drive;
hybrid_raw_l[hybrid_write]=legacy_final_l;
hybrid_raw_r[hybrid_write]=legacy_final_r;
hybrid_eventgate[hybrid_write]=0;
hybrid_worklim[hybrid_write]=hybrid_limit;
hybrid_makeup[hybrid_write]=hybrid_make;
  hybrid_out_read=hybrid_write-hybrid_total_spl; hybrid_out_read<0?hybrid_out_read+=hybrid_buf_len;
  stream_hybrid_mix <= 0.0000001 ? (
    hybrid_limiter_window_tracked=0;
    final_section_proc_l=hybrid_raw_l[hybrid_out_read];
    final_section_proc_r=hybrid_raw_r[hybrid_out_read];
    hybrid_write+=1; hybrid_write>=hybrid_buf_len?hybrid_write=0;
    hybrid_clock+=1;
  ) : (
hybrid_cand_l=hybrid_shave(legacy_final_l,hybrid_limit,c34);
hybrid_cand_r=hybrid_shave(legacy_final_r,hybrid_limit,c34);
hybrid_candidate_l[hybrid_write]=hybrid_cand_l;
hybrid_candidate_r[hybrid_write]=hybrid_cand_r;
hybrid_delta_l=hybrid_cand_l-legacy_final_l;
hybrid_delta_r=hybrid_cand_r-legacy_final_r;
hybrid_old_ref=hybrid_refe[hybrid_energy_write];
hybrid_old_delta=hybrid_deltae[hybrid_energy_write];
hybrid_ref_sum-=hybrid_old_ref;
hybrid_delta_sum-=hybrid_old_delta;
hybrid_new_ref=legacy_final_l*legacy_final_l+legacy_final_r*legacy_final_r;
hybrid_new_delta=hybrid_delta_l*hybrid_delta_l+hybrid_delta_r*hybrid_delta_r;
hybrid_refe[hybrid_energy_write]=hybrid_new_ref;
hybrid_deltae[hybrid_energy_write]=hybrid_new_delta;
hybrid_ref_sum+=hybrid_new_ref;
hybrid_delta_sum+=hybrid_new_delta;
// Match native modulo wrapping when automation shrinks the history window.
hybrid_energy_write=(hybrid_energy_write+1)%hybrid_window_spl;
hybrid_energy_count=min(hybrid_energy_count+1,hybrid_window_spl);
hybrid_ref_rms=sqrt(max(hybrid_ref_sum,0)/max(2*hybrid_energy_count,1));
hybrid_ref_rms<db2lin(-60) ? hybrid_burden_target=1 : (
  hybrid_ratio=max(hybrid_delta_sum,0)/max(hybrid_ref_sum,0.000000000000000001);
  hybrid_burden_db=hybrid_ratio>0.000000000001?4.342944819032518*log(hybrid_ratio):-120;
  hybrid_guard_reject=max(c32,c09+0.1);
  hybrid_burden_db<=c09 ? hybrid_burden_target=1 : hybrid_burden_db>=hybrid_guard_reject ? hybrid_burden_target=0 : (
    hybrid_bt=hybrid_smooth01((hybrid_burden_db-c09)/(hybrid_guard_reject-c09));
    hybrid_burden_target=1-hybrid_bt;
  );
);
hybrid_burden_target<hybrid_burden_accept ? hybrid_burden_accept=hybrid_burden_target+hybrid_burden_attack*(hybrid_burden_accept-hybrid_burden_target) : hybrid_burden_accept=hybrid_burden_target+hybrid_burden_release*(hybrid_burden_accept-hybrid_burden_target);
hybrid_burden_accept=clamp(hybrid_burden_accept,0,1);
hybrid_burden[hybrid_write]=hybrid_burden_accept;
hybrid_removed=max(abs(hybrid_delta_l),abs(hybrid_delta_r));
hybrid_active=hybrid_removed>hybrid_limit*0.001;
hybrid_new_event=hybrid_active&&!hybrid_candidate_prev;
hybrid_end_event=!hybrid_active&&hybrid_candidate_prev;
hybrid_new_event ? (
  hybrid_event_start_abs=hybrid_clock;
  hybrid_event_start_ring=hybrid_write;
  hybrid_event_corr=hybrid_corr(hybrid_clock);
  hybrid_onset3=hybrid_onset2; hybrid_onset2=hybrid_onset1; hybrid_onset1=hybrid_clock;
);
hybrid_end_event&&hybrid_event_start_abs>=0 ? (
  hybrid_duration=hybrid_clock-hybrid_event_start_abs;
  hybrid_duration_ms=hybrid_duration*1000/srate_safe;
  hybrid_low_gate=hybrid_smooth01((hybrid_duration_ms-0.45)/0.15);
  hybrid_high_gate=1-hybrid_smooth01((hybrid_duration_ms-1.50)/0.50);
  hybrid_tonal_gate=hybrid_event_corr>=c13?0:1;
  hybrid_event_accept=hybrid_low_gate*hybrid_high_gate*hybrid_tonal_gate;
  hybrid_duration>hybrid_classifier_spl ? hybrid_event_accept=0;
  j=0; hybrid_fill=hybrid_event_start_ring;
  loop(min(hybrid_duration,hybrid_buf_len-1),
    hybrid_eventgate[hybrid_fill]=hybrid_event_accept;
    hybrid_fill+=1; hybrid_fill>=hybrid_buf_len?hybrid_fill=0; j+=1;
  );
  hybrid_event_start_abs=-1;
);
hybrid_candidate_prev=hybrid_active;
hybrid_class_read=hybrid_write-hybrid_classifier_spl; hybrid_class_read<0?hybrid_class_read+=hybrid_buf_len;
hybrid_accept=min(hybrid_burden[hybrid_class_read],hybrid_eventgate[hybrid_class_read]);
hybrid_accept=min(hybrid_accept,hybrid_sat_ceiling);
hybrid_class_raw_l=hybrid_raw_l[hybrid_class_read]; hybrid_class_raw_r=hybrid_raw_r[hybrid_class_read];
hybrid_class_cand_l=hybrid_candidate_l[hybrid_class_read]; hybrid_class_cand_r=hybrid_candidate_r[hybrid_class_read];
hybrid_class_shaved_l=hybrid_class_raw_l+(hybrid_class_cand_l-hybrid_class_raw_l)*hybrid_accept;
hybrid_class_shaved_r=hybrid_class_raw_r+(hybrid_class_cand_r-hybrid_class_raw_r)*hybrid_accept;
hybrid_shaved_l[hybrid_class_read]=hybrid_class_shaved_l; hybrid_shaved_r[hybrid_class_read]=hybrid_class_shaved_r;
hybrid_class_lim=hybrid_worklim[hybrid_class_read];
hybrid_det=max(abs(hybrid_class_shaved_l),abs(hybrid_class_shaved_r));
hybrid_required[hybrid_class_read]=hybrid_det>hybrid_class_lim?hybrid_class_lim/max(hybrid_det,0.000000000001):1;
hybrid_required_active[hybrid_class_read]=hybrid_required[hybrid_class_read]<1?1:0;
!hybrid_limiter_window_tracked ? (
  hybrid_limiter_active_count=0;
  hd=0; loop(hybrid_limiter_spl+1,
    hi=hybrid_out_read+hd; hi>=hybrid_buf_len?hi-=hybrid_buf_len;
    hybrid_limiter_active_count+=hybrid_required_active[hi]?1:0;
    hd+=1;
  );
  hybrid_limiter_window_tracked=1;
) : (
  hi=hybrid_out_read-1; hi<0?hi+=hybrid_buf_len;
  hybrid_required_active[hi]?hybrid_limiter_active_count-=1;
  hybrid_required_active[hybrid_class_read]?hybrid_limiter_active_count+=1;
);
hybrid_target=1;
hybrid_limiter_spl>0 && hybrid_limiter_active_count>0 ? (
  hd=0; loop(hybrid_limiter_spl+1,
    hi=hybrid_out_read+hd; hi>=hybrid_buf_len?hi-=hybrid_buf_len;
    hreq=hybrid_required[hi]; hu=hd/hybrid_limiter_spl; hs=hu*hu*(3-2*hu);
    hgain=hreq+(1-hreq)*hs; hybrid_target=min(hybrid_target,hgain); hd+=1;
  );
) : hybrid_limiter_spl<=0 ? hybrid_target=hybrid_required[hybrid_out_read];
hybrid_target<hybrid_gain ? hybrid_gain=hybrid_target : hybrid_gain=hybrid_target+hybrid_limiter_release*(hybrid_gain-hybrid_target);
hybrid_gain>0.999999999?hybrid_gain=1;
hybrid_out_l=hybrid_shaved_l[hybrid_out_read]*hybrid_gain*hybrid_makeup[hybrid_out_read];
hybrid_out_r=hybrid_shaved_r[hybrid_out_read]*hybrid_gain*hybrid_makeup[hybrid_out_read];
hybrid_delayed_legacy_l=hybrid_raw_l[hybrid_out_read];
hybrid_delayed_legacy_r=hybrid_raw_r[hybrid_out_read];
hybrid_mix_now=stream_hybrid_mix;
hybrid_mix_now <= 0.0000001 ? (
  final_section_proc_l=hybrid_delayed_legacy_l;
  final_section_proc_r=hybrid_delayed_legacy_r;
) : hybrid_mix_now >= 0.9999999 ? (
  final_section_proc_l=hard_limit(hybrid_out_l,ceiling);
  final_section_proc_r=hard_limit(hybrid_out_r,ceiling);
) : (
  final_section_proc_l=hard_limit(hybrid_delayed_legacy_l+(hybrid_out_l-hybrid_delayed_legacy_l)*hybrid_mix_now,ceiling);
  final_section_proc_r=hard_limit(hybrid_delayed_legacy_r+(hybrid_out_r-hybrid_delayed_legacy_r)*hybrid_mix_now,ceiling);
);
hybrid_write+=1; hybrid_write>=hybrid_buf_len?hybrid_write=0;
hybrid_clock+=1;
  );
) : (
  final_section_proc_l=legacy_final_l;
  final_section_proc_r=legacy_final_r;
);

delivery_w=delivery_wrpos;
delivery_buf_l[delivery_w]=final_section_proc_l;
delivery_buf_r[delivery_w]=final_section_proc_r;
delivery_required[delivery_w]=1;
delivery_t=delivery_detector_taps-1;
loop(delivery_detector_taps-1,
  delivery_hist_l[delivery_t]=delivery_hist_l[delivery_t-1];
  delivery_hist_r[delivery_t]=delivery_hist_r[delivery_t-1];
  delivery_t-=1;
);
delivery_hist_l[0]=final_section_proc_l;
delivery_hist_r[0]=final_section_proc_r;

delivery_sust_l+=delivery_sust_coeff*(final_section_proc_l-delivery_sust_l);
delivery_sust_r+=delivery_sust_coeff*(final_section_proc_r-delivery_sust_r);
delivery_sust_peak=max(delivery_sust_peak,absmax2(delivery_sust_l,delivery_sust_r));
delivery_sust_counter-=1;
delivery_sust_counter<=0 ? (
  delivery_sust_req=delivery_sust_peak>delivery_target ? delivery_target/max(delivery_sust_peak,0.000000000001) : 1;
  delivery_sust_hist[delivery_sust_wrpos]=delivery_sust_req;
  delivery_sust_wrpos=(delivery_sust_wrpos+1)%delivery_sust_hist_len;
  delivery_sust_target=1;
  delivery_i=0;
  loop(delivery_sust_hist_len,
    delivery_sust_target=min(delivery_sust_target,delivery_sust_hist[delivery_i]);
    delivery_i+=1;
  );
  delivery_sust_peak=0;
  delivery_sust_counter=delivery_sust_chunk_spl;
);
delivery_sust_smoothed+=delivery_sust_smooth_coeff*(delivery_sust_target-delivery_sust_smoothed);

delivery_peak=absmax2(final_section_proc_l,final_section_proc_r);
delivery_p=0;
loop(delivery_detector_phases,
  delivery_sum_l=0; delivery_sum_r=0;
  delivery_t=0;
  loop(delivery_detector_taps,
    delivery_c=delivery_coeff[delivery_t*delivery_detector_phases+delivery_p];
    delivery_sum_l+=delivery_hist_l[delivery_t]*delivery_c;
    delivery_sum_r+=delivery_hist_r[delivery_t]*delivery_c;
    delivery_t+=1;
  );
  delivery_peak=max(delivery_peak,absmax2(delivery_sum_l,delivery_sum_r));
  delivery_p+=1;
);
delivery_req=delivery_peak>delivery_target ? delivery_target/max(delivery_peak,0.000000000001) : 1;
delivery_det_idx=delivery_w-delivery_detector_delay_spl;
delivery_det_idx<0 ? delivery_det_idx+=delivery_buf_len;
delivery_required[delivery_det_idx]=min(delivery_required[delivery_det_idx],delivery_req);

delivery_read=delivery_w-delivery_lookahead_spl;
delivery_read<0 ? delivery_read+=delivery_buf_len;
delivery_target_gain=1;
delivery_ahead=0;
loop(delivery_anticipation_spl+1,
  delivery_idx=delivery_read+delivery_ahead;
  delivery_idx>=delivery_buf_len ? delivery_idx-=delivery_buf_len;
  delivery_req_now=delivery_required[delivery_idx];
  delivery_shape_now=delivery_shape[delivery_ahead];
  delivery_candidate_gain=delivery_req_now+(1-delivery_req_now)*delivery_shape_now;
  delivery_target_gain=min(delivery_target_gain,delivery_candidate_gain);
  delivery_ahead+=1;
);
delivery_target_gain=min(delivery_target_gain,delivery_sust_smoothed);
delivery_target_gain<delivery_gain ? delivery_gain=delivery_target_gain : delivery_gain=delivery_target_gain+delivery_release*(delivery_gain-delivery_target_gain);
delivery_gain>0.999999999 ? delivery_gain=1;
final_section_proc_l=delivery_buf_l[delivery_read]*delivery_gain;
final_section_proc_r=delivery_buf_r[delivery_read]*delivery_gain;

final_load_counter += 1;
final_load_counter >= 64 ? (
  final_load_counter = 0;
  final_hybrid_gain = 1 - stream_hybrid_mix * (1 - hybrid_gain);
  final_load_gain = clamp(final_threshold_guard_gain * dynamic_clip_gain * pre_tgain * final_hybrid_gain * delivery_gain, 0.000001, 1);

  agc_lift_target_db = gate_state < 0.50 && startup_activity >= gate_lin
                     ? stream_agc_lift_target_db
                     : agc_lift_state_db;
  agc_lift_coeff = agc_lift_target_db > agc_lift_state_db ? agc_lift_attack_tick : agc_lift_release_tick;
  agc_lift_state_db = agc_lift_target_db + agc_lift_coeff * (agc_lift_state_db - agc_lift_target_db);
  final_load_db = max(0, -lin2db(final_load_gain));
  final_backoff_target_db = clamp((final_load_db - 0.60) * 0.80, 0, 2) * final_backoff_mix;
  final_backoff_coeff = final_backoff_target_db > final_backoff_db ? final_backoff_attack_tick : final_backoff_release_tick;
  final_backoff_db = final_backoff_target_db + final_backoff_coeff * (final_backoff_db - final_backoff_target_db);
  final_foundation_burden = clamp(final_backoff_db / 0.60, 0, 1);

  final_threshold_drive_target = db2lin(-p069);
  agc_target_base_db = c08;
  agc_target = db2lin(agc_target_base_db + agc_lift_state_db - 0.35 * final_backoff_db);
);
delivery_required[delivery_read]=1;
delivery_wrpos+=1; delivery_wrpos>=delivery_buf_len ? delivery_wrpos=0;

meter_final_safety_post = absmax2(final_section_proc_l, final_section_proc_r);
meter_blk_safety_pre = max(meter_blk_safety_pre, meter_final_safety_pre);
meter_blk_safety_post = max(meter_blk_safety_post, meter_final_safety_post);
meter_heavy_tick ? (
  meter_final_safety_now_db = max(0, meter_to_db(meter_blk_safety_pre) - meter_to_db(meter_blk_safety_post));
  meter_note_activity(7, meter_final_safety_now_db);
  meter_blk_safety_pre = meter_blk_safety_post = 0;
);

final_ref_l = final_delta_ref_pre_l;
final_ref_r = final_delta_ref_pre_r;
effective_final_lookahead > 0 ? (
  dfrdpos = diag_final_wrpos - effective_final_lookahead;
  dfrdpos < 0 ? dfrdpos += diag_final_buf_len;
  final_ref_l = diag_final_l[dfrdpos];
  final_ref_r = diag_final_r[dfrdpos];
  diag_final_l[diag_final_wrpos] = final_delta_ref_pre_l;
  diag_final_r[diag_final_wrpos] = final_delta_ref_pre_r;
  diag_final_wrpos += 1;
  diag_final_wrpos >= diag_final_buf_len ? diag_final_wrpos = 0;
);

final_section_mode === 1 ? (
  diag_l = final_section_proc_l;
  diag_r = final_section_proc_r;
  diag_active = 1;
) : final_section_mode === 2 ? (
  diag_l = final_section_proc_l - final_ref_l;
  diag_r = final_section_proc_r - final_ref_r;
  diag_active = 1;
);

final_section_mode === 3 ? (
  normal_out_l = final_section_in_l;
  normal_out_r = final_section_in_r;
) : (
  normal_out_l = final_section_proc_l;
  normal_out_r = final_section_proc_r;

  normal_out_l = hard_limit(normal_out_l, ceiling);
  normal_out_r = hard_limit(normal_out_r, ceiling);
);

meter_out_peak_l = max(meter_out_peak_l, abs(normal_out_l));
meter_out_peak_r = max(meter_out_peak_r, abs(normal_out_r));
meter_out_mid = (normal_out_l + normal_out_r) * 0.5;
meter_out_side = (normal_out_l - normal_out_r) * 0.5;
meter_out_mid_peak = max(meter_out_mid_peak, abs(meter_out_mid));
meter_out_side_peak = max(meter_out_side_peak, abs(meter_out_side));

meter_refresh_count += 1;
meter_refresh_count >= 8192 ? (
  refresh_meter_readout();
  meter_refresh_count = 0;
);

diag_active ? (
  mode_comp_in_l = diag_l;
  mode_comp_in_r = diag_r;
) : (
  mode_comp_in_l = normal_out_l;
  mode_comp_in_r = normal_out_r;
);

!diag_active && final_section_mode!==3 ? (mode_comp_in_l=hard_limit(mode_comp_in_l,cp_delivery_ceiling);mode_comp_in_r=hard_limit(mode_comp_in_r,cp_delivery_ceiling););
mode_comp_buf_lpos=mode_comp_wrpos;
mode_comp_l[mode_comp_buf_lpos]=mode_comp_in_l;mode_comp_r[mode_comp_buf_lpos]=mode_comp_in_r;
mode_comp_read=(mode_comp_buf_lpos+mode_comp_buf_len-mode_comp_delay_spl)%mode_comp_buf_len;
spl0=mode_comp_l[mode_comp_read];spl1=mode_comp_r[mode_comp_read];
cp_comp_fade>0 ? (
 cp_comp_x=1-cp_comp_fade/128;cp_comp_read=(mode_comp_buf_lpos+mode_comp_buf_len-cp_comp_old)%mode_comp_buf_len;
 spl0=mode_comp_l[cp_comp_read]+(spl0-mode_comp_l[cp_comp_read])*cp_comp_x;
 spl1=mode_comp_r[cp_comp_read]+(spl1-mode_comp_r[cp_comp_read])*cp_comp_x;
 cp_comp_fade-=1;
);
mode_comp_wrpos=(mode_comp_wrpos+1)%mode_comp_buf_len;

gui_peak_in_l_sample = max(gui_peak_in_l_sample, abs(agc_section_in_l));
gui_peak_in_r_sample = max(gui_peak_in_r_sample, abs(agc_section_in_r));
gui_peak_out_l_sample = max(gui_peak_out_l_sample, abs(spl0));
gui_peak_out_r_sample = max(gui_peak_out_r_sample, abs(spl1));

@serialize
cp_state_reading=file_avail(0)>=0;
cp_state_version=1;
file_var(0,cp_state_version);
cp_state_reading ? (core_last_mode=-1;core_state_reset=1;);

@gfx 620 262

gfx_setfont(1, "Arial", 11);
gfx_setfont(2, "Arial", 11, 'b');
gfx_setfont(3, "Arial", 9);
gfx_setfont(4, "Arial", 18, 'b');
gfx_setfont(5, "Arial", 10);
gfx_setfont(6, "Arial", 24, 'b');

function gui_color(r g b a)
(
  gfx_r = r; gfx_g = g; gfx_b = b; gfx_a = a;
);

function gui_fill(x y w h r g b a)
(
  gui_color(r,g,b,a);
  gfx_rect(x,y,w,h,1);
);

function gui_frame(x y w h r g b a)
(
  gui_color(r,g,b,a);
  gfx_rect(x,y,w,h,0);
);

function gui_hit(x y w h)
(
  mouse_x >= x && mouse_x <= x+w && mouse_y >= y && mouse_y <= y+h;
);

function core_mode_name(dest)
(
  core_mode == 0 ? strcpy(dest, "Podcast Leveler") :
  core_mode == 1 ? strcpy(dest, "Stream polish") :
                   strcpy(dest, "Smooth Limiter");
);

function gui_draw_mode(x y w h) local(hover mouse_down choice accent_r accent_g accent_b)
(
  hover = gui_hit(x,y,w,h);
  mouse_down = mouse_cap & 1;

  core_mode == 0 ? ( accent_r = 0.82; accent_g = 0.65; accent_b = 0.32; ) :
  core_mode == 1 ? ( accent_r = 0.40; accent_g = 0.62; accent_b = 0.88; ) :
                   ( accent_r = 0.58; accent_g = 0.62; accent_b = 0.68; );

  gui_fill(x,y,w,h, 0.105,0.125,0.155,1);
  hover ? (
    gui_frame(x,y,w,h, accent_r, accent_g, accent_b, 1);
  ) : (
    gui_frame(x,y,w,h, accent_r * 0.55, accent_g * 0.55, accent_b * 0.55, 1);
  );

  core_mode_name(#core_mode_text);
  gui_color(0.88,0.91,0.96,1);
  gfx_setfont(2);
  gfx_measurestr(#core_mode_text, mode_w, mode_h);
  gfx_x = x + 14;
  gfx_y = y + (h - mode_h) * 0.5;
  gfx_drawstr(#core_mode_text);

  gui_color(accent_r * 0.85, accent_g * 0.85, accent_b * 0.85, 1);
  gfx_x = x + w - 20;
  gfx_y = y + h * 0.5 - 3;
  gfx_line(gfx_x, gfx_y, gfx_x + 5, gfx_y + 5, 1);
  gfx_line(gfx_x + 5, gfx_y + 5, gfx_x + 10, gfx_y, 1);

  hover && mouse_down && !gui_last_mouse_down ? (
    gfx_x = x;
    gfx_y = y + h;
    choice = gfx_showmenu("Podcast Leveler|Stream polish|Smooth Limiter");
    choice > 0 ? (
      core_mode = choice - 1;
      sliderchange(1);
    );
  );
);

function gui_draw_slider(x y w slider_idx label min_val max_val default_val unit) local(track_y hover mouse_down val pct new_val fill_w handle_x value_w value_h)
(
  track_y = y + 28;
  hover = gui_hit(x, y, w, 48);
  mouse_down = mouse_cap & 1;

  hover && mouse_down && !gui_last_mouse_down && gui_active_slider == -1 ? gui_active_slider = slider_idx;
  !mouse_down && gui_active_slider == slider_idx ? gui_active_slider = -1;

  gui_active_slider == slider_idx ? (
    pct = clamp((mouse_x - x) / max(w,1), 0, 1);
    new_val = min_val + (max_val - min_val) * pct;
    slider_idx == 2 ? new_val = floor(new_val * 10 + 0.5) / 10 : new_val = floor(new_val + 0.5);
    slider(slider_idx) = new_val;
    sliderchange(slider_idx);
  );

  val = slider(slider_idx);
  pct = clamp((val - min_val) / max(max_val - min_val, 0.000001), 0, 1);
  fill_w = w * pct;
  handle_x = x + fill_w;

  gui_color(0.78,0.82,0.90,1);
  gfx_setfont(1);
  gfx_x = x;
  gfx_y = y;
  gfx_drawstr(label);

  slider_idx == 2 ? sprintf(#core_value, "%.1f dB", val) : sprintf(#core_value, "%.0f percent", val);
  gfx_setfont(2);
  gfx_measurestr(#core_value, value_w, value_h);
  gfx_x = x + w - value_w;
  gfx_y = y;
  gfx_drawstr(#core_value);

  gui_fill(x, track_y, w, 7, 0.12,0.14,0.18,1);
  gui_fill(x, track_y, fill_w, 7, 0.45,0.58,0.82,1);
  gui_frame(x, track_y, w, 7, 0.24,0.28,0.36,1);

  gui_color(hover || gui_active_slider == slider_idx ? 0.94 : 0.74, hover || gui_active_slider == slider_idx ? 0.96 : 0.79, hover || gui_active_slider == slider_idx ? 1.00 : 0.90, 1);
  gfx_circle(handle_x, track_y + 3.5, 7, 1, 1);

  slider_idx == 3 ? (
    gui_color(0.48,0.54,0.66,1);
    gfx_setfont(3);
    gfx_x = x;
    gfx_y = track_y + 14;
    gfx_drawstr("0 percent = neutral");
  );
);

function gui_draw_meter(x y w h level_l level_r label peak_hold_ptr) local(level peak_db pct fill_l fill_r bar_w db_w db_h tick_y tick_db i hold_pct hold_y)
(
  gui_fill(x,y,w,h, 0.08,0.10,0.13,1);
  gui_frame(x,y,w,h, 0.22,0.26,0.34,1);

  bar_w = (w - 9) * 0.5;
  peak_db = lin2db(max(level_l, level_r));
  pct = clamp((peak_db + 60) / 60, 0, 1);
  fill_l = h * clamp((lin2db(level_l) + 60) / 60, 0, 1);
  fill_r = h * clamp((lin2db(level_r) + 60) / 60, 0, 1);

  gui_fill(x+3, y+h-fill_l-2, bar_w, fill_l, 0.42,0.58,0.82,1);
  gui_fill(x+6+bar_w, y+h-fill_r-2, bar_w, fill_r, 0.42,0.58,0.82,1);

  i = 0;
  loop(5,
    tick_db = i == 0 ? -48 : i == 1 ? -24 : i == 2 ? -12 : i == 3 ? -6 : 0;
    tick_y = y + h - h * clamp((tick_db + 60) / 60, 0, 1) - 2;
    gui_color(0.32, 0.36, 0.44, 0.7);
    gfx_line(x + 2, tick_y, x + w - 3, tick_y, 0);
    i += 1;
  );

  peak_hold_ptr[] = max(peak_db, peak_hold_ptr[] - 0.35);
  hold_pct = clamp((peak_hold_ptr[] + 60) / 60, 0, 1);
  hold_pct > 0.001 ? (
    hold_y = y + h - h * hold_pct - 2;
    gui_color(0.92, 0.78, 0.38, 0.9);
    gfx_line(x + 2, hold_y, x + w - 3, hold_y, 0);
  );

  gui_color(0.70,0.75,0.84,1);
  gfx_setfont(5);
  gfx_measurestr(label, db_w, db_h);
  gfx_x = x + (w - db_w) * 0.5;
  gfx_y = y + h + 5;
  gfx_drawstr(label);

  sprintf(#core_db, "%.1f", peak_db);
  gfx_setfont(3);
  gfx_measurestr(#core_db, db_w, db_h);
  gfx_x = x + (w - db_w) * 0.5;
  gfx_y = y + h - db_h - 5;
  gfx_drawstr(#core_db);
);

mouse_down = mouse_cap & 1;
canvas_w = 620;
canvas_h = 262;
gui_dx = max(0, floor((gfx_w - canvas_w) * 0.5));
gui_dy = max(0, floor((gfx_h - canvas_h) * 0.5));

gui_peak_in_l = max(gui_peak_in_l * 0.82, gui_peak_in_l_sample);
gui_peak_in_r = max(gui_peak_in_r * 0.82, gui_peak_in_r_sample);
gui_peak_out_l = max(gui_peak_out_l * 0.82, gui_peak_out_l_sample);
gui_peak_out_r = max(gui_peak_out_r * 0.82, gui_peak_out_r_sample);
gui_peak_in_l_sample = 0;
gui_peak_in_r_sample = 0;
gui_peak_out_l_sample = 0;
gui_peak_out_r_sample = 0;

gui_fill(0,0,gfx_w,gfx_h, 0.055,0.065,0.085,1);

gx = gui_dx;
gy = gui_dy;

gui_fill(gx,gy,canvas_w,50, 0.08,0.10,0.14,1);
gui_frame(gx,gy,canvas_w,50, 0.18,0.22,0.30,1);
gui_color(0.92,0.95,1,1);
gfx_setfont(4);
gfx_x = gx + 18;
gfx_y = gy + 11;
gfx_drawstr("OPTILAB CORE");
gui_color(0.58,0.64,0.75,1);
gfx_setfont(5);
gfx_x = gx + 20;
gfx_y = gy + 33;
gfx_drawstr("broadcast-style leveling, polish, and peak control");

gui_fill(gx + 18, gy + 68, 355, 178, 0.075,0.09,0.12,1);
gui_frame(gx + 18, gy + 68, 355, 178, 0.18,0.22,0.30,1);
gui_color(0.76,0.82,0.92,1);
gfx_setfont(2);
gfx_x = gx + 34;
gfx_y = gy + 82;
gfx_drawstr("CONTROLS");

gui_color(0.58,0.64,0.74,1);
gfx_setfont(5);
gfx_x = gx + 34;
gfx_y = gy + 104;
gfx_drawstr("Mode, input, and adaptation stay available as normal REAPER sliders.");

gui_draw_mode(gx + 34, gy + 128, 210, 34);
gui_draw_slider(gx + 34, gy + 177, 305, 2, "Input Drive", -18, 18, 0, "dB");
gui_draw_slider(gx + 34, gy + 225, 305, 3, "Auto-Adapt", 0, 100, 0, "percent");

gui_fill(gx + 392, gy + 68, 210, 178, 0.075,0.09,0.12,1);
gui_frame(gx + 392, gy + 68, 210, 178, 0.18,0.22,0.30,1);
gui_color(0.76,0.82,0.92,1);
gfx_setfont(2);
gfx_x = gx + 408;
gfx_y = gy + 82;
gfx_drawstr("PEAK VIEW");

gui_draw_meter(gx + 420, gy + 112, 48, 92, gui_peak_in_l, gui_peak_in_r, "Input", gui_peak_hold_in);
gui_draw_meter(gx + 506, gy + 112, 48, 92, gui_peak_out_l, gui_peak_out_r, "Output", gui_peak_hold_out);

gui_color(0.52,0.58,0.68,1);
gfx_setfont(3);
gfx_x = gx + 416;
gfx_y = gy + 222;
gfx_drawstr("Ceiling target: -0.1 dBFS");

gui_last_mouse_down = mouse_down;

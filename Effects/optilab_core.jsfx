stereo_section_in_r = r;

stereo_section_active ? (
 mid=(l+r)*0.5;side=(l-r)*0.5;width_scale=p054*0.01;width_extra_request=max(0,width_scale-1);
 se_side=se_process(mid,side,width_extra_request);
 p054<100 ? (l=mid+side*width_scale;r=mid-side*width_scale;)
 : width_extra_request>0 ? (l=mid+se_side;r=mid-se_side;);
);


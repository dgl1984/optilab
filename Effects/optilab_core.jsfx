  inv_const_db2lin_minus6 = 1.0 / max(const_db2lin_minus6, 0.000001);
  at_edge_dull_inv_denom = 1.0 / max(adapt_top_edge_target_low - 0.060, 0.000001);
  at_edge_bright_inv_denom = 1.0 / max(0.78 - adapt_top_edge_target_high, 0.000001);
  at_air_dull_inv_denom = 1.0 / max(adapt_top_air_target_low - 0.006, 0.000001);
  at_air_bright_inv_denom = 1.0 / max(0.38 - adapt_top_air_target_high, 0.000001);
);

shape_servo_gain1 = shape_servo_gain2 = shape_servo_gain3 = 1;
shape_servo_gain4 = shape_servo_gain5 = shape_servo_gain6 = 1;
shape_servo1_db = shape_servo2_db = shape_servo3_db = 0;
shape_servo4_db = shape_servo5_db = shape_servo6_db = 0;
shape_power_accum1 = shape_power_accum2 = shape_power_accum3 = 0;
shape_power_accum4 = shape_power_accum5 = shape_power_accum6 = 0;
shape_block_counter = 0;
presence_edge_recovery_gain = 1;
presence_body_recovery_gain = 1;
brilliance_recovery_gain = 1;

shape_rec_block_size = 16;
shape_rec_count = 0;
shape_rec_heavy_tick = 1;
comp_rec1_gain = comp_rec2_gain = comp_rec3_gain = 1;
lim_rec1_gain = lim_rec2_gain = lim_rec3_gain = 1;
shape_rec_comp_ratio1_blk = shape_rec_comp_ratio2_blk = shape_rec_comp_ratio3_blk = 1;
shape_rec_lim_ratio1_blk = shape_rec_lim_ratio2_blk = shape_rec_lim_ratio3_blk = 1;

shape_rec_attack = 1 - exp(-1/(srate_safe * 0.320));
shape_rec_release = 1 - exp(-1/(srate_safe * 0.070));
shape_rec_attack_blk = 1 - pow(1 - shape_rec_attack, shape_rec_block_size);
shape_rec_release_blk = 1 - pow(1 - shape_rec_release, shape_rec_block_size);
shape_servo_lvl_a = 1 - exp(-1/(srate_safe * 2.400));
shape_servo_gain_a = 1 - exp(-1/(srate_safe * 0.900));

core_last_mode = -1;
core_initial_apply = 1;
gui_last_mouse_down = 0;

function core_stage(x a b) local(t)
(
  t = clamp((x-a)/max(b-a,0.000001),0,1);
  t*t*(3-2*t);
);

function hybrid_smooth01(x) local(t)
(
  t=clamp(x,0,1);
  t*t*(3-2*t);
);
function hybrid_shave(x lim depth) local(ax s ks span over y)
(
  ax=abs(x);
  ks=lim*db2lin(-max(depth,0.001));
  span=max(lim-ks,0.000000000001);
  ax<=ks ? x : (
    s=x<0?-1:1;
    over=ax-ks;
    y=ks+span*(1-exp(-over/span));
    s*min(y,lim);
  );
);
function hybrid_hist_idx(p) local(q)
(
  q=floor(p/hybrid_buf_len);
  p-q*hybrid_buf_len;
);
function hybrid_corr(now) local(best base lag si t off ai_abs bi_abs ai bi dot ea eb cnt c k aa0 aa1 bb0 bb1)
(
  best=-1;
  k=0;
  loop(3,
    k==0 ? base=hybrid_onset1>-100000000?now-hybrid_onset1:0;
    k==1 ? base=hybrid_onset2>-100000000?now-hybrid_onset2:0;
    k==2 ? base=hybrid_onset3>-100000000?now-hybrid_onset3:0;
    base>=hybrid_period_min && base<=hybrid_period_max ? (
      si=-3;
      loop(7,
        lag=floor(base*(1+0.04*si/3)+0.5);
        lag>=hybrid_period_min && lag<=hybrid_period_max ? (
          dot=0; ea=0; eb=0; cnt=0; t=0;
          loop(8,
            off=floor(t*max(1,lag-1)/7+0.5);
            ai_abs=now-off; bi_abs=ai_abs-lag;
            bi_abs>=0 ? (
              ai=hybrid_hist_idx(ai_abs); bi=hybrid_hist_idx(bi_abs);
              aa0=hybrid_raw_l[ai]; aa1=hybrid_raw_r[ai]; bb0=hybrid_raw_l[bi]; bb1=hybrid_raw_r[bi];
              dot+=aa0*bb0+aa1*bb1; ea+=aa0*aa0+aa1*aa1; eb+=bb0*bb0+bb1*bb1; cnt+=1;
            );
            t+=1;
          );
          cnt>=3 && ea>0.000000000001 && eb>0.000000000001 ? (c=dot/sqrt(ea*eb); c>best?best=c;);
        );
        si+=1;
      );
    );
    k+=1;
  );
  max(0,best);
);

hybrid_base=100000;
hybrid_buf_len=floor(srate_safe*0.064+0.5)+256;
hybrid_raw_l=hybrid_base;
hybrid_raw_r=hybrid_raw_l+hybrid_buf_len;

meter_final_in_mid_peak = max(meter_final_in_mid_peak, abs(final_in_mid));
meter_final_in_side_peak = max(meter_final_in_side_peak, abs(final_in_side));

final_threshold_drive_s <= 0 ? final_threshold_drive_s = final_threshold_drive_target;

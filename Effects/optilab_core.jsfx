preset_default_final_lookahead_ms = lookahead_ms;

crossover_model = 2;

fm_preemph_mode_last = fm_preemph_mode;
stereo_mode_last = stereo_mode;
stereo_width_pct_last = stereo_width_pct;
stereo_section_mode_last = stereo_section_mode;

fcs_buf_len = 512;
fcs_buf_l = 0;
fcs_buf_r = 512;
fcs_buf_ol = 1024;
fcs_buf_or = 1536;
fcs_wrpos = 0;

snub_buf_len = 512;
snub_wrpos = 0;
snub_p1_l = 2048;  snub_p1_r = 2560;
snub_p2_l = 3072;  snub_p2_r = 3584;
snub_p3_l = 4096;  snub_p3_r = 4608;
snub_p4_l = 5120;  snub_p4_r = 5632;
snub_p5_l = 6144;  snub_p5_r = 6656;
snub_p6_l = 7168;  snub_p6_r = 7680;

diag_xt2_buf_len = 512;
diag_xt2_l = 8192;
diag_xt2_r = 8704;
diag_xt2_wrpos = 0;

diag_final_buf_len = 512;
diag_final_l = 9216;
diag_final_r = 9728;
diag_final_wrpos = 0;

master_buf_len = 4096;
master_buf_l = 10240;
master_buf_r = 14336;
master_wrpos = 0;

master_startup_armed = 1;
master_startup_age = 0;

function db2lin(db)
(
  exp(db * 0.1151292546497022842);
);

function lin2db(x)
(
  log(max(x, 0.0000001)) * 8.685889638065036553;
);

function clamp(x lo hi)
(
  min(max(x, lo), hi);
);

function smoothstep01(x)
(
  x = clamp(x, 0, 1);
  x * x * (3 - 2 * x);
);

function adaptive_bass_boost_curve(x) local(t y)
(
  x = clamp(x, 0, 1);
  x <= 0.25 ? (
    t = x;
    y = -0.4571428571*t*t*t + 0.9142857143*t*t + 1.0000000000*t;
  ) : x <= 0.50 ? (
    t = x - 0.25;
    y = -0.5468624845*t*t*t + 1.0510013351*t*t + 1.3714285714*t + 0.3000000000;
  ) : x <= 0.65 ? (
    t = x - 0.50;
    y = -60.4153393502*t*t*t + 10.4330174081*t*t + 1.7943925234*t + 0.7000000000;
  ) : (
    t = x - 0.65;
    y = -0.9672424138*t*t*t - 0.7011439362*t*t + 0.8462623413*t + 1.0000000000;
  );
  y;
);

function adaptive_bass_cut_curve(x) local(t y)
(
  x = clamp(x, 0, 1);
  x <= 0.25 ? (
    t = x;
    y = -0.4571428571*t*t*t + 0.9142857143*t*t + 1.0000000000*t;
  ) : x <= 0.50 ? (
    t = x - 0.25;
    y = -0.5468624845*t*t*t + 1.0510013351*t*t + 1.3714285714*t + 0.3000000000;
  ) : x <= 0.65 ? (
    t = x - 0.50;
    y = -98.0269989616*t*t*t + 16.0747663551*t*t + 1.7943925234*t + 0.7000000000;
  ) : (
    y = 1;
  );
  clamp(y, 0, 1);
);

function absmax2(a b)
(
  max(abs(a), abs(b));
);

function onepole_lp(x a) instance(z)
(
  z += a * (x - z);
  z;
);

function onepole_lp2(x a) instance(z1 z2)
(
  z1 += a * (x - z1);
  z2 += a * (z1 - z2);
  z2;
);

function onepole_hp(x a) instance(z) local(y)
(
  z += a * (x - z);
  y = x - z;
  y;
);

function allpass1(x c) instance(x1 y1) local(y)
(
  y = -c*x + x1 + c*y1;
  x1 = x;
  y1 = y;
  y;
);

function peak_env(det att rel) instance(e)
(
  det > e ? e = det + att * (e - det) : e = det + rel * (e - det);
  e;
);

function peak_env_set(v) instance(e)
(
  e = v;
  e;
);

function band_limit_gain_pd(det thresh att rel_base rel_slow pd_amt) instance(env gain) local(tg depth rel_now)
(
  gain <= 0 ? gain = 1;

  depth = clamp((env - thresh) / max(thresh * 2.5, 0.000001), 0, 1);
  rel_now = rel_base * (1 - pd_amt * depth) + rel_slow * (pd_amt * depth);
  det > env ? env = det + att * (env - det) : env = det + rel_now * (env - det);

  env = max(env, 0.000001);
  tg = env > thresh ? thresh / env : 1;
  tg = clamp(tg, 0.10, 1);

  depth = clamp((1 - gain) / 0.75, 0, 1);
  rel_now = rel_base * (1 - pd_amt * depth) + rel_slow * (pd_amt * depth);
  tg < gain ? gain = tg + att * (gain - tg) : gain = tg + rel_now * (gain - tg);
  gain;
);

function linked_limiter_gain(det thresh att rel) instance(gain) local(tg)
(
  gain <= 0 ? gain = 1;
  tg = det > thresh ? thresh / max(det, 0.000001) : 1;
  tg = clamp(tg, 0.08, 1);
  tg < gain ? gain = tg + att * (gain - tg) : gain = tg + rel * (gain - tg);
  gain;
);

function band_event_gain_auto(det thresh_db quiet_thresh att rel_min rel_max) instance(env gain) local(inst_db rel_sec rel_now tg)
(
  gain <= 0 ? gain = 1;
  env == 0 && det < quiet_thresh ? (
    gain = 1;
  ) : (
    inst_db = lin2db(max(det, 0.000000000001)) - thresh_db;
    inst_db < 0 ? inst_db = 0;
    env == 0 && inst_db == 0 ? (
      gain = 1;
    ) : (
      inst_db > env ? (
        env = inst_db + att * (env - inst_db);
      ) : (
        rel_sec = min(0.060, max(0.004, env / 300.0));
        rel_now = env < 1.2 ? rel_min : env > 18 ? rel_max : exp(-1 / max(1, srate_safe * rel_sec));
        env = inst_db + rel_now * (env - inst_db);
      );
      env < 0.00001 ? env = 0;
      env > 18.5 ? gain = 0.12 : (
        tg = clamp(db2lin(-env), 0.12, 1);
        gain = tg;
      );
    );
  );
  gain;
);

function lim_softclip_to_lim(x lim soft) local(ax sg knee span y)
(
  soft <= 0 ? (
    ax = abs(x);
    ax > lim ? sign(x) * lim : x;
  ) : (
    ax = abs(x);
    sg = sign(x);
    knee = lim * (1 - 0.70 * soft);
    span = max(0.000000001, lim - knee);
    ax <= knee ? x : (
      y = knee + span * (1 - exp(-(ax - knee) / span));
      sg * y;
    );
  );
);

function lim_band_clip(x lim amount soft) local(c)
(
  c = lim_softclip_to_lim(x, lim, soft);
  x * (1 - amount) + c * amount;
);

function band_limit_gain_pd_soft(det thresh att rel_base rel_slow pd_amt ratio knee min_gain) instance(env gain) local(tg depth rel_now over soft)
(
  gain <= 0 ? gain = 1;

  depth = clamp((env - thresh) / max(thresh * 2.5, 0.000001), 0, 1);
  rel_now = rel_base * (1 - pd_amt * depth) + rel_slow * (pd_amt * depth);
  det > env ? env = det + att * (env - det) : env = det + rel_now * (env - det);

  env = max(env, 0.000001);
  over = env / max(thresh, 0.000001);
  over > 1 ? (
    soft = clamp((over - 1) / max((over - 1) + knee, 0.000001), 0, 1);
    tg = over^((1 / max(ratio, 1.01)) - 1);
    tg = 1 - soft * (1 - tg);
  ) : (
    tg = 1;
  );
  tg = clamp(tg, min_gain, 1);

  depth = clamp((1 - gain) / 0.75, 0, 1);
  rel_now = rel_base * (1 - pd_amt * depth) + rel_slow * (pd_amt * depth);
  tg < gain ? gain = tg + att * (gain - tg) : gain = tg + rel_now * (gain - tg);
  gain;
);

function soft_clip_knee(x th knee_mul) local(ax sgn over knee y)
(
  ax = abs(x);
  ax <= th ? (
    x;
  ) : (
    sgn = x < 0 ? -1 : 1;
    over = ax - th;
    knee = max(0.000001, th * knee_mul);
    y = th + knee * (1 - exp(-over / knee));
    sgn * y;
  );
);

function mb_soft_clip_dc(x th amt knee_mul cancel_amt a) instance(dc_z) local(c dist dist_low y)
(
  c = soft_clip_knee(x, th, knee_mul);
  dist = c - x;

  dc_z += a * (dist - dc_z);
  dist_low = dc_z;
  y = c - dist_low * cancel_amt;
  x * (1 - amt) + y * amt;
);

function bass_clip_active(x th amt knee_mul drive res_mix a) instance(z1 z2) local(xd c dist dist_filt clip_mix residue_mix)
(

  drive = max(drive, 1);
  xd = x * drive;
  c = soft_clip_knee(xd, th, knee_mul) / drive;
  dist = c - x;

  z1 += a * (dist - z1);
  z2 += a * (z1 - z2);
  dist_filt = z2;

  clip_mix = amt * (0.50 + 0.50 * amt);
  residue_mix = amt * res_mix * (0.35 + 0.65 * amt);
  x + dist * clip_mix + dist_filt * residue_mix;
);

function pure_peak_round(x th amt drive_mul) local(d lim y)
(

  amt <= 0 ? (
    x;
  ) : (
    th = max(th, 0.000001);
    d = drive_mul / th;
    lim = $pi * 0.5;
    y = sin(clamp(x * d, -lim, lim)) / d;
    x * (1 - amt) + y * amt;
  );
);

function smooth_drive_rounder(x amt) instance(prev_sat) local(sat apply y)
(

  amt = clamp(amt, 0, 1);
  amt <= 0.0000001 ? (
    x;
  ) : (
    sat = sin(clamp(x, -$pi * 0.5, $pi * 0.5));
    apply = clamp(abs(prev_sat + sat) * 0.5 * amt, 0, 1);
    y = x * (1 - apply) + sat * apply;
    prev_sat = sat;
    y;
  );
);

function adaptive_stereo_width_gain(mid_det side_det extra_request) instance(mid_fast mid_slow mid_env side_env gain) local(ratio transient side_gate level_gate narrowness character ratio_cap target_gain)
(
  mid_det > mid_fast ? (
    mid_fast = mid_det + width_mid_fast_attack * (mid_fast - mid_det);
  ) : (
    mid_fast = mid_det + width_mid_fast_release * (mid_fast - mid_det);
  );

  mid_det > mid_slow ? (
    mid_slow = mid_det + width_mid_slow_attack * (mid_slow - mid_det);
  ) : (
    mid_slow = mid_det + width_mid_slow_release * (mid_slow - mid_det);
  );

  mid_det > mid_env ? (
    mid_env = mid_det + width_level_attack * (mid_env - mid_det);
  ) : (
    mid_env = mid_det + width_level_release * (mid_env - mid_det);
  );

  side_det > side_env ? (
    side_env = side_det + width_level_attack * (side_env - side_det);
  ) : (
    side_env = side_det + width_level_release * (side_env - side_det);
  );

  ratio = side_env / max(mid_env, 0.000001);
  transient = clamp((mid_fast / max(mid_slow, 0.000001) - 1) * 1.5, 0, 1);
  side_gate = clamp((ratio - 0.012) * 20.8333333333333, 0, 1);
  level_gate = clamp((mid_env - 0.001) * 111.111111111111, 0, 1);
  narrowness = clamp((0.45 - ratio) * 2.85714285714286, 0, 1);
  character = clamp(0.35 + 0.40 * transient + 0.25 * narrowness, 0, 1);
  ratio_cap = ratio > 0.000001 ? clamp((0.92 / ratio - 1) / max(extra_request, 0.000001), 0, 1) : 1;
  target_gain = side_gate * level_gate * character * ratio_cap;

  target_gain < gain ? (
    gain = target_gain + width_gain_reduce * (gain - target_gain);
  ) : (
    gain = target_gain + width_gain_restore * (gain - target_gain);
  );

  gain = min(gain, ratio_cap);
  gain;
);

function hard_limit(x ceiling)
(
  min(max(x, -ceiling), ceiling);
);

function reset_phase_state()
(
  ap1_l.x1 = 0; ap1_l.y1 = 0; ap1_r.x1 = 0; ap1_r.y1 = 0;
  ap2_l.x1 = 0; ap2_l.y1 = 0; ap2_r.x1 = 0; ap2_r.y1 = 0;
  ap3_l.x1 = 0; ap3_l.y1 = 0; ap3_r.x1 = 0; ap3_r.y1 = 0;
  ap4_l.x1 = 0; ap4_l.y1 = 0; ap4_r.x1 = 0; ap4_r.y1 = 0;
  ap5_l.x1 = 0; ap5_l.y1 = 0; ap5_r.x1 = 0; ap5_r.y1 = 0;
  ap6_l.x1 = 0; ap6_l.y1 = 0; ap6_r.x1 = 0; ap6_r.y1 = 0;
  ap7_l.x1 = 0; ap7_l.y1 = 0; ap7_r.x1 = 0; ap7_r.y1 = 0;
  ap8_l.x1 = 0; ap8_l.y1 = 0; ap8_r.x1 = 0; ap8_r.y1 = 0;
  ap9_l.x1 = 0; ap9_l.y1 = 0; ap9_r.x1 = 0; ap9_r.y1 = 0;
  ap10_l.x1 = 0; ap10_l.y1 = 0; ap10_r.x1 = 0; ap10_r.y1 = 0;
  ap11_l.x1 = 0; ap11_l.y1 = 0; ap11_r.x1 = 0; ap11_r.y1 = 0;
  ap12_l.x1 = 0; ap12_l.y1 = 0; ap12_r.x1 = 0; ap12_r.y1 = 0;
);

function reset_dynamic_state() local(i)
(

  agc_lgain = 1;
  agc_hgain = 1;
  gate_prog_env = 0;
  gate_state = 0;
  gate_closed_memory = 0;
  gate_reopen_env = 0;
  gate_reopen_pulse = 0;
  agc_attack_assist_state = 0;
  agc_surge_catch_state = 0;
  agc_makeup_guard_state = 0;

  agc_low_env.e = 0;
  agc_high_env.e = 0;
  final_full_env.e = 0;
  final_threshold_drive_s = final_threshold_drive_target > 0 ? final_threshold_drive_target : 1;
  final_threshold_guard_gain = 1;
  preclip.gain = 1;
  final_round_l.prev_sat = 0;
  final_round_r.prev_sat = 0;

  pre_l.x1 = 0; pre_l.primed = 0;
  pre_r.x1 = 0; pre_r.primed = 0;
  deemph_l.x1 = 0; deemph_l.primed = 0;
  deemph_r.x1 = 0; deemph_r.primed = 0;
  adaptive_width.mid_fast = 0;
  adaptive_width.mid_slow = 0;
  adaptive_width.mid_env = 0;
  adaptive_width.side_env = 0;
  adaptive_width.gain = 0;

  post_agc_round_l.prev_sat = 0;
  post_agc_round_r.prev_sat = 0;
  post_xt2_round_l.prev_sat = 0;
  post_xt2_round_r.prev_sat = 0;
  hp30_l.z = 0; hp30_r.z = 0;
  agc_lp_l.z = 0; agc_lp_l.z1 = 0; agc_lp_l.z2 = 0;
  agc_lp_r.z = 0; agc_lp_r.z1 = 0; agc_lp_r.z2 = 0;
  xb1_l.z1=0; xb1_l.z2=0; xb2_l.z1=0; xb2_l.z2=0; xb3_l.z1=0; xb3_l.z2=0; xb4_l.z1=0; xb4_l.z2=0; xb5_l.z1=0; xb5_l.z2=0;
  xb1_r.z1=0; xb1_r.z2=0; xb2_r.z1=0; xb2_r.z2=0; xb3_r.z1=0; xb3_r.z2=0; xb4_r.z1=0; xb4_r.z2=0; xb5_r.z1=0; xb5_r.z2=0;
  adapt_top_air_hp_l.z=0; adapt_top_air_hp_r.z=0;
  adapt_top_edge_env.e=0; adapt_top_edge_prog_env.e=0; adapt_top_air_env.e=0; adapt_top_air_prog_env.e=0;
  adapt_top_presence_gain=1; adapt_top_air_gain=1;
  dist_lpf_l.z=0; dist_lpf_r.z=0; fcs_res_l.z=0; fcs_res_r.z=0;

  reset_phase_state();

  lim1.env = 0; lim1.gain = 1;
  lim2.env = 0; lim2.gain = 1;
  lim3.env = 0; lim3.gain = 1;
  lim4.env = 0; lim4.gain = 1;
  lim5.env = 0; lim5.gain = 1;
  lim6.env = 0; lim6.gain = 1;
  mb_ev1.env = 0; mb_ev1.gain = 1;
  mb_ev2.env = 0; mb_ev2.gain = 1;
  mb_ev3.env = 0; mb_ev3.gain = 1;
  mb_ev4.env = 0; mb_ev4.gain = 1;
  mb_ev5.env = 0; mb_ev5.gain = 1;
  mb_ev6.env = 0; mb_ev6.gain = 1;
  shape_comp_rec1_db = 0; shape_comp_rec2_db = 0; shape_comp_rec3_db = 0;
  shape_lim_rec1_db = 0; shape_lim_rec2_db = 0; shape_lim_rec3_db = 0;

  shape_rec_count = 0;
  shape_rec_heavy_tick = 1;
  comp_rec1_gain = comp_rec2_gain = comp_rec3_gain = 1;
  lim_rec1_gain = lim_rec2_gain = lim_rec3_gain = 1;
  shape_rec_comp_ratio1_blk = shape_rec_comp_ratio2_blk = shape_rec_comp_ratio3_blk = 1;
  shape_rec_lim_ratio1_blk = shape_rec_lim_ratio2_blk = shape_rec_lim_ratio3_blk = 1;
  shape_lvl1 = 0; shape_lvl2 = 0; shape_lvl3 = 0; shape_lvl4 = 0; shape_lvl5 = 0; shape_lvl6 = 0;
  shape_servo1_db = 0; shape_servo2_db = 0; shape_servo3_db = 0;
  shape_servo4_db = 0; shape_servo5_db = 0; shape_servo6_db = 0;

  shape_servo_gain1 = shape_servo_gain2 = shape_servo_gain3 = 1;
  shape_servo_gain4 = shape_servo_gain5 = shape_servo_gain6 = 1;
  shape_power_accum1 = shape_power_accum2 = shape_power_accum3 = 0;
  shape_power_accum4 = shape_power_accum5 = shape_power_accum6 = 0;
  shape_block_counter = 0;

  adaptive_cpu_count = 15;
  adaptive_cpu_tick = 1;
  at_presence_gain_target_cached = 1;
  at_air_gain_target_cached = 1;

  legacy_adapt_bass_lp_l.z1 = 0; legacy_adapt_bass_lp_l.z2 = 0;
  legacy_adapt_bass_lp_r.z1 = 0; legacy_adapt_bass_lp_r.z2 = 0;
  legacy_adapt_bass_env.e = 0; legacy_adapt_prog_env.e = 0;
  legacy_adapt_bass_gain = 1;
  adapt_bass_model_primed = 0;
  adapt_bass_model_age_samples = 0;
